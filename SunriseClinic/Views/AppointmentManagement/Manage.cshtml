@model SunriseClinic.Models.AppointmentManageViewModel
@{
    ViewData["Title"] = "Manage Appointment";
    var userType = Context.Session.GetString("UserType") ?? "User";
    var userName = Context.Session.GetString("UserName") ?? "User";
    var availableTimeSlots = ViewBag.AvailableTimeSlots as List<string> ?? new List<string>();
    var currentTimeSlot = Model.AppointmentTimeSpan.ToString(@"hh\:mm");
}

<div class="container-fluid py-3" id="manageAp">
    <div class="row">
        <!-- Main Content -->
        <div class="col-12">
            <!-- Header -->
            <div class="card border-0 shadow-sm mb-4 bg-primary text-white">
                <div class="card-body p-4">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h3 class="mb-2">
                                <i class="fas fa-calendar-check me-2"></i>Manage Appointment
                            </h3>
                            <p class="mb-0 opacity-75">
                                ID: AP@(Model.AppointmentId.ToString("D6"))
                            </p>
                        </div>
                        <div class="col-md-4 text-end">
                            <a href="@Url.Action("Index")" class="btn btn-outline-light">
                                <i class="fas fa-arrow-left me-1"></i>Back to List
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Display messages -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4">
                    <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-4">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="row">
                <!-- Left Column: Appointment Details Form -->
                <div class="col-md-6 mb-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white border-0 py-3">
                            <h5 class="mb-0">
                                <i class="fas fa-edit text-primary me-2"></i>Appointment Details
                            </h5>
                        </div>
                        <div class="card-body">
                            <form method="post" asp-action="UpdateDetails" id="updateForm">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="appointmentId" value="@Model.AppointmentId" />

                                <!-- Date and Time -->
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Appointment Date *</label>
                                    <input type="date" class="form-control" name="appointmentDate"
                                           value="@Model.AppointmentDate.ToString("yyyy-MM-dd")"
                                           min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                           max="@DateTime.Today.AddDays(30).ToString("yyyy-MM-dd")"
                                           required id="appointmentDate">
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Appointment Time *</label>
                                    <select class="form-select" name="appointmentTime" required id="appointmentTime">
                                        @{
                                            bool timeSelected = false;
                                        }

                                        @if (availableTimeSlots.Any())
                                        {
                                            // প্রথমে currentTimeSlot কে selected করা option
                                            @foreach (var timeSlot in availableTimeSlots)
                                            {
                                                if (timeSlot == currentTimeSlot && !timeSelected)
                                                {
                                                    <option value="@timeSlot" selected="selected">@timeSlot (Current)</option>
                                                    timeSelected = true;
                                                }
                                                else
                                                {
                                                    <option value="@timeSlot">@timeSlot</option>
                                                }
                                            }

                                            // যদি currentTimeSlot available না থাকে
                                            @if (!timeSelected && !string.IsNullOrEmpty(currentTimeSlot))
                                            {
                                                <option value="@currentTimeSlot" selected="selected">@currentTimeSlot</option>
                                                timeSelected = true;
                                            }
                                        }
                                        else
                                        {
                                            // শুধু current time show করবে
                                            <option value="@currentTimeSlot" selected="selected">@currentTimeSlot</option>
                                            timeSelected = true;
                                        }

                                        @if (!timeSelected)
                                        {
                                            <option value="" selected disabled>No time available</option>
                                        }
                                    </select>

                                </div>

                                <!-- Appointment Details -->
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Reason for Appointment *</label>
                                    <textarea class="form-control" name="reason" rows="3" required>@Model.Reason</textarea>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Symptoms (Optional)</label>
                                    <textarea class="form-control" name="symptoms" rows="2">@Model.Symptoms</textarea>
                                </div>

                                <!-- Emergency Checkbox -->
                                <div class="mb-4">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="isEmergency"
                                               id="isEmergency" @(Model.IsEmergency ? "checked" : "") value="true">
                                        <label class="form-check-label fw-semibold" for="isEmergency">
                                            <i class="fas fa-exclamation-triangle text-danger me-1"></i>
                                            Emergency Appointment
                                        </label>
                                    </div>
                                </div>

                                <!-- Update Button -->
                                <div class="d-grid">
                                    <button type="submit" class="btn btn-primary btn-lg">
                                        <i class="fas fa-save me-2"></i>Update Appointment Details
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Appointment Info and Actions -->
                <div class="col-md-6 mb-4">
                    <!-- Appointment Status Card -->
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-white border-0 py-3">
                            <h5 class="mb-0">
                                <i class="fas fa-info-circle text-primary me-2"></i>Appointment Information
                            </h5>
                        </div>
                        <div class="card-body">
                            <!-- Status Badge -->
                            <div class="mb-4 text-center">
                                <span class="badge @Model.StatusBadgeClass fs-5 px-4 py-2">
                                    @Model.Status
                                </span>
                                <div class="mt-2">
                                    @if (Model.IsEmergency)
                                    {
                                        <span class="badge bg-danger fs-6">
                                            <i class="fas fa-exclamation-triangle me-1"></i>EMERGENCY
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Appointment Info -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Appointment ID</label>
                                <div class="form-control bg-light">AP@(Model.AppointmentId.ToString("D6"))</div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Scheduled Date & Time</label>
                                <div class="form-control bg-light">
                                    @Model.AppointmentDate.ToString("dddd, dd MMMM yyyy") at @Model.AppointmentTimeSpan.ToString(@"hh\:mm") @(Model.AppointmentTimeSpan.Hours < 12 ? "AM" : "PM")
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Original Appointment Time (Patient Set)</label>
                                <div class="form-control bg-light">
                                    @Model.AppointmentTimeSpan.ToString(@"hh\:mm") @(Model.AppointmentTimeSpan.Hours < 12 ? "AM" : "PM")
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Created On</label>
                                <div class="form-control bg-light">@Model.CreatedAt.ToString("dd MMM yyyy hh:mm tt")</div>
                            </div>
                        </div>
                    </div>

                    <!-- Patient Information Card -->
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-white border-0 py-3">
                            <h5 class="mb-0">
                                <i class="fas fa-user-injured text-primary me-2"></i>Patient Information
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-2">
                                <strong>Name:</strong> @Model.PatientName
                            </div>
                            <div class="mb-2">
                                <strong>Phone:</strong> @Model.PatientPhone
                            </div>
                            <div class="mb-2">
                                <strong>Email:</strong> @Model.PatientEmail
                            </div>
                            @if (!string.IsNullOrEmpty(Model.PatientGender))
                            {
                                <div class="mb-2">
                                    <strong>Gender:</strong> @Model.PatientGender
                                </div>
                            }
                            @if (Model.PatientDOB.HasValue)
                            {
                                <div class="mb-2">
                                    <strong>Date of Birth:</strong> @Model.FormattedPatientDOB
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.BloodGroup))
                            {
                                <div class="mb-2">
                                    <strong>Blood Group:</strong> @Model.BloodGroup
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.EmergencyContact))
                            {
                                <div class="mb-2">
                                    <strong>Emergency Contact:</strong> @Model.EmergencyContact
                                </div>
                            }
                            @if (Model.Height > 0)
                            {
                                <div class="mb-2">
                                    <strong>Height:</strong> @Model.Height cm
                                </div>
                            }
                            @if (Model.Weight > 0)
                            {
                                <div class="mb-2">
                                    <strong>Weight:</strong> @Model.Weight kg
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Doctor Information Card -->
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white border-0 py-3">
                            <h5 class="mb-0">
                                <i class="fas fa-user-md text-primary me-2"></i>Doctor Information
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-2">
                                <strong>Name:</strong> Dr. @Model.DoctorName
                            </div>
                            <div class="mb-2">
                                <strong>Specialization:</strong> @Model.DoctorSpecialization
                            </div>
                            @if (!string.IsNullOrEmpty(Model.Qualification))
                            {
                                <div class="mb-2">
                                    <strong>Qualification:</strong> @Model.Qualification
                                </div>
                            }
                            <div class="mb-2">
                                <strong>Experience:</strong> @Model.ExperienceYears years
                            </div>
                            <div class="mb-2">
                                <strong>Consultation Fee:</strong> ৳@Model.ConsultationFee.ToString("0.00")
                            </div>
                            @if (!string.IsNullOrEmpty(Model.AvailableDays))
                            {
                                <div class="mb-2">
                                    <strong>Available Days:</strong> @Model.AvailableDays
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.AvailableTime))
                            {
                                <div class="mb-2">
                                    <strong>Available Time:</strong> @Model.AvailableTime
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons Section - পরিবর্তিত অংশ -->
            <div class="card border-0 shadow-sm mt-4">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0">
                        <i class="fas fa-tasks text-primary me-2"></i>Appointment Actions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <!-- Approve Button -->
                        @if (Model.Status != "Approved" && Model.Status != "Rejected" && Model.Status != "Cancelled" && Model.Status != "Completed")
                        {
                            <div class="col-md-3">
                                <button type="button" class="btn btn-success btn-lg w-100" data-bs-toggle="modal" data-bs-target="#approveModal">
                                    <i class="fas fa-check me-2"></i>Approve
                                </button>
                            </div>
                        }

                        <!-- Reject Button -->
                        @if (Model.Status != "Rejected" && Model.Status != "Cancelled" && Model.Status != "Completed")
                        {
                            <div class="col-md-3">
                                <button type="button" class="btn btn-danger btn-lg w-100" data-bs-toggle="modal" data-bs-target="#rejectModal">
                                    <i class="fas fa-times me-2"></i>Reject
                                </button>
                            </div>
                        }

                        <!-- Cancel Button -->
                        @if (Model.Status != "Cancelled" && Model.Status != "Completed")
                        {
                            <div class="col-md-3">
                                <button type="button" class="btn btn-warning btn-lg w-100" data-bs-toggle="modal" data-bs-target="#cancelModal">
                                    <i class="fas fa-ban me-2"></i>Cancel
                                </button>
                            </div>
                        }

                        <!-- Mark as Completed -->
                        @if (Model.Status == "Approved")
                        {
                            <div class="col-md-3">
                                <button type="button" class="btn btn-info btn-lg w-100" data-bs-toggle="modal" data-bs-target="#completeModal">
                                    <i class="fas fa-check-double me-2"></i>Complete
                                </button>
                            </div>
                        }

                        <!-- Back Button -->
                        <div class="col-md-3">
                            <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-lg w-100">
                                <i class="fas fa-arrow-left me-2"></i>Back
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Approve Appointment Modal -->
            <div class="modal fade" id="approveModal" tabindex="-1" aria-labelledby="approveModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header bg-success text-white">
                            <h5 class="modal-title" id="approveModalLabel">
                                <i class="fas fa-check-circle me-2"></i>Approve Appointment
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                        </div>
                        <form method="post" asp-action="UpdateStatus">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="appointmentId" value="@Model.AppointmentId" />
                            <input type="hidden" name="status" value="Approved" />
                            <div class="modal-body">
                                <p>Are you sure you want to approve this appointment?</p>
                                <div class="mb-3">
                                    <label for="approveNotes" class="form-label">Additional notes (optional):</label>
                                    <textarea class="form-control" id="approveNotes" name="reason" rows="3" placeholder="Add any additional notes or instructions..."></textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-success">Yes, Approve Appointment</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Complete Appointment Modal -->
            <div class="modal fade" id="completeModal" tabindex="-1" aria-labelledby="completeModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header bg-info text-white">
                            <h5 class="modal-title" id="completeModalLabel">
                                <i class="fas fa-check-double me-2"></i>Complete Appointment
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                        </div>
                        <form method="post" asp-action="UpdateStatus">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="appointmentId" value="@Model.AppointmentId" />
                            <input type="hidden" name="status" value="Completed" />
                            <div class="modal-body">
                                <p>Are you sure you want to mark this appointment as completed?</p>
                                <div class="mb-3">
                                    <label for="completeNotes" class="form-label">Completion notes (optional):</label>
                                    <textarea class="form-control" id="completeNotes" name="reason" rows="3" placeholder="Add completion notes or summary..."></textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-info">Yes, Mark as Completed</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

<!-- Reject Appointment Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="rejectModalLabel">
                    <i class="fas fa-times-circle me-2"></i>Reject Appointment
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="UpdateStatus">
                @Html.AntiForgeryToken()
                <input type="hidden" name="appointmentId" value="@Model.AppointmentId" />
                <input type="hidden" name="status" value="Rejected" />
                <div class="modal-body">
                    <p>Are you sure you want to reject this appointment?</p>
                    <div class="mb-3">
                        <label for="rejectReason" class="form-label">Reason for rejection (optional):</label>
                        <textarea class="form-control" id="rejectReason" name="reason" rows="3" placeholder="Please provide a reason for rejection..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Yes, Reject Appointment</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Cancel Appointment Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1" aria-labelledby="cancelModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="cancelModalLabel">
                    <i class="fas fa-ban me-2"></i>Cancel Appointment
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="UpdateStatus">
                @Html.AntiForgeryToken()
                <input type="hidden" name="appointmentId" value="@Model.AppointmentId" />
                <input type="hidden" name="status" value="Cancelled" />
                <div class="modal-body">
                    <p>Are you sure you want to cancel this appointment?</p>
                    <div class="mb-3">
                        <label for="cancelReason" class="form-label">Reason for cancellation (optional):</label>
                        <textarea class="form-control" id="cancelReason" name="reason" rows="3" placeholder="Please provide a reason for cancellation..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                    <button type="submit" class="btn btn-warning">Yes, Cancel Appointment</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            console.log('Manage appointment page loaded');

            // Load time slots when date changes
            $('#appointmentDate').change(function() {
                var selectedDate = $(this).val();
                var doctorId = @Model.DoctorId;

                if (selectedDate) {
                    $('#appointmentTime').html('<option value="">Loading time slots...</option>');

                    $.ajax({
                        url: '/AppointmentManagement/GetTimeSlots',
                        type: 'GET',
                        data: {
                            doctorId: doctorId,
                            date: selectedDate
                        },
                        success: function(response) {
                            if (response.success) {
                                var timeSelect = $('#appointmentTime');
                                timeSelect.empty();
                                timeSelect.append('<option value="">Select Time</option>');

                                if (response.timeSlots.length > 0) {
                                    response.timeSlots.forEach(function(timeSlot) {
                                        var isSelected = timeSlot === '@currentTimeSlot';
                                        timeSelect.append('<option value="' + timeSlot + '" ' + (isSelected ? 'selected' : '') + '>' + timeSlot + '</option>');
                                    });
                                    $('#timeSlotInfo').text(response.timeSlots.length + ' available time slots');
                                } else {
                                    timeSelect.append('<option value="@currentTimeSlot" selected>@currentTimeSlot</option>');
                                    $('#timeSlotInfo').text('No time slots available for selected date. Keeping original time.');
                                }
                            } else {
                                alert('Error: ' + response.message);
                            }
                        },
                        error: function() {
                            alert('Error loading time slots. Please try again.');
                        }
                    });
                }
            });

            // Form validation
            $('#updateForm').submit(function(e) {
                var date = $('#appointmentDate').val();
                var time = $('#appointmentTime').val();

                if (!date || !time) {
                    e.preventDefault();
                    alert('Please select both date and time.');
                    return false;
                }

                return true;
            });
        });

                // Scroll to main on page load
        document.addEventListener('DOMContentLoaded', function() {
            const scrolltomain = document.getElementById('manageAp');
            if (scrolltomain) {
                scrolltomain.classList.add('scroll-target');
                scrolltomain.scrollIntoView({ behavior: 'smooth' });
            }
        });
    </script>
}