@{
    ViewData["Title"] = "Manage Patients";
    var patients = ViewBag.Patients as List<dynamic>;
    var searchTerm = ViewBag.SearchTerm as string;
}

<div class="container-fluid py-4" id="managePatients">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">
                <i class="fas fa-users me-2 text-warning"></i>Manage Patients
            </h3>
            <p class="text-muted mb-0">View and manage all patient accounts</p>
        </div>
        <div class="d-flex gap-2">
            <form method="get" class="d-flex" style="min-width: 300px;">
                <input type="text" name="searchTerm" class="form-control me-2"
                       placeholder="Search patients..." value="@searchTerm">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-search"></i>
                </button>
            </form>
            <a href="@Url.Action("ManagePatients", "Admin")" class="btn btn-outline-secondary">
                <i class="fas fa-sync-alt"></i>
            </a>
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4">
            <i class="fas fa-check-circle me-2"></i>
            @Html.Raw(TempData["SuccessMessage"])
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4">
            <i class="fas fa-exclamation-circle me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistics -->
    <div class="row mb-4">
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card border-0 shadow-sm bg-primary text-white">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="fw-bold mb-1">@patients?.Count</h4>
                            <p class="mb-0 opacity-75">Total Patients</p>
                        </div>
                        <i class="fas fa-user-injured fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Patients Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (patients != null && patients.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Patient ID</th>
                                <th>Full Name</th>
                                <th>Contact</th>
                                <th>Blood Group</th>
                                <th>Joined Date</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var patient in patients)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="badge bg-warning text-dark">@patient.DisplayId</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="flex-shrink-0">
                                                <img src="@Url.Content("~/uploads/profile-pictures/default.jpg")"
                                                     class="rounded-circle" width="40" height="40" alt="Patient">
                                            </div>
                                            <div class="flex-grow-1 ms-3">
                                                <h6 class="mb-1">@patient.FullName</h6>
                                                <small class="text-muted">@patient.Email</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="mb-1">
                                            <i class="fas fa-phone me-2 text-muted"></i>
                                            @patient.PhoneNumber
                                        </div>
                                        @if (!string.IsNullOrEmpty(patient.EmergencyContact?.ToString()) && patient.EmergencyContact != "Not set")
                                        {
                                            <div class="text-muted small">
                                                <i class="fas fa-ambulance me-1"></i>
                                                @patient.EmergencyContact
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(patient.BloodGroup?.ToString()) && patient.BloodGroup != "Not set")
                                        {
                                            <span class="badge bg-danger">@patient.BloodGroup</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not set</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="mb-1">@patient.CreatedAt.ToString("dd-MMM-yyyy")</div>
                                        <small class="text-muted">@patient.CreatedAt.ToString("hh:mm tt")</small>
                                    </td>
                                    <td>
                                        @{
                                            var isActive = patient.IsActive != null && (bool)patient.IsActive;
                                        }
                                        <span class="badge @(isActive ? "bg-success" : "bg-danger")">
                                            @(isActive ? "ACTIVE" : "INACTIVE")
                                        </span>
                                    </td>
                                    <!-- ManagePatients.cshtml এর Action বাটনগুলো এভাবে আপডেট করুন -->
                                    <td class="text-end pe-4">
                                        <div class="btn-group" role="group">
                                            <a href="@Url.Action("ViewPatient", "Admin", new { id = patient.UserId })"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="@Url.Action("EditPatient", "Admin", new { id = patient.UserId })"
                                               class="btn btn-sm btn-outline-warning">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-outline-danger delete-btn"
                                                    data-id="@patient.UserId"
                                                    data-name="@patient.FullName"
                                                    data-displayid="@patient.DisplayId">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-user-injured fa-4x text-muted mb-3"></i>
                    <h5 class="text-muted">No patients found</h5>
                    @if (!string.IsNullOrEmpty(searchTerm))
                    {
                        <p class="text-muted">No results for "@searchTerm"</p>
                        <a href="@Url.Action("ManagePatients", "Admin")" class="btn btn-primary mt-2">
                            <i class="fas fa-times me-2"></i>Clear Search
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-danger">
                    <i class="fas fa-exclamation-triangle me-2"></i>Confirm Deletion
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong id="deleteName"></strong>?</p>
                <p class="text-muted">Patient ID: <span id="deleteDisplayId" class="badge bg-warning text-dark"></span></p>
                <p class="text-danger small mb-0">
                    <i class="fas fa-exclamation-circle me-1"></i>
                    This action cannot be undone. All patient data including appointments and medical records will be permanently deleted.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" asp-action="DeleteUser" id="deleteForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteId" value="0">
                    <button type="submit" class="btn btn-danger">Delete Patient</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Delete button handler
        document.addEventListener('DOMContentLoaded', function() {
            const deleteButtons = document.querySelectorAll('.delete-btn');
            const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
            const deleteForm = document.getElementById('deleteForm');
            const deleteName = document.getElementById('deleteName');
            const deleteDisplayId = document.getElementById('deleteDisplayId');
            const deleteId = document.getElementById('deleteId');

            deleteButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const patientId = this.getAttribute('data-id');
                    const patientName = this.getAttribute('data-name');
                    const displayId = this.getAttribute('data-displayid');

                    deleteName.textContent = patientName;
                    deleteDisplayId.textContent = displayId;
                    deleteId.value = patientId;

                    deleteModal.show();
                });
            });

            // Handle delete form submission
            deleteForm.addEventListener('submit', function(e) {
                e.preventDefault();

                const formData = new FormData(this);

                fetch(this.action, {
                    method: 'POST',
                    body: formData
                })
                .then(response => {
                    if (response.redirected) {
                        window.location.href = response.url;
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                });
            });

            // Scroll to content
            const scrolltomain = document.getElementById('managePatients');
            if (scrolltomain) {
                scrolltomain.classList.add('scroll-target');
                scrolltomain.scrollIntoView({ behavior: 'smooth' });
            }
        });

        // Search functionality
        const searchInput = document.querySelector('input[name="searchTerm"]');
        if (searchInput) {
            searchInput.addEventListener('keyup', function(e) {
                if (e.key === 'Enter') {
                    this.form.submit();
                }
            });
        }
    </script>
}