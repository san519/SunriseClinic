@{
    ViewData["Title"] = "Admin Dashboard";
    var stats = ViewBag.Stats as dynamic;
    var activities = ViewBag.Activities as List<dynamic>;
}

<div class="container-fluid py-4" id="adminDashboard">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">
                <i class="fas fa-tachometer-alt me-2 text-primary"></i>Admin Dashboard
            </h3>
            <p class="text-muted mb-0">Welcome back, Administrator</p>
        </div>
        <div class="text-end">
            <p class="mb-0 text-muted">
                <i class="fas fa-calendar me-1"></i>@DateTime.Now.ToString("dddd, dd MMMM yyyy")
            </p>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3 col-sm-6 mb-3">
            <a asp-action="ManagePatients" asp-controller="Admin" class="text-decoration-none">
                <div class="card border-0 shadow-sm bg-primary text-white hover-lift">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h2 class="display-6 fw-bold mb-2">@stats?.TotalPatients</h2>
                                <p class="mb-0 opacity-75">Total Patients</p>
                            </div>
                            <i class="fas fa-user-injured fa-3x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-3 col-sm-6 mb-3">
            <a asp-action="ManageDoctors" asp-controller="Admin" class="text-decoration-none">
                <div class="card border-0 shadow-sm bg-info text-white hover-lift">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h2 class="display-6 fw-bold mb-2">@stats?.TotalDoctors</h2>
                                <p class="mb-0 opacity-75">Total Doctors</p>
                            </div>
                            <i class="fas fa-user-md fa-3x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-3 col-sm-6 mb-3">
            <a asp-action="ManageNurses" asp-controller="Admin" class="text-decoration-none">
                <div class="card border-0 shadow-sm bg-success text-white hover-lift">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h2 class="display-6 fw-bold mb-2">@stats?.TotalNurses</h2>
                                <p class="mb-0 opacity-75">Total Nurses</p>
                            </div>
                            <i class="fas fa-user-nurse fa-3x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-3 col-sm-6 mb-3">
            <a href="/AppointmentManagement/Index" class="text-decoration-none">
                <div class="card border-0 shadow-sm bg-warning text-white hover-lift">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h2 class="display-6 fw-bold mb-2">@stats?.PendingAppointments</h2>
                                <p class="mb-0 opacity-75">Pending Appointments</p>
                            </div>
                            <i class="fas fa-calendar-alt fa-3x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0">
                        <i class="fas fa-bolt me-2 text-primary"></i>Quick Actions
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-3 col-sm-6 mb-3">
                            <a asp-action="CreateDoctor" asp-controller="Admin" class="text-decoration-none">
                                <div class="card border-0 shadow-sm h-100 hover-lift">
                                    <div class="card-body text-center p-4">
                                        <i class="fas fa-user-md fa-3x text-primary mb-3"></i>
                                        <h6 class="card-title">Add New Doctor</h6>
                                        <p class="small text-muted">Create doctor account</p>
                                    </div>
                                </div>
                            </a>
                        </div>

                        <div class="col-md-3 col-sm-6 mb-3">
                            <a asp-action="ManageDoctors" asp-controller="Admin" class="text-decoration-none">
                                <div class="card border-0 shadow-sm h-100 hover-lift">
                                    <div class="card-body text-center p-4">
                                        <i class="fas fa-list fa-3x text-info mb-3"></i>
                                        <h6 class="card-title">Manage Doctors</h6>
                                        <p class="small text-muted">View all doctors</p>
                                    </div>
                                </div>
                            </a>
                        </div>

                        <div class="col-md-3 col-sm-6 mb-3">
                            <a asp-action="CreateNurse" asp-controller="Admin" class="text-decoration-none">
                                <div class="card border-0 shadow-sm h-100 hover-lift">
                                    <div class="card-body text-center p-4">
                                        <i class="fas fa-user-nurse fa-3x text-success mb-3"></i>
                                        <h6 class="card-title">Add New Nurse</h6>
                                        <p class="small text-muted">Create nurse account</p>
                                    </div>
                                </div>
                            </a>
                        </div>

                        <div class="col-md-3 col-sm-6 mb-3">
                            <a asp-action="ManageNurses" asp-controller="Admin" class="text-decoration-none">
                                <div class="card border-0 shadow-sm h-100 hover-lift">
                                    <div class="card-body text-center p-4">
                                        <i class="fas fa-list fa-3x text-success mb-3"></i>
                                        <h6 class="card-title">Manage Nurses</h6>
                                        <p class="small text-muted">View all nurses</p>
                                    </div>
                                </div>
                            </a>
                        </div>

                        <div class="col-md-3 col-sm-6 mb-3">
                            <a asp-action="ManagePatients" asp-controller="Admin" class="text-decoration-none">
                                <div class="card border-0 shadow-sm h-100 hover-lift">
                                    <div class="card-body text-center p-4">
                                        <i class="fas fa-users fa-3x text-warning mb-3"></i>
                                        <h6 class="card-title">Manage Patients</h6>
                                        <p class="small text-muted">View all Patients</p>
                                    </div>
                                </div>
                            </a>
                        </div>

                        <div class="col-md-3 col-sm-6 mb-3">
                            <a href="/AppointmentManagement/Index" class="text-decoration-none">
                                <div class="card border-0 shadow-sm h-100 hover-lift">
                                    <div class="card-body text-center p-4">
                                        <i class="fas fa-calendar-check fa-3x text-purple mb-3"></i>
                                        <h6 class="card-title">Manage Appointments</h6>
                                        <p class="small text-muted">Manage all appointments</p>
                                    </div>
                                </div>
                            </a>
                        </div>

                        <div class="col-md-3 col-sm-6 mb-3">
                            <a href="/Complaint" class="text-decoration-none">
                                <div class="card border-0 shadow-sm h-100 hover-lift">
                                    <div class="card-body text-center p-4">
                                        <i class="fas fa-comment-medical fa-3x text-danger mb-3"></i>
                                        <h6 class="card-title">View Feedback</h6>
                                        <p class="small text-muted">Manage feedback & complaints</p>
                                    </div>
                                </div>
                            </a>
                        </div>

                        <div class="col-md-3 col-sm-6 mb-3">
                            <a asp-action="ManageBlog" asp-controller="Admin" class="text-decoration-none">
                                <div class="card border-0 shadow-sm h-100 hover-lift">
                                    <div class="card-body text-center p-4">
                                        <i class="fas fa-blog fa-3x text-info mb-3"></i>
                                        <h6 class="card-title">Manage Blog</h6>
                                        <p class="small text-muted">Create & edit blog posts</p>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activities -->
    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0">
                        <i class="fas fa-history me-2 text-primary"></i>Recent Activities
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (activities != null && activities.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var activity in activities)
                            {
                                <div class="list-group-item border-0 py-3">
                                    <div class="d-flex align-items-center">
                                        <div class="flex-shrink-0">
                                            <div class="bg-light rounded-circle p-3">
                                                <i class="fas
                                                            @(activity.ActivityType == "Appointment" ? "fa-calendar text-primary" :
                                                                                                         activity.ActivityType == "Registration" ? "fa-user-plus text-success" :
                                                                                                         activity.ActivityType == "Doctor" ? "fa-user-md text-info" :
                                                                                                         activity.ActivityType == "Nurse" ? "fa-user-nurse text-success" :
                                                                                                         "fa-bell text-warning") fa-lg"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="mb-1">@activity.Description</h6>
                                    <p class="text-muted mb-0">
                                        <i class="fas fa-user me-1"></i>@activity.UserName
                                        <span class="mx-2">•</span>
                                        <i class="fas fa-clock me-1"></i>@activity.ActivityDate.ToString("hh:mm tt")
                                    </p>
                                </div>
                                <div class="text-end">
                                    <small class="text-muted">@activity.ActivityDate.ToString("MMM dd")</small>
                                </div>
                            </div>
                        </div>
                                                }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-history fa-3x text-muted mb-3"></i>
                            <h6 class="text-muted">No recent activities</h6>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- System Status -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0">
                        <i class="fas fa-server me-2 text-success"></i>System Status
                    </h5>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center border-0 py-3">
                            <span>
                                <i class="fas fa-database me-2 text-primary"></i>Database
                            </span>
                            <span class="badge bg-success">Online</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center border-0 py-3">
                            <span>
                                <i class="fas fa-user-md me-2 text-info"></i>Doctors
                            </span>
                            <span class="badge bg-info">@stats?.TotalDoctors Active</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center border-0 py-3">
                            <span>
                                <i class="fas fa-user-nurse me-2 text-success"></i>Nurses
                            </span>
                            <span class="badge bg-success">@stats?.TotalNurses Active</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center border-0 py-3">
                            <span>
                                <i class="fas fa-clinic-medical me-2 text-warning"></i>Appointments
                            </span>
                            <span class="badge bg-warning">@stats?.PendingAppointments Pending</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center border-0 py-3">
                            <span>
                                <i class="fas fa-comment-medical me-2 text-danger"></i>Complaints
                            </span>
                            <span class="badge bg-danger">@stats?.PendingComplaints Pending</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center border-0 py-3">
                            <span>
                                <i class="fas fa-user-shield me-2 text-dark"></i>Security
                            </span>
                            <span class="badge bg-success">Active</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Function to refresh activities
        function refreshActivities() {
            const refreshBtn = document.querySelector('button[onclick="refreshActivities()"]');
            if (refreshBtn) {
                refreshBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
                refreshBtn.disabled = true;
            }

            // Show loading indicator
            const activitiesList = document.getElementById('activitiesList');
            if (activitiesList) {
                activitiesList.innerHTML = `
                    <div class="text-center py-4">
                        <div class="spinner-border text-primary mb-3" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="text-muted">Loading activities...</p>
                    </div>
                `;
            }

            // Reload the page after 1 second
            setTimeout(() => {
                location.reload();
            }, 1000);
        }

        // Auto-refresh every 2 minutes
        let autoRefreshInterval = setInterval(() => {
            console.log("Auto-refreshing activities...");
            refreshActivities();
        }, 120000); // 2 minutes

        // Stop auto-refresh when tab is not visible
        document.addEventListener('visibilitychange', function() {
            if (document.hidden) {
                clearInterval(autoRefreshInterval);
            } else {
                autoRefreshInterval = setInterval(() => {
                    refreshActivities();
                }, 120000);
            }
        });

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            console.log(`Loaded ${@(activities?.Count ?? 0)} real activities`);

            // Scroll to dashboard
            const scrolltomain = document.getElementById('adminDashboard');
            if (scrolltomain) {
                scrolltomain.classList.add('scroll-target');
                scrolltomain.scrollIntoView({ behavior: 'smooth' });
            }
        });
    </script>
}