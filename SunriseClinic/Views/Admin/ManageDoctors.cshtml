@{
    ViewData["Title"] = "Manage Doctors";
    var doctors = ViewBag.Doctors as List<dynamic>;
    var searchTerm = ViewBag.SearchTerm as string;
    var hasSearchTerm = !string.IsNullOrEmpty(searchTerm);
}

<div class="container-fluid py-3" id="manageDoctors">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">
                <i class="fas fa-user-md me-2 text-primary"></i>Manage Doctors
            </h3>
            <p class="text-muted mb-0">All registered doctors in the system</p>
        </div>
        <a href="/Admin/CreateDoctor" class="btn btn-primary">
            <i class="fas fa-user-plus me-2"></i>Add New Doctor
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@Html.Raw(TempData["SuccessMessage"])
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@Html.Raw(TempData["ErrorMessage"])
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Doctors Table -->
    <div class="card border-0 shadow-sm">
        <!-- এখানে card-header পরিবর্তিত হয়েছে -->
        <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-0">
                    <i class="fas fa-list me-2 text-primary"></i>Doctors List
                </h5>
            </div>

            <!-- সার্চ ফর্ম -->
            <div class="d-flex align-items-center">
                <form method="get" action="/Admin/ManageDoctors" class="d-flex" id="searchForm">
                    <div class="input-group input-group-sm" style="width: 320px;">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="fas fa-search text-muted"></i>
                        </span>
                        <input type="text"
                               name="searchTerm"
                               id="searchInput"
                               class="form-control border-start-0"
                               placeholder="Search by Name, ID, Email, Specialization..."
                               value="@searchTerm">
                        @if (!string.IsNullOrEmpty(searchTerm))
                        {
                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    id="clearSearch"
                                    title="Clear search">
                                <i class="fas fa-times"></i>
                            </button>
                        }
                        <button type="submit"
                                class="btn btn-primary"
                                title="Search">
                            Search
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card-body p-0">
            @if (doctors != null && doctors.Any())
            {
                <!-- সার্চ রেজাল্ট ইনফো -->
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <div class="alert alert-info alert-dismissible fade show m-3 mb-2" role="alert">
                        <i class="fas fa-info-circle me-2"></i>
                        Showing results for "<strong>@searchTerm</strong>"
                        - @doctors.Count doctor(s) found
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Doctor ID</th>
                                <th>Name</th>
                                <th>Specialization</th>
                                <th>Qualification</th>
                                <th>Contact</th>
                                <th>Fee (৳)</th>
                                <th>Joined</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doctor in doctors)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-primary">@doctor.DisplayId</span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@doctor.FullName</div>
                                        <small class="text-muted">@doctor.Email</small>
                                    </td>
                                    <td>@doctor.Specialization</td>
                                    <td>@doctor.Qualification</td>
                                    <td>
                                        <div>@doctor.PhoneNumber</div>
                                        <small class="text-muted">License: @doctor.LicenseNumber</small>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">৳@doctor.ConsultationFee.ToString("N0")</span>
                                    </td>
                                    <td>
                                        <small>@doctor.CreatedAt.ToString("dd-MMM-yyyy")</small>
                                    </td>
                                    <td>
                                        <a href="/Admin/EditDoctor/@doctor.UserId"
                                           class="btn btn-sm btn-outline-primary me-1"
                                           title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger delete-doctor-btn"
                                                data-doctor-id="@doctor.UserId"
                                                data-doctor-name="@doctor.FullName"
                                                data-doctor-displayid="@doctor.DisplayId"
                                                data-doctor-specialization="@doctor.Specialization"
                                                title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    @if (!string.IsNullOrEmpty(searchTerm))
                    {
                        <i class="fas fa-search fa-3x text-warning mb-3"></i>
                        <h6 class="text-muted">No doctors found</h6>
                        <p class="small text-muted mb-4">
                            No doctors found for "<strong>@searchTerm</strong>"
                        </p>
                        <a href="/Admin/ManageDoctors" class="btn btn-outline-primary">
                            <i class="fas fa-times me-2"></i>Clear Search
                        </a>
                    }
                    else
                    {
                        <i class="fas fa-user-md fa-3x text-muted mb-3"></i>
                        <h6 class="text-muted">No doctors found</h6>
                        <p class="small text-muted mb-4">No doctors have been registered yet</p>
                        <a href="/Admin/CreateDoctor" class="btn btn-primary">
                            <i class="fas fa-user-plus me-2"></i>Add First Doctor
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- ✅ Delete Confirmation Modal (Single Modal) -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="fas fa-trash-alt me-2"></i>Delete Doctor
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this doctor?</p>
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    This action cannot be undone! All related data (appointments, etc.) will be deleted.
                </div>
                <div class="doctor-details mt-3">
                    <p><strong>Name:</strong> <span id="doctorName"></span></p>
                    <p><strong>ID:</strong> <span id="doctorDisplayId"></span></p>
                    <p><strong>Specialization:</strong> <span id="doctorSpecialization"></span></p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancel
                </button>
                <form id="deleteForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash-alt me-1"></i>Delete Doctor
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Delete button click handler
            document.querySelectorAll('.delete-doctor-btn').forEach(button => {
                button.addEventListener('click', function () {
                    const doctorId = this.getAttribute('data-doctor-id');
                    const doctorName = this.getAttribute('data-doctor-name');
                    const doctorDisplayId = this.getAttribute('data-doctor-displayid');
                    const doctorSpecialization = this.getAttribute('data-doctor-specialization');

                    // Set modal content
                    document.getElementById('doctorName').textContent = doctorName;
                    document.getElementById('doctorDisplayId').textContent = doctorDisplayId;
                    document.getElementById('doctorSpecialization').textContent = doctorSpecialization;

                    // Set form action
                    const deleteForm = document.getElementById('deleteForm');
                    deleteForm.action = '/Admin/DeleteUser/' + doctorId;

                    // Show modal
                    const modal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
                    modal.show();
                });
            });

            // Clear search button
            const clearSearchBtn = document.getElementById('clearSearch');
            if (clearSearchBtn) {
                clearSearchBtn.addEventListener('click', function() {
                    window.location.href = '/Admin/ManageDoctors';
                });
            }

            // সার্চ ফর্ম submit - Enter key support
            const searchForm = document.getElementById('searchForm');
            const searchInput = document.getElementById('searchInput');

        // ✅ পরিবর্তিত কোড
        if (searchInput) {
            searchInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    searchForm.submit();
                }
            });

            // Focus on search input if search term exists
            // ✅ @hasSearchTerm ব্যবহার করুন
            if (@hasSearchTerm.ToString().ToLower()) {
                setTimeout(() => {
                    searchInput.focus();
                    searchInput.select();
                }, 100);
            }
        }

            // Auto-hide alerts after 5 seconds
            setTimeout(function() {
                const alerts = document.querySelectorAll('.alert');
                alerts.forEach(alert => {
                    const bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);
        });

        // Scroll to Main on page load
        document.addEventListener('DOMContentLoaded', function() {
            const scrolltomain = document.getElementById('manageDoctors');
            if (scrolltomain) {
                scrolltomain.classList.add('scroll-target');
                scrolltomain.scrollIntoView({ behavior: 'smooth' });
            }
        });
    </script>
}