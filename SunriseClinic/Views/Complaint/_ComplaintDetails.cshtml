@* Views/Complaint/_ComplaintDetails.cshtml *@
@model dynamic

<div class="Feedback-details">
    <div class="row">
        <div class="col-md-6">
            <h6><i class="fas fa-user me-2"></i>User Information</h6>
            <table class="table table-sm table-bordered">
                <tr>
                    <th width="120">Name:</th>
                    <td>
                        @Model.VisitorName
                        @if (!string.IsNullOrEmpty(Model.UserType))
                        {
                            <span class="badge @GetUserTypeBadgeClass(Model.UserType) ms-2">
                                @Model.UserType
                            </span>
                        }
                    </td>
                </tr>
                <tr>
                    <th>Email:</th>
                    <td>@Model.VisitorEmail</td>
                </tr>
                <tr>
                    <th>Phone:</th>
                    <td>@Model.VisitorPhone</td>
                </tr>
                @if (!string.IsNullOrEmpty(Model.DisplayId))
                {
                    <tr class="table-info">
                        <th>User ID:</th>
                        <td>
                            <span class="badge bg-dark">@Model.DisplayId</span>
                        </td>
                    </tr>
                }

            </table>
        </div>

        <div class="col-md-6">
            <h6><i class="fas fa-info-circle me-2"></i>Complaint Details</h6>
            <table class="table table-sm table-bordered">
                <tr>
                    <th width="120">Type:</th>
                    <td>
                        <span class="badge @GetSubjectBadgeClass(Model.Subject)">
                            @Model.Subject
                        </span>
                    </td>
                </tr>
                <tr>
                    <th>Date:</th>
                    <td>@Model.ComplaintDate.ToString("dd MMM yyyy hh:mm tt")</td>
                </tr>
                <tr>
                    <th>Status:</th>
                    <td>
                        @if (Model.IsResolved)
                        {
                            <span class="badge bg-success">
                                <i class="fas fa-check-circle me-1"></i>Resolved
                                @if (Model.ResolvedDate != null)
                                {
                                    <br />
                                    <small>on @(((DateTime)Model.ResolvedDate).ToString("dd MMM yyyy"))</small>
                                }
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning">
                                <i class="fas fa-clock me-1"></i>Pending
                            </span>
                        }

                        @if (Model.IsImportant)
                        {
                            <span class="badge bg-danger ms-2">
                                <i class="fas fa-exclamation-circle me-1"></i>Important
                            </span>
                        }
                    </td>
                </tr>
                @if (!string.IsNullOrEmpty(Model.AdminNotes))
                {
                    <tr>
                        <th>Admin Notes:</th>
                        <td class="text-muted">@Model.AdminNotes</td>
                    </tr>
                }
            </table>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-12">
            <h6><i class="fas fa-comment me-2"></i>Description</h6>
            <div class="card">
                <div class="card-body bg-light">
                    @Model.Description
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetSubjectBadgeClass(string subject)
    {
        return subject switch
        {
            "Complaint" => "bg-danger",
            "Suggestion" => "bg-info",
            "Appreciation" => "bg-success",
            "Technical Issue" => "bg-warning",
            _ => "bg-secondary"
        };
    }

    string GetUserTypeBadgeClass(string userType)
    {
        return userType switch
        {
            "Patient" => "bg-primary",
            "Doctor" => "bg-success",
            "Nurse" => "bg-info",
            "Admin" => "bg-dark",
            _ => "bg-secondary"
        };
    }
}