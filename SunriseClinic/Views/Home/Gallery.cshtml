@* Views/Gallery.cshtml *@
@{
    ViewData["Title"] = "Photo Gallery - Sunrise Clinic & Diagnostic Center Pabna | Medical Facility Images";
    ViewData["Description"] = "Gallery of Sunrise Clinic Pabna diagnostic center. View our pathology lab, radiology department, waiting area, medical equipment and clinic facilities photos.";
    ViewData["Keywords"] = "sunrise clinic gallery, medical lab photos pabna, diagnostic center images, hospital pictures, radiology department photos, pathology lab images";
    ViewData["Canonical"] = "https://www.sunriseclinicbd.com/Home/Gallery";
    ViewData["Image"] = "https://www.sunriseclinicbd.com/img/sunrise-clinic.png";

    string domain = "https://www.sunriseclinicbd.com";
}

<!-- Schema.org Structured Data -->
<script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "MedicalClinic",
      "name": "Sunrise Clinic & Diagnostic Center Gallery",
      "description": "Photo gallery of medical facilities at Sunrise Clinic Pabna diagnostic center",
      "url": "@domain/Home/Gallery",
      "image": [
        "@domain/img/sunrise-clinic.png",
        "@domain/img/gallery/waiting-area.webp",
        "@domain/img/department/pathology.webp",
        "@domain/images/radiology-room.jpg"
      ],
      "photo": {
        "@@type": "Photograph",
        "about": "Medical clinic facilities and diagnostic equipment",
        "creator": {
          "@@type": "Organization",
          "name": "Sunrise Clinic & Diagnostic Center"
        }
      }
    }
</script>

<script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "@domain/"
        },
        {
          "@@type": "ListItem",
          "position": 2,
          "name": "Gallery",
          "item": "@domain/Home/Gallery"
        }
      ]
    }
</script>

<!-- SEO Meta Tags -->
<meta name="robots" content="index, follow">
<meta name="author" content="Sunrise Clinic Photography">
<meta name="geo.region" content="BD-RS">
<meta name="geo.placename" content="Pabna">
<meta property="og:type" content="website">
<meta property="og:url" content="@domain/Home/Gallery">
<meta property="og:title" content="Sunrise Clinic Pabna Gallery - Medical Facility Photos">
<meta property="og:description" content="View photos of Sunrise Clinic diagnostic center in Pabna: Pathology lab, radiology, waiting area, medical equipment images.">
<meta property="og:image" content="@ViewData["Image"]">
<meta property="og:image:alt" content="Sunrise Clinic Pabna Gallery Photos">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Sunrise Clinic Pabna Gallery - Medical Facility Images">
<meta name="twitter:description" content="Gallery of diagnostic center facilities at Sunrise Clinic Pabna">

<!-- Hero Section -->
<section class="hero-section-g py-5" id="galleryHero" itemscope itemtype="https://schema.org/MedicalClinic">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="display-4 fw-bold mb-4 text-dark" itemprop="name">
                    Sunrise Clinic Pabna Gallery - Diagnostic Center Facilities Photos
                </h1>
                <p class="lead mb-4 text-dark" itemprop="description">
                    Explore photos of our modern diagnostic facilities, advanced medical equipment, and patient-friendly environment at Sunrise Clinic Pabna
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a href="#clinic-facilities" class="btn btn-primary btn-lg px-4 py-3" aria-label="View clinic facilities photos">
                        <i class="fas fa-building me-2"></i>Clinic Facilities Photos
                    </a>
                    <a href="#diagnostic-lab" class="btn btn-outline-primary btn-lg px-4 py-3" aria-label="View diagnostic lab images">
                        <i class="fas fa-microscope me-2"></i>Pathology Lab Images
                    </a>
                    <a href="#radiology-imaging" class="btn btn-outline-primary btn-lg px-4 py-3" aria-label="View radiology department photos">
                        <i class="fas fa-x-ray me-2"></i>Radiology Photos
                    </a>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="hero-image position-relative">
                    <img src="/img/gallery/waiting-area.webp"
                         class="img-fluid rounded-4 shadow-lg"
                         alt="Sunrise Clinic Pabna Main Entrance - Diagnostic Center Waiting Area"
                         title="Sunrise Clinic Pabna Reception Area"
                         itemprop="image">
                    <div class="floating-badge bg-primary text-white p-3 rounded-3 shadow">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-camera fa-2x me-3"></i>
                            <div>
                                <small class="d-block">Medical Facility</small>
                                <strong class="h5 mb-0">50+ Photos</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

