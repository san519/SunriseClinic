<style>
    .hero-section-e {
        background: linear-gradient(135deg, rgba(220, 53, 69, 0.1) 0%, rgba(255, 193, 7, 0.1) 100%);
        padding: 10px 0;
    }

    .bg-accent {
        background-color: #20c997 !important;
        border-color: #20c997;
    }

    .btn-accent {
        background-color: #20c997;
        border-color: #20c997;
        color: white;
    }

        .btn-accent:hover {
            background-color: #199d76;
            border-color: #199d76;
            color: white;
        }

    .card-hover {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1) !important;
        }

    .icon-container {
        width: 80px;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }

</style>

@section Scripts {
    <script>
        // Scroll to main on page load
        document.addEventListener('DOMContentLoaded', function() {
            const scrolltomain = document.getElementById('emergency');
            if (scrolltomain) {
                scrolltomain.classList.add('scroll-target');
                scrolltomain.scrollIntoView({ behavior: 'smooth' });
            }
        });

        // Emergency call button enhancement
        document.querySelectorAll('a[href^="tel:"]').forEach(link => {
            link.addEventListener('click', function(e) {
                // Optional: Add analytics tracking for emergency calls
                console.log('Emergency call initiated: ' + this.textContent);
            });
        });
    </script>
}