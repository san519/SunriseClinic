<!-- Hero Section with Stats -->
<section class="hero-section position-relative overflow-hidden py-3" itemscope itemtype="https://schema.org/MedicalClinic">
    <div class="container py-3">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="fw-bold mb-3 text-dark" itemprop="name">Complete Diagnostic & Healthcare Solutions in Pabna</h1>
                <p class="lead mb-4 text-dark" itemprop="description">Sunrise Clinic Pabna offers advanced medical testing with precision, care, and affordable pricing. Your health is our priority at our diagnostic center.</p>

                <!-- Key Stats with Schema -->
                <div class="row g-4 mb-4">
                    <div class="col-4" itemscope itemtype="https://schema.org/QuantitativeValue">
                        <div class="stat-box text-center">
                            <h3 class="text-primary fw-bold mb-0" itemprop="value">60+</h3>
                            <p class="text-muted mb-0" itemprop="description">Medical Tests Available</p>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="stat-box text-center">
                            <h3 class="text-primary fw-bold mb-0">24/7</h3>
                            <p class="text-muted mb-0">Emergency Support</p>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="stat-box text-center">
                            <h3 class="text-primary fw-bold mb-0">₹150+</h3>
                            <p class="text-muted mb-0">Starting Price</p>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-3">
                    <div class="row">
                        <div class="col-12 text-center">
                            <a asp-controller="Account" asp-action="Register" class="btn btn-premium-register px-4 py-3 rounded-pill shadow-sm"
                               aria-label="Register at Sunrise Clinic for faster appointments and digital reports">
                                <i class="fas fa-user-plus me-2"></i>Register Now
                            </a>
                            <p class="text-muted small mt-2 mb-0">Registered patients enjoy faster appointments, digital reports, and special offers at Sunrise Clinic Pabna</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="hero-image position-relative">
                    <img src="/img/sunrise-clinic.webp" class="img-fluid rounded-4 shadow-lg"
                         alt="Sunrise Clinic & Diagnostic Center Pabna - Best Medical Lab in Bangladesh"
                         title="Sunrise Clinic Pabna Diagnostic Center"
                         loading="eager"
                         width="600"
                         height="400"
                         itemprop="image">
                    <div class="floating-badge bg-primary text-white p-3 rounded-3 shadow">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-award fa-2x me-3"></i>
                            <div>
                                <small class="d-block">Trusted By</small>
                                <strong class="h5 mb-0">5000+ Patients</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

