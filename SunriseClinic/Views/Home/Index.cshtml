              "text": "CBC with ESR test costs ₹500 at our diagnostic center in Pabna."
            }
          }, {
            "@@type": "Question",
            "name": "How long does it take to get blood test reports?",
            "acceptedAnswer": {
              "@@type": "Answer",
              "text": "Most pathology reports are available within 4-6 hours, with emergency reports in 2 hours at Sunrise Clinic."
            }
          }]
        }
    </script>

    <script>
        // Testimonial carousel
        let currentTestimonial = 0;
        const testimonials = document.querySelectorAll('.testimonial-slide');

        function showTestimonial(index) {
            testimonials.forEach((testimonial, i) => {
                testimonial.style.display = i === index ? 'block' : 'none';
            });
        }

        // Auto rotate testimonials every 5 seconds
        setInterval(() => {
            currentTestimonial = (currentTestimonial + 1) % testimonials.length;
            showTestimonial(currentTestimonial);
        }, 5000);

        // Initialize
        showTestimonial(0);

        // Animation on scroll
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('animated');
                }
            });
        }, observerOptions);

        // Observe elements for animation
        document.querySelectorAll('.stat-box, .feature-card, .service-card').forEach(el => {
            observer.observe(el);
        });

        // Track outbound links for analytics
        document.querySelectorAll('a[href^="http"]').forEach(link => {
            if (!link.href.includes('sunriseclinicbd.com')) {
                link.addEventListener('click', function(e) {
                    // Send analytics event for outbound link
                    console.log('Outbound link clicked:', this.href);
                });
            }
        });

        // Lazy loading for images
        if ('loading' in HTMLImageElement.prototype) {
            const images = document.querySelectorAll('img[loading="lazy"]');
            images.forEach(img => {
                img.src = img.dataset.src;
            });
        }

        // Price filter functionality
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Sunrise Clinic Pabna - www.sunriseclinicbd.com homepage loaded with SEO optimization.');

            // Add event listener for appointment booking
            document.querySelectorAll('.btn-primary').forEach(button => {
                if (button.textContent.includes('Book Now')) {
                    button.addEventListener('click', function() {
                        console.log('Appointment booking initiated from:', this.closest('.test-name')?.textContent || 'unknown');
                    });
                }
            });
        });

        // Add structured data for breadcrumbs dynamically
        const breadcrumbData = {
            "@@context": "https://schema.org",
            "@@type": "BreadcrumbList",
            "itemListElement": [
                {
                    "@@type": "ListItem",
                    "position": 1,
                    "name": "Home",
                    "item": "@domain/"
                },
                {
                    "@@type": "ListItem",
                    "position": 2,
                    "name": "Diagnostic Center",
                    "item": "@domain/Home/Index"
                }
            ]
        };

        const script = document.createElement('script');
        script.type = 'application/ld+json';
        script.text = JSON.stringify(breadcrumbData);
        document.head.appendChild(script);
    </script>
}