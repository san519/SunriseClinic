@* Views/Home/Index.cshtml - SEO Optimized for sunriseclinicbd.com *@
@using SunriseClinic.Data
@inject SunriseDbContext DbContext

@{
    string domain = "https://www.sunriseclinicbd.com";
    string fullUrl = domain + Context.Request.Path;

    ViewData["Title"] = "Sunrise Clinic & Diagnostic Center | Best Medical Lab in Pabna";
    ViewData["Description"] = "Sunrise Clinic & Diagnostic Center Pabna offers 60+ affordable medical tests: Pathology ₹150+, Radiology ₹300+, USG ₹1000. 24/7 emergency, digital reports.";
    ViewData["Keywords"] = "sunrise clinic pabna, diagnostic center bangladesh, medical lab pabna, blood test, usg, x-ray, ecg, pathology lab, sunriseclinicbd";
    ViewData["Image"] = domain + "/img/sunrise-clinic.webp";
    ViewData["Canonical"] = domain + "/";

    var clinicName = "Sunrise Clinic & Diagnostic Center";
    var clinicAddress = "TB Clinic Gate, Shalgaria, Pabna Sadar, Pabna, Bangladesh";
    var clinicPhone = "+8801703452323";
    var clinicEmail = "info@sunriseclinicbd.com";
    var clinicHours = "8:00 AM - 10:00 PM (Daily)";
    var clinicGeo = "24.0064,89.2372";
}

<!-- Schema.org Structured Data for Medical Clinic -->
<script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "MedicalClinic",
      "@@id": "@domain/#medicalclinic",
      "name": "@clinicName",
      "description": "Sunrise Clinic & Diagnostic Center offers complete diagnostic solutions with 60+ medical tests including pathology, radiology, and specialized diagnostics at affordable prices in Pabna, Bangladesh.",
      "url": "@domain",
      "telephone": "@clinicPhone",
      "email": "@clinicEmail",
      "image": "@ViewData["Image"]",
      "logo": "@domain/img/logo.png",
      "address": {
        "@@type": "PostalAddress",
        "streetAddress": "TB Clinic Gate, Shalgaria",
        "addressLocality": "Pabna Sadar",
        "addressRegion": "Pabna",
        "addressCountry": "BD",
        "postalCode": "6600"
      },
      "geo": {
        "@@type": "GeoCoordinates",
        "latitude": "24.0064",
        "longitude": "89.2372"
      },
      "openingHours": "Mo-Su 08:00-22:00",
      "openingHoursSpecification": [
        {
          "@@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
          "opens": "08:00",
          "closes": "22:00"
        }
      ],
      "priceRange": "₹₹",
      "medicalSpecialty": ["DiagnosticRadiology", "Pathology", "ClinicalPathology"],
      "hasOfferCatalog": {
        "@@type": "OfferCatalog",
        "name": "Diagnostic Tests Packages",
        "itemListElement": [
          {
            "@@type": "Offer",
            "name": "Basic Health Checkup",
            "description": "Complete basic health screening package",
            "price": "1200",
            "priceCurrency": "BDT",
            "url": "@domain/Appointment/Create?package=basic"
          },
          {
            "@@type": "Offer",
            "name": "USG Whole Abdomen",
            "description": "Ultrasound examination of whole abdomen",
            "price": "1000",
            "priceCurrency": "BDT",
            "url": "@domain/Appointment/Create?test=USG Whole Abdomen"
          }
        ]
      },
      "aggregateRating": {
        "@@type": "AggregateRating",
        "ratingValue": "4.9",
        "ratingCount": "5000",
        "bestRating": "5",
        "worstRating": "1"
      },
      "sameAs": [
        "https://www.facebook.com/sunriseclinicbd",
        "https://www.twitter.com/sunriseclinicbd"
      ]
    }
</script>

<!-- Local Business Structured Data -->
<script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "LocalBusiness",
      "name": "@clinicName",
      "@@id": "@domain",
      "url": "@domain",
      "telephone": "@clinicPhone",
      "address": {
        "@@type": "PostalAddress",
        "streetAddress": "TB Clinic Gate, Shalgaria",
        "addressLocality": "Pabna",
        "addressRegion": "Rajshahi",
        "addressCountry": "Bangladesh"
      },
      "geo": {
        "@@type": "GeoCoordinates",
        "latitude": "24.0064",
        "longitude": "89.2372"
      },
      "openingHours": "Mo-Su 08:00-22:00",
      "priceRange": "₹₹",
      "image": "@ViewData["Image"]"
    }
</script>

<!-- Breadcrumb Structured Data -->
<script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "@domain/"
        },
        {
          "@@type": "ListItem",
          "position": 2,
          "name": "Diagnostic Services",
          "item": "@domain/Services/DiagnosticServices"
        }
      ]
    }
</script>

<!-- Medical Test Structured Data -->
<script type="application/ld+json">
    [{
      "@@context": "https://schema.org",
      "@@type": "MedicalTest",
      "name": "CBC with ESR Test",
      "description": "Complete Blood Count with Erythrocyte Sedimentation Rate test",
      "code": {
        "@@type": "MedicalCode",
        "codeValue": "CBC-ESR",
        "codingSystem": "Local"
      },
      "usesDevice": {
        "@@type": "MedicalDevice",
        "name": "5-part Hematology Analyzer"
      },
      "recognizingAuthority": {
        "@@type": "Organization",
        "name": "Sunrise Clinic Laboratory"
      },
      "legalStatus": "Approved",
      "url": "@domain/Services/DiagnosticServices#hematology"
    },
    {
      "@@context": "https://schema.org",
      "@@type": "MedicalTest",
      "name": "USG Whole Abdomen",
      "description": "Ultrasound examination of complete abdominal area",
      "code": {
        "@@type": "MedicalCode",
        "codeValue": "USG-WA",
        "codingSystem": "Local"
      },
      "usesDevice": {
        "@@type": "MedicalDevice",
        "name": "Digital Color Doppler Ultrasound"
      },
      "recognizingAuthority": {
        "@@type": "Organization",
        "name": "Sunrise Clinic Radiology"
      },
      "legalStatus": "Approved",
      "url": "@domain/Services/DiagnosticServices#radiology"
    }]
</script>

<!-- SEO Meta Tags -->
