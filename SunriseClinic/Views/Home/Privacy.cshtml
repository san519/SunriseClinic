@{
    ViewData["Title"] = "Privacy Policy | Sunrise Clinic & Diagnostic Center Pabna";
    ViewData["Description"] = "Privacy policy and data protection at Sunrise Clinic Pabna. We protect your medical information, personal data, and ensure confidentiality of patient records.";
    ViewData["Keywords"] = "privacy policy, data protection, medical confidentiality, patient privacy, healthcare data security, sunrise clinic privacy";
    ViewData["Canonical"] = "https://www.sunriseclinicbd.com/Home/Privacy";
    ViewData["Breadcrumb"] = @"
    {
        ""@@type"": ""ListItem"",
        ""position"": 2,
        ""name"": ""Privacy Policy"",
        ""item"": ""https://www.sunriseclinicbd.com/Home/Privacy""
    }";
}

<!-- FAQ Schema for Privacy Policy -->
<script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "FAQPage",
      "mainEntity": [
        {
          "@@type": "Question",
          "name": "How does Sunrise Clinic protect patient data privacy?",
          "acceptedAnswer": {
            "@@type": "Answer",
            "text": "Sunrise Clinic follows strict medical confidentiality protocols, secure electronic records, limited staff access, and complies with healthcare privacy regulations to protect patient data in Pabna."
          }
        },
        {
          "@@type": "Question",
          "name": "What personal information does Sunrise Clinic collect?",
          "acceptedAnswer": {
            "@@type": "Answer",
            "text": "Sunrise Clinic collects necessary information: patient name, contact details, medical history, test results, and payment information for providing healthcare services in Pabna."
          }
        },
        {
          "@@type": "Question",
          "name": "How long does Sunrise Clinic keep medical records?",
          "acceptedAnswer": {
            "@@type": "Answer",
            "text": "Sunrise Clinic maintains medical records for minimum 5 years as per healthcare regulations. Critical records may be kept longer for patient care continuity."
          }
        },
        {
          "@@type": "Question",
          "name": "Can I access my medical records from Sunrise Clinic?",
          "acceptedAnswer": {
            "@@type": "Answer",
            "text": "Yes, patients can access their medical records by requesting at Sunrise Clinic reception. Digital records available through patient portal with secure login."
          }
        }
      ]
    }
</script>

<!-- WebPage Schema -->
<script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "WebPage",
      "name": "Privacy Policy - Sunrise Clinic & Diagnostic Center",
      "description": "Privacy policy and data protection information for Sunrise Clinic healthcare services",
      "url": "https://www.sunriseclinicbd.com/Home/Privacy",
      "isPartOf": {
        "@@type": "WebSite",
        "name": "Sunrise Clinic & Diagnostic Center",
        "url": "https://www.sunriseclinicbd.com"
      },
      "datePublished": "2024-01-01",
      "dateModified": "@DateTime.Now.ToString("yyyy-MM-dd")",
      "inLanguage": "en"
    }
</script>

<!-- Breadcrumb Schema -->
<script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.sunriseclinicbd.com/"
        },
        {
          "@@type": "ListItem",
          "position": 2,
          "name": "Privacy Policy",
          "item": "https://www.sunriseclinicbd.com/Home/Privacy"
        }
      ]
    }
</script>

<div class="container py-5" id="privacyPolicy" itemscope itemtype="https://schema.org/WebPage">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <!-- Header -->
            <div class="text-center mb-5">
                <h1 class="display-5 fw-bold mb-3" itemprop="headline">Privacy Policy</h1>
                <p class="lead text-muted" itemprop="description">Sunrise Clinic & Diagnostic Center - Pabna, Bangladesh</p>
                <p class="text-muted"><i class="fas fa-calendar-alt me-2"></i>Last Updated: @DateTime.Now.ToString("dd MMMM, yyyy")</p>
            </div>

            <!-- Hidden SEO Content -->
            <div class="visually-hidden" aria-hidden="true">
                <h2>Sunrise Clinic Privacy Policy Summary</h2>
                <p>Sunrise Clinic & Diagnostic Center in Pabna, Bangladesh protects patient privacy and medical data confidentiality. We follow healthcare privacy standards for medical records, personal information, and test results.</p>
            </div>

            <!-- Introduction -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h2 class="h4 fw-bold text-primary mb-3">
                        <i class="fas fa-shield-alt me-2"></i>Introduction
                    </h2>
                    <p itemprop="text">
                        At <strong>Sunrise Clinic & Diagnostic Center</strong> (located at TB Clinic Gate, Shalgaria, Pabna Sadar, Pabna), we are committed to protecting the privacy and confidentiality of our patients' personal and medical information. This Privacy Policy outlines how we collect, use, disclose, and safeguard your information when you use our healthcare services.
                    </p>
                    <p itemprop="text">
                        We comply with applicable healthcare privacy laws and regulations in Bangladesh to ensure your medical data remains secure and confidential.
                    </p>
                </div>
            </div>

            <!-- Information We Collect -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h2 class="h4 fw-bold text-primary mb-3">
                        <i class="fas fa-info-circle me-2"></i>Information We Collect
                    </h2>

                    <div class="mb-3">
                        <h5 class="fw-bold"><i class="fas fa-user text-success me-2"></i>Personal Information</h5>
                        <ul class="text-muted">
                            <li>Full name, contact details (phone, email, address)</li>
                            <li>Date of birth, gender, national ID/passport information</li>
                            <li>Emergency contact information</li>
                            <li>Insurance information (if applicable)</li>
                        </ul>
                    </div>

                    <div class="mb-3">
                        <h5 class="fw-bold"><i class="fas fa-heartbeat text-danger me-2"></i>Medical Information</h5>
                        <ul class="text-muted">
                            <li>Medical history and current health conditions</li>
                            <li>Diagnostic test results (blood tests, X-ray, USG, ECG)</li>
                            <li>Prescription information and treatment records</li>
                            <li>Doctor consultation notes</li>
                        </ul>
                    </div>

                    <div class="mb-3">
                        <h5 class="fw-bold"><i class="fas fa-credit-card text-warning me-2"></i>Payment Information</h5>
                        <ul class="text-muted">
                            <li>Billing and payment details</li>
                            <li>Transaction records for services rendered</li>
                            <li>Insurance claim information</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- How We Use Your Information -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h2 class="h4 fw-bold text-primary mb-3">
                        <i class="fas fa-cogs me-2"></i>How We Use Your Information
                    </h2>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="d-flex align-items-start">
                                <i class="fas fa-stethoscope text-primary mt-1 me-3"></i>
                                <div>
                                    <h6 class="fw-bold">Healthcare Services</h6>
                                    <p class="small text-muted mb-0">Providing medical diagnosis, treatment, and follow-up care</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <div class="d-flex align-items-start">
                                <i class="fas fa-calendar-check text-success mt-1 me-3"></i>
                                <div>
                                    <h6 class="fw-bold">Appointment Management</h6>
                                    <p class="small text-muted mb-0">Scheduling, reminders, and follow-up appointments</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <div class="d-flex align-items-start">
                                <i class="fas fa-file-medical-alt text-info mt-1 me-3"></i>
                                <div>
                                    <h6 class="fw-bold">Medical Records</h6>
                                    <p class="small text-muted mb-0">Maintaining accurate health records for continuity of care</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <div class="d-flex align-items-start">
                                <i class="fas fa-bell text-warning mt-1 me-3"></i>
                                <div>
                                    <h6 class="fw-bold">Service Communication</h6>
                                    <p class="small text-muted mb-0">Test results, health alerts, and service updates</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Data Protection Measures -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h2 class="h4 fw-bold text-primary mb-3">
                        <i class="fas fa-lock me-2"></i>Data Protection Measures
                    </h2>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="alert alert-light border">
                                <h6 class="fw-bold"><i class="fas fa-desktop text-primary me-2"></i>Electronic Security</h6>
                                <p class="small text-muted mb-0">Secure electronic medical records system with encrypted data storage</p>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="alert alert-light border">
                                <h6 class="fw-bold"><i class="fas fa-user-shield text-success me-2"></i>Access Control</h6>
                                <p class="small text-muted mb-0">Limited access to medical records based on role-based permissions</p>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="alert alert-light border">
                                <h6 class="fw-bold"><i class="fas fa-file-contract text-info me-2"></i>Confidentiality Agreements</h6>
                                <p class="small text-muted mb-0">All staff sign confidentiality agreements for patient data protection</p>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="alert alert-light border">
                                <h6 class="fw-bold"><i class="fas fa-backup text-warning me-2"></i>Regular Backups</h6>
                                <p class="small text-muted mb-0">Regular backup of medical data with secure off-site storage</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Patient Rights -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h2 class="h4 fw-bold text-primary mb-3">
                        <i class="fas fa-user-check me-2"></i>Patient Rights
                    </h2>

                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>Right</th>
                                    <th>Description</th>
                                    <th>How to Exercise</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>Access</strong></td>
                                    <td>View your medical records</td>
                                    <td>Request at reception with ID proof</td>
                                </tr>
                                <tr>
                                    <td><strong>Correction</strong></td>
                                    <td>Correct inaccurate information</td>
                                    <td>Submit written request to update</td>
                                </tr>
                                <tr>
                                    <td><strong>Confidentiality</strong></td>
                                    <td>Privacy of medical information</td>
                                    <td>Automatic for all patients</td>
                                </tr>
                                <tr>
                                    <td><strong>Consent</strong></td>
                                    <td>Consent for data sharing</td>
                                    <td>Provide written consent when needed</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Data Retention -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h2 class="h4 fw-bold text-primary mb-3">
                        <i class="fas fa-database me-2"></i>Data Retention Period
                    </h2>

                    <div class="row text-center">
                        <div class="col-md-4 mb-3">
                            <div class="border rounded p-3">
                                <i class="fas fa-file-medical fa-2x text-primary mb-2"></i>
                                <h6 class="fw-bold">Medical Records</h6>
                                <p class="small text-muted mb-0">Minimum 5 years<br><small>As per healthcare regulations</small></p>
                            </div>
                        </div>

                        <div class="col-md-4 mb-3">
                            <div class="border rounded p-3">
                                <i class="fas fa-receipt fa-2x text-success mb-2"></i>
                                <h6 class="fw-bold">Financial Records</h6>
                                <p class="small text-muted mb-0">7 years<br><small>For audit and tax purposes</small></p>
                            </div>
                        </div>

                        <div class="col-md-4 mb-3">
                            <div class="border rounded p-3">
                                <i class="fas fa-archive fa-2x text-info mb-2"></i>
                                <h6 class="fw-bold">Critical Records</h6>
                                <p class="small text-muted mb-0">Indefinite<br><small>For patient care continuity</small></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contact Information -->
            <div class="card border-primary border-2">
                <div class="card-body p-4">
                    <h2 class="h4 fw-bold text-primary mb-3">
                        <i class="fas fa-headset me-2"></i>Contact for Privacy Concerns
                    </h2>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="d-flex align-items-start">
                                <i class="fas fa-clinic-medical text-primary mt-1 me-3"></i>
                                <div>
                                    <h6 class="fw-bold">Sunrise Clinic & Diagnostic Center</h6>
                                    <p class="small text-muted mb-1">TB Clinic Gate, Shalgaria</p>
                                    <p class="small text-muted mb-1">Pabna Sadar, Pabna, Bangladesh</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <div class="d-flex align-items-start">
                                <i class="fas fa-phone text-success mt-1 me-3"></i>
                                <div>
                                    <h6 class="fw-bold">Contact Number</h6>
                                    <p class="small text-muted mb-1">
                                        <a href="tel:+8801703452323" class="text-decoration-none">+880 1703 452323</a>
                                    </p>
                                    <p class="small text-muted mb-1">Emergency: 24/7 Available</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <div class="d-flex align-items-start">
                                <i class="fas fa-envelope text-warning mt-1 me-3"></i>
                                <div>
                                    <h6 class="fw-bold">Email Address</h6>
                                    <p class="small text-muted mb-1">
                                        <a href="mailto:info@sunriseclinicbd.com" class="text-decoration-none">info@sunriseclinicbd.com</a>
                                    </p>
                                    <p class="small text-muted mb-1">For privacy concerns</p>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <div class="d-flex align-items-start">
                                <i class="fas fa-clock text-info mt-1 me-3"></i>
                                <div>
                                    <h6 class="fw-bold">Business Hours</h6>
                                    <p class="small text-muted mb-1">8:00 AM - 10:00 PM (Daily)</p>
                                    <p class="small text-muted mb-1">Emergency: 24/7</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info mt-3">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        <strong>Note:</strong> This privacy policy may be updated periodically. Please check this page for the latest version. Last updated on @DateTime.Now.ToString("dd MMMM, yyyy").
                    </div>
                </div>
            </div>

            <!-- Quick Links -->
            <div class="text-center mt-5">
                <p class="text-muted mb-3">Related Pages:</p>
                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <a href="/" class="btn btn-sm btn-outline-primary" aria-label="Sunrise Clinic Home">Home</a>
                    <a href="/Home/Contact" class="btn btn-sm btn-outline-primary" aria-label="Contact Sunrise Clinic">Contact Us</a>
                    <a href="/Home/Diagnostic" class="btn btn-sm btn-outline-primary" aria-label="Diagnostic Services">Services</a>
                    <a href="/Home/Checkup" class="btn btn-sm btn-outline-primary" aria-label="Health Checkup">Checkup Packages</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const privacySection = document.getElementById('privacyPolicy');
            if (privacySection) {
                privacySection.classList.add('scroll-target');
                privacySection.scrollIntoView({ behavior: 'smooth' });
            }

            // SEO: Track privacy policy views
            console.log('SEO: Privacy Policy Page Loaded - Sunrise Clinic Pabna');

            // Track contact link clicks
            document.querySelectorAll('a[href^="tel:"], a[href^="mailto:"]').forEach(contactLink => {
                contactLink.addEventListener('click', function() {
                    console.log('SEO: Privacy contact clicked:', this.textContent.trim());
                });
            });
        });
    </script>
}