<div class="container py-3" id="contactUs" itemscope itemtype="https://schema.org/ContactPage">
    <div class="row mb-5">
        <div class="col-lg-6">
            <h1 class="fw-bold mb-4" itemprop="headline">Contact Sunrise Clinic & Diagnostic Center Pabna</h1>
            <p class="lead" itemprop="description">Get in touch with us for appointments, inquiries, or emergency services at our medical clinic in Pabna, Bangladesh.</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100" itemprop="address" itemscope itemtype="https://schema.org/PostalAddress">
                <div class="card-body p-4">
                    <i class="fas fa-map-marker-alt fa-2x text-primary mb-3" aria-hidden="true"></i>
                    <h5 class="card-title">Our Location in Pabna</h5>
                    <p class="card-text">
                        <span itemprop="streetAddress">TB Clinic Gate, Shalgaria</span>,
                        <span itemprop="addressLocality">Pabna Sadar</span><br>
                        <span itemprop="addressRegion">Pabna</span>,
                        <span itemprop="addressCountry">Bangladesh</span>
                        <meta itemprop="postalCode" content="6600">
                    </p>
                    <div class="mt-3">
                        <a href="https://maps.google.com/?q=24.0064,89.2372" target="_blank"
                           class="btn btn-sm btn-outline-primary"
                           aria-label="View Sunrise Clinic location on Google Maps">
                            <i class="fas fa-directions me-1"></i> Get Directions
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body p-4">
                    <i class="fas fa-phone fa-2x text-success mb-3" aria-hidden="true"></i>
                    <h5 class="card-title">Contact Numbers</h5>
                    <p class="card-text">
                        <strong>Appointments:</strong>
                        <a href="tel:+8801733976442" itemprop="telephone" class="text-decoration-none">
                            +880 1733 976442
                        </a><br>
                        <strong>Emergency (24/7):</strong>
                        <a href="tel:+8801703452323" itemprop="telephone" class="text-decoration-none fw-bold">
                            +880 1703 452323
                        </a><br>
                        <small class="text-muted">Call for ambulance, emergency care, or urgent medical needs</small>
                    </p>
                    <div class="mt-3">
                        <a href="tel:+8801703452323" class="btn btn-sm btn-success"
                           aria-label="Call Sunrise Clinic Emergency Number">
                            <i class="fas fa-phone me-1"></i> Call Emergency
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body p-4">
                    <i class="fas fa-envelope fa-2x text-warning mb-3" aria-hidden="true"></i>
                    <h5 class="card-title">Email Address</h5>
                    <p class="card-text" itemprop="email">
                        <strong>General Inquiries:</strong>
                        <a href="mailto:info@sunriseclinicbd.com" class="text-decoration-none">
                            info@sunriseclinicbd.com
                        </a><br>
                        <strong>Appointments:</strong>
                        <a href="mailto:appointments@sunriseclinicbd.com" class="text-decoration-none">
                            appointments@sunriseclinicbd.com
                        </a><br>
                        <small class="text-muted">We respond within 24 hours</small>
