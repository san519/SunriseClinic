                                    <i class="fas fa-phone-volume text-danger me-2" aria-hidden="true"></i>
                                    <strong>Emergency Contact:</strong> +880 1703 452323
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Contact Form -->
    <div class="row mt-5">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body p-4">
                    <h3 class="card-title mb-4">
                        <i class="fas fa-comment-medical text-primary me-2" aria-hidden="true"></i>
                        Quick Contact Form
                    </h3>
                    <form id="quickContactForm">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="name" class="form-label">Your Name *</label>
                                <input type="text" class="form-control" id="name" required
                                       placeholder="Enter your full name" aria-label="Your Name">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="phone" class="form-label">Phone Number *</label>
                                <input type="tel" class="form-control" id="phone" required
                                       placeholder="+8801712345678" aria-label="Phone Number">
                            </div>
                            <div class="col-md-12 mb-3">
                                <label for="message" class="form-label">Message *</label>
                                <textarea class="form-control" id="message" rows="3" required
                                          placeholder="How can we help you?" aria-label="Your Message"></textarea>
                            </div>
                            <div class="col-md-12">
                                <button type="submit" class="btn btn-primary px-4"
                                        aria-label="Submit contact form">
                                    <i class="fas fa-paper-plane me-2" aria-hidden="true"></i> Send Message
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Social Media Links -->
    <div class="row mt-4">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body p-4 text-center">
                    <h5 class="card-title mb-3">Connect With Us</h5>
                    <div class="d-flex justify-content-center gap-3">
                        <a href="https://facebook.com/sunriseclinicbd" target="_blank"
                           class="btn btn-outline-info"
                           aria-label="Follow Sunrise Clinic on Facebook">
                            <i class="fab fa-facebook-f me-2" aria-hidden="true"></i> Facebook
                        </a>
                        <a href="https://wa.me/+8801733976442" target="_blank"
                           class="btn btn-outline-success"
                           aria-label="Chat with Sunrise Clinic on WhatsApp">
                            <i class="fab fa-whatsapp me-2" aria-hidden="true"></i> WhatsApp
                        </a>
                        <a href="https://twitter.com/sunriseclinicbd" target="_blank"
                           class="btn btn-outline-dark"
                           aria-label="Follow Sunrise Clinic on Twitter">
                            <i class="fab fa-twitter me-2" aria-hidden="true"></i> Twitter
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Scroll to main on page load
        document.addEventListener('DOMContentLoaded', function() {
            const scrolltomain = document.getElementById('contactUs');
            if (scrolltomain) {
                scrolltomain.classList.add('scroll-target');
                scrolltomain.scrollIntoView({ behavior: 'smooth' });
            }

            // SEO: Track contact interactions
            console.log('Contact page loaded - Sunrise Clinic Pabna');

            // Track phone clicks
            document.querySelectorAll('a[href^="tel:"]').forEach(phoneLink => {
                phoneLink.addEventListener('click', function() {
                    const phoneNumber = this.textContent.trim();
                    console.log('SEO: Phone call initiated to:', phoneNumber);

                    // Google Analytics event tracking
                    if (typeof gtag !== 'undefined') {
                        gtag('event', 'phone_click', {
                            'event_category': 'Contact',
                            'event_label': phoneNumber,
                            'value': 1
                        });
                    }
                });
            });

            // Track email clicks
            document.querySelectorAll('a[href^="mailto:"]').forEach(emailLink => {
                emailLink.addEventListener('click', function() {
                    const emailAddress = this.textContent.trim();
                    console.log('SEO: Email clicked:', emailAddress);
                });
            });

            // Track social media clicks
            document.querySelectorAll('a[target="_blank"]').forEach(socialLink => {
                socialLink.addEventListener('click', function() {
                    const platform = this.querySelector('i').className.match(/fa-(\w+)/)[1];
                    console.log('SEO: Social media click:', platform);
                });
            });

            // Quick contact form submission
            const quickContactForm = document.getElementById('quickContactForm');
            if (quickContactForm) {
                quickContactForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    console.log('SEO: Quick contact form submitted');
                    alert('Thank you for contacting Sunrise Clinic. We will get back to you soon.');
                    this.reset();
                });
            }

            // Add structured data for directions
            const directionsBtn = document.querySelector('[aria-label*="Directions"]');
            if (directionsBtn) {
                directionsBtn.addEventListener('click', function() {
                    console.log('SEO: Get directions clicked - Sunrise Clinic Pabna');
                });
            }
        });
    </script>
}