@{
    ViewData["Title"] = "Ambulance Service | Sunrise Clinic";
    ViewData["ActivePage"] = "Ambulance";
}

<!-- Hero Section -->
<section class="hero-section-a py-5" id="ambulance">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8 text-dark">
                <h1 class="display-4 fw-bold mb-4">Ambulance Service</h1>
                <p class="lead mb-4">24/7 Emergency Ambulance Service for Pabna District</p>
                <div class="d-flex flex-wrap gap-3">
                    <a href="tel:+8801703452323" class="btn btn-danger btn-lg px-4 py-3">
                        <i class="fas fa-phone-alt me-2"></i>Call Ambulance Now: +880 1703 452323
                    </a>
                    <a href="#ambulance-types" class="btn btn-outline-danger btn-lg px-4 py-3">
                        <i class="fas fa-ambulance me-2"></i>View Ambulance Types
                    </a>
                </div>
                <div class="mt-4">
                    <p class="mb-1"><i class="fas fa-map-marker-alt text-danger me-2"></i><strong>Base Location:</strong> TB Clinic Gate, Shalgaria, Pabna Sadar, Pabna</p>
                    <p class="mb-0"><i class="fas fa-clock text-danger me-2"></i><strong>Service Hours:</strong> 24 Hours, 7 Days a Week</p>
                </div>
            </div>
            <div class="col-lg-4">
                <img src="/img/emergency-care.svg" alt="Ambulance Service" class="img-fluid">
            </div>
        </div>
    </div>
</section>

<!-- Emergency Contact Card -->
<section class="py-5">
    <div class="container">
        <div class="card border-0 shadow-lg bg-danger text-white">
            <div class="card-body p-5">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h2 class="fw-bold mb-3">Need Emergency Ambulance?</h2>
                        <p class="lead mb-2">Immediate response with trained paramedics and basic life support equipment</p>
                        <p class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>For Chest Emergencies: Call Dr. Md. Khalilur Rahman's clinic directly</p>
                    </div>
                    <div class="col-md-4 text-center">
                        <a href="tel:+8801703452323" class="btn btn-light btn-lg px-4 py-3">
                            <i class="fas fa-phone-alt me-2"></i>Emergency Call Now
                        </a>
                        <p class="text-white-50 small mt-2">Available 24/7</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Ambulance Types -->
<section id="ambulance-types" class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold mb-3">Our Ambulance Services</h2>
            <p class="text-muted">Available ambulance options for different medical needs</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card card-hover h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="icon-container bg-danger bg-opacity-10 mx-auto mb-4">
                            <i class="fas fa-ambulance text-danger fa-3x"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Basic Ambulance</h4>
                        <p class="text-muted mb-4">For patient transport with basic emergency equipment.</p>
                        <ul class="list-unstyled text-start">
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Oxygen Supply</li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>First Aid Kit</li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Stretcher & Wheelchair</li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Basic Emergency Medicines</li>
                            <li><i class="fas fa-check text-success me-2"></i>Trained Driver</li>
                        </ul>
                        <div class="mt-4">
                            <span class="badge bg-danger">₹1000 - ₹3000</span>
                            <small class="text-muted d-block mt-1">(Based on distance within Pabna)</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card card-hover h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="icon-container bg-warning bg-opacity-10 mx-auto mb-4">
                            <i class="fas fa-ambulance text-warning fa-3x"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Emergency Ambulance</h4>
                        <p class="text-muted mb-4">For critical patients with medical staff support.</p>
                        <ul class="list-unstyled text-start">
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Oxygen with Mask</li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>IV Fluid Support</li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Emergency Drugs</li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>BP Monitor</li>
                            <li><i class="fas fa-check text-success me-2"></i>Trained Attendant</li>
                        </ul>
                        <div class="mt-4">
                            <span class="badge bg-warning">₹2000 - ₹5000</span>
                            <small class="text-muted d-block mt-1">(With basic medical support)</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card card-hover h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="icon-container bg-success bg-opacity-10 mx-auto mb-4">
                            <i class="fas fa-user-md text-success fa-3x"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Doctor Accompany Ambulance</h4>
                        <p class="text-muted mb-4">Ambulance with doctor for critical emergencies.</p>
                        <ul class="list-unstyled text-start">
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Doctor on board</li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Advanced emergency care</li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Continuous monitoring</li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Emergency treatment en route</li>
                            <li><i class="fas fa-check text-success me-2"></i>Direct hospital coordination</li>
                        </ul>
                        <div class="mt-4">
                            <span class="badge bg-success">₹5000 - ₹10000</span>
                            <small class="text-muted d-block mt-1">(Doctor consultation included)</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Coverage Area -->
<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold mb-3">Service Coverage Area in Pabna</h2>
            <p class="text-muted">We serve Pabna district and nearby areas</p>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <h4 class="fw-bold mb-4 text-danger"><i class="fas fa-map-marker-alt me-2"></i>Pabna Sadar Area</h4>
                        <ul class="list-unstyled">
                            <li class="mb-3"><i class="fas fa-check-circle text-success me-2"></i>TB Clinic Gate, Shalgaria</li>
                            <li class="mb-3"><i class="fas fa-check-circle text-success me-2"></i>Pabna Town</li>
                            <li class="mb-3"><i class="fas fa-check-circle text-success me-2"></i>Medical College Area</li>
                            <li class="mb-3"><i class="fas fa-check-circle text-success me-2"></i>Bus Stand Area</li>
                            <li><i class="fas fa-check-circle text-success me-2"></i>Rail Station Area</li>
                        </ul>
                        <div class="mt-4">
                            <span class="badge bg-danger">Within 1 hour</span>
                            <small class="text-muted d-block mt-1">Response time in Pabna Sadar</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <h4 class="fw-bold mb-4 text-primary"><i class="fas fa-map-marked-alt me-2"></i>Upazila Coverage</h4>
                        <ul class="list-unstyled">
                            <li class="mb-3"><i class="fas fa-check-circle text-primary me-2"></i>Chatmohar Upazila</li>
                            <li class="mb-3"><i class="fas fa-check-circle text-primary me-2"></i>Sujanagar Upazila</li>
                            <li class="mb-3"><i class="fas fa-check-circle text-primary me-2"></i>Ishwardi Upazila</li>
                            <li class="mb-3"><i class="fas fa-check-circle text-primary me-2"></i>Atgharia Upazila</li>
                            <li><i class="fas fa-check-circle text-primary me-2"></i>Bera Upazila</li>
                        </ul>
                        <div class="mt-4">
                            <span class="badge bg-primary">1-2 hours</span>
                            <small class="text-muted d-block mt-1">Response time in upazilas</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Booking Process -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold mb-3">How to Get Ambulance Service</h2>
            <p class="text-muted">Simple steps for emergency ambulance service</p>
        </div>

        <div class="row text-center">
            <div class="col-md-3 mb-4">
                <div class="step-number bg-danger text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                    <i class="fas fa-phone-alt"></i>
                </div>
                <h5 class="fw-bold">Emergency Call</h5>
                <p class="text-muted small">Call +880 1703 452323</p>
            </div>
            <div class="col-md-3 mb-4">
                <div class="step-number bg-warning text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                    <i class="fas fa-info-circle"></i>
                </div>
                <h5 class="fw-bold">Provide Information</h5>
                <p class="text-muted small">Location, patient condition, contact</p>
            </div>
            <div class="col-md-3 mb-4">
                <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                    <i class="fas fa-ambulance"></i>
                </div>
                <h5 class="fw-bold">Ambulance Dispatch</h5>
                <p class="text-muted small">Immediate ambulance sent to location</p>
            </div>
            <div class="col-md-3 mb-4">
                <div class="step-number bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                    <i class="fas fa-hospital"></i>
                </div>
                <h5 class="fw-bold">Reach Hospital</h5>
                <p class="text-muted small">Transport to Sunrise Clinic or other hospital</p>
            </div>
        </div>
    </div>
</section>

<!-- Important Information -->
<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <div class="alert alert-info border-0 shadow-sm">
                    <div class="d-flex">
                        <i class="fas fa-exclamation-triangle fa-2x me-3 text-info"></i>
                        <div>
                            <h5 class="fw-bold mb-2">Important Information</h5>
                            <p class="mb-1">• Ambulance charges vary based on distance and type of service required</p>
                            <p class="mb-1">• For chest emergencies, contact Dr. Md. Khalilur Rahman's clinic directly</p>
                            <p class="mb-1">• Payment can be made at clinic reception after service</p>
                            <p class="mb-0">• Emergency contact available 24 hours</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .hero-section-a {
        background: linear-gradient(135deg, rgba(220, 53, 69, 0.1) 0%, rgba(255, 193, 7, 0.1) 100%);
        padding: 80px 0;
    }

    .step-number {
        font-size: 1.5rem;
        font-weight: bold;
    }

    .card-hover {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1) !important;
        }

    .icon-container {
        width: 100px;
        height: 100px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }

    .badge {
        font-size: 1rem;
        padding: 8px 16px;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const scrolltomain = document.getElementById('ambulance');
            if (scrolltomain) {
                scrolltomain.classList.add('scroll-target');
                scrolltomain.scrollIntoView({ behavior: 'smooth' });
            }
        });
    </script>
}