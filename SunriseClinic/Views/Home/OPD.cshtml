                <div class="card card-hover h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="icon-container bg-primary bg-opacity-10 mx-auto mb-4">
                            <i class="fas fa-lungs text-primary fa-2x"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Chest & TB Diseases</h4>
                        <p class="text-muted mb-3">Consultation with Dr. Md. Khalilur Rahman for respiratory disorders.</p>
                        <ul class="list-unstyled text-start">
                            <li><i class="fas fa-check text-success me-2"></i>Asthma & COPD management</li>
                            <li><i class="fas fa-check text-success me-2"></i>TB diagnosis & treatment</li>
                            <li><i class="fas fa-check text-success me-2"></i>Pneumonia & bronchitis care</li>
                            <li><i class="fas fa-check text-success me-2"></i>30+ years experience</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card card-hover h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="icon-container bg-success bg-opacity-10 mx-auto mb-4">
                            <i class="fas fa-female text-success fa-2x"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Gynecology & Obstetrics</h4>
                        <p class="text-muted mb-3">Women's healthcare by Dr. Farjana Mahjabin (Ovi).</p>
                        <ul class="list-unstyled text-start">
                            <li><i class="fas fa-check text-success me-2"></i>Pregnancy care & delivery</li>
                            <li><i class="fas fa-check text-success me-2"></i>Gynecological surgeries</li>
                            <li><i class="fas fa-check text-success me-2"></i>Family planning & infertility</li>
                            <li><i class="fas fa-check text-success me-2"></i>20+ years surgical experience</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card card-hover h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="icon-container bg-warning bg-opacity-10 mx-auto mb-4">
                            <i class="fas fa-procedures text-warning fa-2x"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Laparoscopic Surgery</h4>
                        <p class="text-muted mb-3">Minimally invasive surgery by Dr. Shamima Khatun Poly.</p>
                        <ul class="list-unstyled text-start">
                            <li><i class="fas fa-check text-success me-2"></i>Laparoscopic procedures</li>
                            <li><i class="fas fa-check text-success me-2"></i>Gynecological surgery</li>
                            <li><i class="fas fa-check text-success me-2"></i>General surgical consultation</li>
                            <li><i class="fas fa-check text-success me-2"></i>FCPS qualified surgeon</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

