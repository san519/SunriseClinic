@{
    ViewData["Title"] = "OPD Services | Sunrise Clinic";
    ViewData["ActivePage"] = "OPD";
}

<!-- Hero Section -->
<section class="hero-section-o py-5" id="opd">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8 text-dark">
                <h1 class="display-4 fw-bold mb-4">OPD Services</h1>
                <p class="lead mb-4">Outpatient Department with Expert Medical Consultation at Sunrise Clinic</p>
                <div class="d-flex flex-wrap gap-3">
                    <a href="/Appointment/Create" class="btn btn-primary btn-lg px-4 py-3">
                        <i class="fas fa-calendar-check me-2"></i>Book OPD Appointment
                    </a>
                    <a href="#schedule" class="btn btn-outline-primary btn-lg px-4 py-3">
                        <i class="fas fa-clock me-2"></i>View OPD Schedule
                    </a>
                </div>
                <div class="mt-4">
                    <p class="mb-1"><i class="fas fa-map-marker-alt text-primary me-2"></i><strong>Location:</strong> TB Clinic Gate, Shalgaria, Pabna Sadar, Pabna</p>
                    <p class="mb-0"><i class="fas fa-phone text-primary me-2"></i><strong>OPD Registration:</strong> +880 1703 452323</p>
                </div>
            </div>
            <div class="col-lg-4">
                <img src="/img/opd-services.svg" alt="OPD Services" class="img-fluid">
            </div>
        </div>
    </div>
</section>

<!-- OPD Services -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
