        </div>
    </div>
</section>

<!-- Diagnostic Services Available -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold mb-3">Diagnostic Services with OPD</h2>
            <p class="text-muted">Get same-day diagnostic tests during your OPD visit</p>
        </div>

        <div class="row g-4">
            <div class="col-md-3">
                <div class="text-center">
                    <div class="icon-container bg-danger bg-opacity-10 mx-auto mb-3">
                        <i class="fas fa-vial text-danger fa-2x"></i>
                    </div>
                    <h6 class="fw-bold">Blood Tests</h6>
                    <p class="text-muted small">CBC, Diabetes, Lipid Profile, etc.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="text-center">
                    <div class="icon-container bg-primary bg-opacity-10 mx-auto mb-3">
                        <i class="fas fa-x-ray text-primary fa-2x"></i>
                    </div>
                    <h6 class="fw-bold">Imaging</h6>
                    <p class="text-muted small">X-Ray, USG, ECG available</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="text-center">
                    <div class="icon-container bg-success bg-opacity-10 mx-auto mb-3">
                        <i class="fas fa-urine text-success fa-2x"></i>
                    </div>
                    <h6 class="fw-bold">Urine Tests</h6>
                    <p class="text-muted small">Complete urine analysis</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="text-center">
                    <div class="icon-container bg-warning bg-opacity-10 mx-auto mb-3">
                        <i class="fas fa-dna text-warning fa-2x"></i>
                    </div>
                    <h6 class="fw-bold">Special Tests</h6>
                    <p class="text-muted small">Hormone, Infection tests</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Appointment Section -->
<section class="py-5 bg-primary text-white">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h2 class="fw-bold mb-3">Need Medical Consultation?</h2>
                <p class="lead mb-2">Book your OPD appointment with our expert doctors</p>
                <p class="mb-0"><i class="fas fa-phone me-2"></i>Call for Appointment: +880 1703 452323</p>
            </div>
            <div class="col-md-4 text-end">
                <a href="/Appointment/Create" class="btn btn-light btn-lg px-4 py-3">
                    <i class="fas fa-calendar-plus me-2"></i>Book OPD Appointment
                </a>
            </div>
        </div>
    </div>
</section>

<!-- OPD Process -->
<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold mb-3">OPD Process</h2>
            <p class="text-muted">Simple steps for your OPD consultation</p>
        </div>

        <div class="row g-4">
            <div class="col-md-3 text-center">
                <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">
                    1
                </div>
                <h5 class="fw-bold">Registration</h5>
                <p class="text-muted small">Register at reception or online</p>
            </div>
            <div class="col-md-3 text-center">
                <div class="step-number bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">
                    2
                </div>
                <h5 class="fw-bold">Consultation</h5>
                <p class="text-muted small">Meet doctor for examination</p>
            </div>
            <div class="col-md-3 text-center">
                <div class="step-number bg-info text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">
                    3
                </div>
                <h5 class="fw-bold">Diagnosis</h5>
                <p class="text-muted small">Tests if needed (same-day)</p>
            </div>
            <div class="col-md-3 text-center">
                <div class="step-number bg-warning text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">
                    4
                </div>
                <h5 class="fw-bold">Treatment</h5>
                <p class="text-muted small">Medicine & follow-up plan</p>
            </div>
        </div>
    </div>
</section>

<style>
    .hero-section-o {
        background: linear-gradient(135deg, rgba(26, 115, 232, 0.1) 0%, rgba(0, 191, 174, 0.1) 100%);
        padding: 80px 0;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(26, 115, 232, 0.05);
    }

    .card-hover {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1) !important;
        }

    .icon-container {
        width: 80px;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }

    .step-number {
        font-size: 1.5rem;
        font-weight: bold;
    }

    .table th {
        font-weight: 600;
        background-color: #1a73e8;
        color: white;
    }

    .table td {
        vertical-align: middle;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const scrolltomain = document.getElementById('opd');
            if (scrolltomain) {
                scrolltomain.classList.add('scroll-target');
                scrolltomain.scrollIntoView({ behavior: 'smooth' });
            }
        });
    </script>
}