<!-- Our Story -->
<section id="our-story" class="py-5" itemscope itemtype="https://schema.org/AboutPage">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <div class="card-hover p-4 rounded-4">
                    <h2 class="mb-4 text-dark">Our Healthcare Journey in Pabna Since 2012</h2>
                    <p class="text-muted mb-3">Founded in 2012 by visionary healthcare professionals, Sunrise Clinic Pabna began as a small community health center with a mission: to provide world-class diagnostic services accessible to all in Pabna.</p>
                    <p class="text-muted mb-3">Over 14+ years, we've expanded to become Pabna's leading diagnostic center, incorporating cutting-edge technology including Digital Color Doppler USG, automated pathology analyzers, and digital X-ray systems.</p>
                    <p class="text-muted mb-4">Today, Sunrise Clinic stands as Pabna's trusted diagnostic partner, offering 60+ medical tests including blood tests from ₹150, USG at ₹1000, and X-ray from ₹500.</p>
                    <a href="/Home/Gallery" class="btn btn-accent" aria-label="View our clinic gallery at Sunrise Clinic Pabna">
                        <i class="fas fa-images me-2"></i> View Our Diagnostic Center
                    </a>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="position-relative">
                    <img src="/img/our-journey.webp"
                         alt="Sunrise Clinic Pabna Modern Diagnostic Facility"
                         title="Sunrise Clinic Diagnostic Center Pabna"
                         class="img-fluid rounded-4 shadow">
                    <div class="position-absolute top-0 end-0 bg-white p-3 rounded-start rounded-bottom-0 shadow-sm">
                        <i class="fas fa-award text-warning fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

