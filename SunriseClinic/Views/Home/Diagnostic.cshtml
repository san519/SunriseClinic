        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }

    .list-group-item {
        border: none;
        padding: 12px 0;
    }
</style>

@section Scripts {
    <script>
        // Scroll to main on page load
        document.addEventListener('DOMContentLoaded', function() {
            const scrolltomain = document.getElementById('diagnostic');
            if (scrolltomain) {
                scrolltomain.classList.add('scroll-target');
                scrolltomain.scrollIntoView({ behavior: 'smooth' });
            }

            // SEO: Track diagnostic page interactions
            console.log('Diagnostic Services page loaded - Sunrise Clinic Pabna');

            // Track test clicks for analytics
            document.querySelectorAll('.list-group-item').forEach(item => {
                item.addEventListener('click', function() {
                    const testName = this.querySelector('span[itemprop="name"]').textContent;
                    const testPrice = this.querySelector('span[itemprop="price"]').textContent;
                    console.log('SEO: Test selected:', testName, 'Price:', testPrice);

                    // Google Analytics event tracking
                    if (typeof gtag !== 'undefined') {
                        gtag('event', 'test_click', {
                            'event_category': 'Diagnostic',
                            'event_label': testName,
                            'value': parseInt(testPrice.replace('₹', ''))
                        });
                    }
                });
            });
        });
    </script>
}