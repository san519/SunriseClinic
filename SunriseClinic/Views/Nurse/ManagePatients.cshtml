@{
    ViewData["Title"] = "Manage Patients";
    var patients = ViewBag.Patients as List<dynamic>;
}

<div id="managePatients">
    @await Html.PartialAsync("_MobileDashboardMenu")

    <div class="container-fluid p-0 pt-2">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-lg-3">
                @await Html.PartialAsync("_NurseSidebar")
            </div>

            <!-- Main Content -->
            <div class="col-lg-9">
                <div class="dashboard-content">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h3 class="mb-1">
                                <i class="fas fa-user-injured me-2 text-primary"></i>Manage Patients
                            </h3>
                            <p class="text-muted mb-0">View and manage all patients</p>
                        </div>
                        <div class="d-flex gap-2">
                            <input type="text" class="form-control form-control-sm"
                                   placeholder="Search patients..." id="searchInput"
                                   style="min-width: 200px;">
                        </div>
                    </div>

                    @if (patients != null && patients.Any())
                    {
                        <div class="card border-0 shadow-sm">
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0" id="patientsTable">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Patient ID</th>
                                                <th>Name</th>
                                                <th>Contact</th>
                                                <th>Blood Group</th>
                                                <th>Registered</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var patient in patients)
                                            {
                                                <tr>
                                                    <td class="fw-semibold">@patient.DisplayId</td>
                                                    <td>
                                                        <div class="fw-semibold">@patient.FullName</div>
                                                        <small class="text-muted">@patient.Email</small>
                                                    </td>
                                                    <td>@patient.PhoneNumber</td>
                                                    <td>
                                                        <span class="badge bg-light text-dark">@patient.BloodGroup</span>
                                                    </td>
                                                    <td>@patient.CreatedAt.ToString("dd-MMM-yyyy")</td>
                                                    <td>
                                                        <div class="d-flex gap-1">
                                                            <a href="/Nurse/PatientDetails/@patient.UserId"
                                                               class="btn btn-sm btn-outline-primary">
                                                                <i class="fas fa-eye"></i>
                                                            </a>
                                                            <a href="/Nurse/UploadPrescription/@patient.UserId"
                                                               class="btn btn-sm btn-outline-success" title="Upload Prescription">
                                                                <i class="fas fa-prescription"></i>
                                                            </a>
                                                            <a href="/Nurse/UploadTestReport/@patient.UserId"
                                                               class="btn btn-sm btn-outline-info" title="Upload Test Report">
                                                                <i class="fas fa-file-medical"></i>
                                                            </a>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="card border-0 shadow-sm">
                            <div class="card-body text-center py-5">
                                <i class="fas fa-user-injured fa-3x text-muted mb-3"></i>
                                <h5 class="text-muted mb-2">No patients found</h5>
                                <p class="text-muted small mb-4">
                                    No patients are currently registered in the system.
                                </p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .dashboard-content {
        padding: 0 15px;
    }

    .card {
        border-radius: 10px;
    }

    @@media (max-width: 992px) {
        .col-lg-3 {
            display: none;
        }

        .col-lg-9 {
            width: 100%;
        }

        .dashboard-content {
            padding: 0 10px;
        }
    }

    @@media (max-width: 768px) {
        .d-flex.justify-content-between {
            flex-direction: column;
            align-items: flex-start !important;
            gap: 15px;
        }

        #searchInput {
            min-width: 100% !important;
        }
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Search functionality
            const searchInput = document.getElementById('searchInput');
            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    const searchTerm = this.value.toLowerCase();
                    const rows = document.querySelectorAll('#patientsTable tbody tr');

                    rows.forEach(row => {
                        const text = row.textContent.toLowerCase();
                        row.style.display = text.includes(searchTerm) ? '' : 'none';
                    });
                });
            }

            const scrolltomain = document.getElementById('managePatients');
            if (scrolltomain) {
                scrolltomain.classList.add('scroll-target');
                scrolltomain.scrollIntoView({ behavior: 'smooth' });
            }
        });
    </script>
}