@{
    ViewData["Title"] = "Prescriptions";
    var prescriptions = ViewBag.Prescriptions as List<dynamic>;
}

<div class="container-fluid py-3" id="prescription">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-lg-3">@await Html.PartialAsync("_PatientSidebar")</div>

        <!-- Main Content -->
        <div class="col-lg-9">
            <!-- Page Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h4 class="mb-1">
                        <i class="fas fa-prescription text-primary me-2"></i>
                        My Prescriptions
                    </h4>
                    <p class="text-muted mb-0">View and download all your prescriptions</p>
                </div>
                <span class="badge bg-primary rounded-pill fs-6 px-3 py-2">
                    @(prescriptions?.Count ?? 0)
                </span>
            </div>

            @if (prescriptions != null && prescriptions.Any())
            {
                <div class="row g-4">
                    @foreach (var pres in prescriptions)
                    {
                        var fileName = pres.PrescriptionFile as string;
                        var fileExtension = !string.IsNullOrEmpty(fileName) ?
                        System.IO.Path.GetExtension(fileName).ToLower() : "";

                        var isImage = fileExtension == ".jpg" || fileExtension == ".jpeg" ||
                        fileExtension == ".png" || fileExtension == ".gif";
                        var isPdf = fileExtension == ".pdf";

                        <div class="col-md-6 col-xl-4">
                            <div class="card border shadow-sm h-100">
                                <div class="card-body">
                                    <!-- File Preview -->
                                    <div class="text-center mb-3">
                                        @if (isImage)
                                        {
                                            <img src="~/uploads/prescriptions/@pres.PrescriptionFile"
                                                 class="img-fluid rounded cursor-pointer"
                                                 style="height: 180px; object-fit: contain;"
                                                 onclick="openFullscreen('@pres.PrescriptionId')"
                                                 alt="Prescription">
                                        }
                                        else if (isPdf)
                                        {
                                            <div class="text-center py-4 bg-light rounded">
                                                <i class="fas fa-file-pdf fa-4x text-danger mb-3"></i>
                                                <p class="small text-muted">PDF Document</p>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-center py-4 bg-light rounded">
                                                <i class="fas fa-file-word fa-4x text-primary mb-3"></i>
                                                <p class="small text-muted">Document</p>
                                            </div>
                                        }
                                    </div>

                                    <!-- Prescription Info -->
                                    <div class="mb-3">
                                        <div class="d-flex align-items-center mb-2">
                                            <i class="fas fa-user-md text-primary me-2"></i>
                                            <strong class="text-truncate">@pres.PrescribedByName</strong>
                                        </div>

                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="text-muted small">
                                                <i class="fas fa-calendar me-1"></i>
                                                @pres.PrescriptionDate
                                            </span>
                                            @if (pres.IsUploadedByNurse)
                                            {
                                                <span class="badge bg-info">Nurse</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Doctor</span>
                                            }
                                        </div>

                                        @if (!string.IsNullOrEmpty(pres.Notes as string))
                                        {
                                            <div class="small text-muted mb-2">
                                                <i class="fas fa-sticky-note me-1"></i>
                                                @pres.Notes
                                            </div>
                                        }
                                    </div>

                                    <!-- Action Buttons -->
                                    <div class="d-grid gap-2">
                                        <a href="/Patient/DownloadPrescription/@pres.PrescriptionId"
                                           class="btn btn-primary">
                                            <i class="fas fa-download me-2"></i>Download
                                        </a>
                                        @if (!isImage)
                                        {
                                            <button class="btn btn-outline-secondary"
                                                    onclick="viewModal('@pres.PrescriptionId', '@pres.PrescriptionFile', '@(isPdf ? "pdf" : "doc")')">
                                                <i class="fas fa-eye me-2"></i>Preview
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Empty State -->
                <div class="text-center py-5">
                    <div class="card border shadow-sm">
                        <div class="card-body py-5">
                            <i class="fas fa-prescription fa-4x text-muted mb-4"></i>
                            <h4 class="text-muted mb-3">No prescriptions yet</h4>
                            <p class="text-muted mb-4">
                                You don't have any prescriptions at the moment.<br>
                                Prescriptions will appear here after your appointments.
                            </p>
                            <div class="d-flex justify-content-center gap-3">
                                <a href="/Appointment/Create" class="btn btn-primary">
                                    <i class="fas fa-calendar-plus me-2"></i>Book Appointment
                                </a>
                                <a href="/Patient/Dashboard" class="btn btn-outline-primary">
                                    <i class="fas fa-home me-2"></i>Dashboard
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Bootstrap Modal for PDF/DOC -->
<div class="modal fade" id="fileModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="fas fa-file me-2"></i>Prescription Preview
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0" id="modalContent">
                <!-- Content will load here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Close
                </button>
                <a href="#" id="downloadBtn" class="btn btn-success">
                    <i class="fas fa-download me-2"></i>Download
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap Modal for Fullscreen Image -->
<div class="modal fade" id="imageModal" tabindex="-1">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content bg-dark">
            <div class="modal-header border-0">
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body d-flex align-items-center justify-content-center">
                <img id="fullImage" src="" class="img-fluid" style="max-height: 90vh; object-fit: contain;">
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Open image in fullscreen modal
    function openFullscreen(prescriptionId) {
        const modal = new bootstrap.Modal(document.getElementById('imageModal'));
        const imageElement = document.getElementById('fullImage');

        // Find the image source
        const img = event.target;
        imageElement.src = img.src;

        modal.show();
    }

    // Open PDF/DOC in modal
    function viewModal(prescriptionId, fileName, type) {
        const modal = new bootstrap.Modal(document.getElementById('fileModal'));
        const content = document.getElementById('modalContent');
        const downloadBtn = document.getElementById('downloadBtn');

        // Set download link
        downloadBtn.href = `/Patient/DownloadPrescription/${prescriptionId}`;

        // Clear previous content
        content.innerHTML = '';

        if (type === 'pdf') {
            content.innerHTML = `
                <iframe src="/uploads/prescriptions/${fileName}"
                        class="w-100"
                        height="600"
                        style="border: none;">
                </iframe>
            `;
        }
        else {
            content.innerHTML = `
                <div class="text-center py-5">
                    <i class="fas fa-file-word fa-5x text-primary mb-4"></i>
                    <h4>${fileName}</h4>
                    <p class="text-muted">This file cannot be previewed in browser</p>
                    <p class="text-muted small">Please download the file to view it</p>
                </div>
            `;
        }

        modal.show();
    }

    // Keyboard shortcuts for modals
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            const modals = document.querySelectorAll('.modal.show');
            if (modals.length > 0) {
                bootstrap.Modal.getInstance(modals[0]).hide();
            }
        }
    });

    // Add hover effect to cards
    document.addEventListener('DOMContentLoaded', function() {
        const cards = document.querySelectorAll('.card');
        cards.forEach(card => {
            card.addEventListener('mouseenter', function() {
                this.classList.add('shadow-lg');
            });
            card.addEventListener('mouseleave', function() {
                this.classList.remove('shadow-lg');
            });
        });
    });
                    // Scroll to Main on page load
    document.addEventListener('DOMContentLoaded', function() {
        const scrolltomain = document.getElementById('prescription');
        if (scrolltomain) {
            scrolltomain.classList.add('scroll-target');
            scrolltomain.scrollIntoView({ behavior: 'smooth' });
        }
    });
</script>
}