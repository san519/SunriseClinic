        .hover-shadow:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.15) !important;
        }

    .stat-item h3 {
        font-weight: 700;
    }

    .btn-accent {
        background-color: #00bfae;
        border-color: #00bfae;
        color: white;
    }

        .btn-accent:hover {
            background-color: #00a895;
            border-color: #00a895;
        }
</style>

@section Scripts {
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "FAQPage",
          "mainEntity": [
            {
              "@@type": "Question",
              "name": "Which medical departments are available at Sunrise Clinic Pabna?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Sunrise Clinic Pabna has @departmentCount specialized departments including Cardiology, Neurology, Pediatrics, Gynecology, Orthopedics, Diagnostic Center, Emergency Medicine, and General Medicine departments."
              }
            },
            {
              "@@type": "Question",
              "name": "How to choose the right department for my medical condition?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Call our reception at +8801703452323 for guidance or visit our General Medicine department first. Our doctors will refer you to the appropriate specialist department if needed."
              }
            },
            {
              "@@type": "Question",
              "name": "Are diagnostic services available in all departments?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Yes, all clinical departments have access to our advanced Diagnostic Center which includes Pathology Lab, Radiology, USG, X-Ray, and ECG services for comprehensive testing."
              }
            }
          ]
        }
    </script>

    <script>
        // Scroll to Main on page load
        document.addEventListener('DOMContentLoaded', function() {
            const scrolltomain = document.getElementById('departmentIndex');
            if (scrolltomain) {
                scrolltomain.classList.add('scroll-target');
                scrolltomain.scrollIntoView({ behavior: 'smooth' });
            }

            // Track department views for SEO
            document.querySelectorAll('.card .btn-outline-primary').forEach(link => {
                link.addEventListener('click', function() {
                    const deptName = this.closest('.card').querySelector('.card-title').textContent;
                    console.log('SEO: Department viewed:', deptName);
                    // Add Google Analytics tracking here
                });
            });
        });
    </script>
}