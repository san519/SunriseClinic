@model SunriseClinic.Models.LoginViewModel

@{
    ViewData["Title"] = "Patient Login | Sunrise Clinic & Diagnostic Center Patient Portal";
    ViewData["Description"] = "Login to Sunrise Clinic Patient Portal to book appointments, view medical reports, manage health records, and access diagnostic services in Pabna.";
    ViewData["Keywords"] = "sunrise clinic login, patient portal, medical login, healthcare portal, diagnostic center login, patient account";
    ViewData["Canonical"] = "https://www.sunriseclinicbd.com/Account/Login";
    ViewData["Robots"] = "noindex"; // Login pages usually should be noindex
    ViewData["PageType"] = "LoginPage";

    // Fix: Directly check ViewBag without variable assignment
}

<!-- FAQ Schema for Login Page (Featured Snippet পেতে) -->
<script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "FAQPage",
      "mainEntity": [
        {
          "@@type": "Question",
          "name": "How to login to Sunrise Clinic patient portal?",
          "acceptedAnswer": {
            "@@type": "Answer",
            "text": "Visit https://www.sunriseclinicbd.com/Account/Login and enter your registered email/username and password to access your patient account at Sunrise Clinic Pabna."
          }
        },
        {
          "@@type": "Question",
          "name": "What can I do after logging into Sunrise Clinic portal?",
          "acceptedAnswer": {
            "@@type": "Answer",
            "text": "After login, you can book appointments, view medical reports, access diagnostic test results, update profile, and manage your healthcare services at Sunrise Clinic."
          }
        },
        {
          "@@type": "Question",
          "name": "I forgot my Sunrise Clinic login password. What should I do?",
          "acceptedAnswer": {
            "@@type": "Answer",
            "text": "Click on 'Forgot Password?' link on login page or visit https://www.sunriseclinicbd.com/Account/ForgotPassword to reset your password for Sunrise Clinic patient portal."
          }
        },
        {
          "@@type": "Question",
          "name": "How to create a new patient account at Sunrise Clinic?",
          "acceptedAnswer": {
            "@@type": "Answer",
            "text": "Click 'Create Patient Account' button on login page or visit https://www.sunriseclinicbd.com/Account/Register to register as new patient at Sunrise Clinic Diagnostic Center Pabna."
          }
        }
      ]
    }
</script>

<!-- Medical WebPage Schema -->
<script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "WebPage",
      "name": "Patient Login - Sunrise Clinic & Diagnostic Center",
      "description": "Secure patient login portal for Sunrise Clinic healthcare services",
      "url": "https://www.sunriseclinicbd.com/Account/Login",
      "isPartOf": {
        "@@type": "WebSite",
        "name": "Sunrise Clinic & Diagnostic Center",
        "url": "https://www.sunriseclinicbd.com"
      },
      "about": {
        "@@type": "MedicalClinic",
        "name": "Sunrise Clinic & Diagnostic Center"
      },
      "breadcrumb": {
        "@@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://www.sunriseclinicbd.com/"
          },
          {
            "@@type": "ListItem",
