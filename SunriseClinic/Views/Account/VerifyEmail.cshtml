@model SunriseClinic.Models.RegisterWithVerificationModel

@{
    ViewData["Title"] = "Verify Email";
}

<div id="verifyForm" class="container py-3">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-light py-4">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-shield-alt fa-2x me-3"></i>
                        <div>
                            <h2 class="h4 mb-0">Verify Your Email</h2>
                            <p class="mb-0 opacity-75">Complete your registration</p>
                        </div>
                    </div>
                </div>
                <div class="card-body p-5">
                    <!-- ✅ শুধুমাত্র ViewBag থেকে মেসেজ শো করবেন (TempData থেকে না) -->
                    @if (!string.IsNullOrEmpty(ViewBag.SuccessMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert" id="successAlert">
                            <i class="fas fa-check-circle me-2"></i>@ViewBag.SuccessMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert" id="errorAlert">
                            <i class="fas fa-exclamation-circle me-2"></i>@ViewBag.ErrorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- Main Form -->
                    <form asp-action="VerifyEmail" method="post" class="needs-validation" novalidate id="verifyForm">
                        @Html.AntiForgeryToken()

                        <!-- Hidden fields -->
                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="FullName" />
                        <input type="hidden" asp-for="DateOfBirth" />
                        <input type="hidden" asp-for="Gender" />
                        <input type="hidden" asp-for="PhoneNumber" />
                        <input type="hidden" asp-for="Address" />
                        <input type="hidden" asp-for="BloodGroup" />
                        <input type="hidden" asp-for="EmergencyContact" />
                        <input type="hidden" asp-for="Password" />
                        <input type="hidden" asp-for="ConfirmPassword" />

                        <div class="mb-4">
                            <label asp-for="VerificationCode" class="form-label fw-semibold">
                                <i class="fas fa-shield-alt me-2"></i>Verification Code *
                            </label>

                            <div class="input-group">
                                <input asp-for="VerificationCode"
                                       class="form-control form-control-lg text-center"
                                       placeholder="Enter 6-digit code" required maxlength="6"
                                       style="letter-spacing: 2px; font-size: 14px;">
                                <button type="submit" class="btn btn-success btn-lg h-100 d-flex align-items-center justify-content-center">
                                    <i class="fas fa-check me-1"></i>
                                    <span class="d-none d-sm-inline">Verify & Register</span>
                                    <span class="d-inline d-sm-none">Verify</span>
                                </button>
                            </div>

                            <span asp-validation-for="VerificationCode" class="text-danger small"></span>

                            <!-- Resend Code Link -->
                            <div class="text-end mt-0">
                                <small>
                                    <button type="button" class="btn btn-link p-0 text-decoration-none"
                                            style="font-size: 0.875rem;" id="resendButton">
                                        <i class="fas fa-redo me-1"></i>Resend Code
                                    </button>
                                </small>
                            </div>
                        </div>
                    </form>

                    <!-- Hidden form for resend -->
                    <form asp-action="ResendRegisterCode" method="post" id="resendForm" style="display: none;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="email" value="@Model.Email" />
                    </form>

                    <div class="mt-4 pt-3 border-top">
                        <p class="text-muted small mb-0">
                            <i class="fas fa-info-circle me-1"></i>
                            Hello: <strong>@Model.FullName</strong>
                        </p>
                        <p class="text-muted small mb-0">
                            <i class="fas fa-envelope me-1"></i>
                            Email: <strong>@Model.Email</strong>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Auto-focus on code input
            const codeInput = document.getElementById('VerificationCode');
            if (codeInput) {
                codeInput.focus();
            }

            // Handle resend button click
            const resendButton = document.getElementById('resendButton');
            const resendForm = document.getElementById('resendForm');

            if (resendButton && resendForm) {
                resendButton.addEventListener('click', function() {
                    // Disable button and show loading
                    resendButton.disabled = true;
                    const originalText = resendButton.innerHTML;
                    resendButton.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Sending...';

                    // Submit the resend form
                    resendForm.submit();
                });
            }

            // Auto-hide alerts after 5 seconds
            setTimeout(function() {
                const alerts = document.querySelectorAll('.alert');
                alerts.forEach(function(alert) {
                    const bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);
        });
    </script>
}