@model SunriseClinic.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    bool codeVerified = ViewBag.CodeVerified ?? false;
    string email = ViewBag.Email ?? Model.Email;
    bool showSuccessOnPage = ViewBag.ShowSuccessOnPage ?? false;
    string successMessage = ViewBag.SuccessMessage;
    int countdownSeconds = ViewBag.CountdownSeconds ?? 3;
}

<div id="resetForm" class="container py-3">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-light py-4">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-lock fa-2x me-3"></i>
                        <div>
                            <h2 class="h4 mb-0">Reset Password</h2>
                            <p class="mb-0 opacity-75">Verify code and set new password</p>
                        </div>
                    </div>
                </div>
                <div class="card-body p-5">
                    <!-- ✅ Alert Messages (Fixed) -->
                    <div class="card-body p-3">
    <!-- ✅ Success Message on Page (for password reset success) -->
    @if (showSuccessOnPage && !string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" id="successAlertOnPage">
            <div class="d-flex align-items-center">
                <i class="fas fa-check-circle fa-lg me-3"></i>
                <div>
                    <strong>Success!</strong> @successMessage 
                    <div class="mt-2 small">
                        <i class="fas fa-clock me-1"></i>
                        Redirecting to login page in <span id="countdown">@countdownSeconds</span> seconds...
                    </div>
                </div>
            </div>
        </div>
        
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                let seconds = @countdownSeconds;
                const countdownElement = document.getElementById('countdown');
                const email = '@email';
                
                // Hide the form when success shows
                const forms = document.querySelectorAll('form');
                forms.forEach(form => {
                    form.style.display = 'none';
                });
                
                // Update countdown every second
                const countdownInterval = setInterval(function() {
                    seconds--;
                    if (countdownElement) {
                        countdownElement.textContent = seconds;
                    }
                    
                    if (seconds <= 0) {
                        clearInterval(countdownInterval);
                        // Redirect to login page
                        window.location.href = '/Account/Login';
                    }
                }, 1000);
                
                // Auto-scroll to success message
                const alertElement = document.getElementById('successAlertOnPage');
                if (alertElement) {
                    alertElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            });
        </script>
        
        { return; }
    }


                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show mb-4" id="successAlert">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-check-circle fa-lg me-3"></i>
                                <div class="container-fluid">
                                    <strong>Success!</strong> @TempData["SuccessMessage"]
                                </div>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-2" id="errorAlert">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-exclamation-circle fa-lg me-3"></i>
                                    <div class="container-fluid">
                                    <strong>Error!</strong> @TempData["ErrorMessage"]
                                </div>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    </div>

                    @if (!codeVerified)
                    {

                        <!-- Verify Code Form -->
                        <form asp-action="VerifyCode" method="post" class="needs-validation mb-4" novalidate>
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="Email" value="@email" />

                            <div class="mb-2">
                                <label class="form-label fw-semibold">
                                    <i class="fas fa-shield-alt me-2"></i>Verification Code *
                                </label>

                                <div class="input-group input-group-lg mb-3">
                                    <input type="text"
                                           name="ResetCode"
                                           id="resetCodeInput"
                                           class="form-control form-control-lg text-center"
                                           placeholder="Enter 6-digit code"
                                           required
                                           maxlength="6"
                                           pattern="\d{6}"
                                           title="Please enter exactly 6 digits"
                                           style="letter-spacing: 2px; font-size: 14px;">
                                    <button type="submit" class="btn btn-primary btn-lg" id="verifyBtn">
                                        <i class="fas fa-check me-1"></i>Verify
                                    </button>
                                </div>

                                <div class="text-end mt-3">
                                    <a href="#" onclick="return resendCode('@email')"
                                       class="text-decoration-none text-primary"
                                       style="font-size: 0.875rem;"
                                       id="resendLink">
                                        <i class="fas fa-redo me-1"></i>
                                        <span id="resendText">Resend Code</span>
                                        <span id="timer" class="ms-1 d-none">(60s)</span>
                                    </a>
                                </div>
                            </div>
                        </form>

                        <!-- Hidden Form for Resend Code -->
                        <form id="hiddenResendForm" method="post"
                              asp-action="ResendCodeOnly" style="display: none;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="email" id="resendEmail" value="@email" />
                        </form>
                    }
                    else
                    {
                        <!-- STEP 2: RESET PASSWORD FORM -->
                        <form asp-action="ResetPassword" method="post" class="needs-validation" novalidate>
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Email" value="@email" />
                            <input type="hidden" asp-for="ResetCode" value="@Model.ResetCode" />

                            <div class="mb-4">
                                <label asp-for="NewPassword" class="form-label fw-semibold">
                                    <i class="fas fa-key me-2"></i>New Password *
                                </label>
                                <div class="input-group">
                                    <input asp-for="NewPassword"
                                           type="password"
                                           class="form-control form-control-lg"
                                           placeholder="Enter new password"
                                           required
                                           minlength="6"
                                           id="newPassword">
                                    <button class="btn btn-outline-secondary" type="button"
                                            id="toggleNewPassword">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                                <div class="form-text">
                                    <i class="fas fa-info-circle me-1"></i>Password must be at least 6 characters long
                                </div>
                            </div>

                            <div class="mb-4">
                                <label asp-for="ConfirmPassword" class="form-label fw-semibold">
                                    <i class="fas fa-key me-2"></i>Confirm Password *
                                </label>
                                <div class="input-group">
                                    <input asp-for="ConfirmPassword"
                                           type="password"
                                           class="form-control form-control-lg"
                                           placeholder="Re-enter new password"
                                           required
                                           minlength="6"
                                           id="confirmPassword">
                                    <button class="btn btn-outline-secondary" type="button"
                                            id="toggleConfirmPassword">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>

                            <div class="d-grid gap-2 mb-4">
                                <button type="submit" class="btn btn-success btn-lg py-3" id="resetBtn">
                                    <i class="fas fa-save me-2"></i>Reset Password
                                </button>

                                <a asp-action="Login" asp-controller="Account"
                                   class="btn btn-outline-secondary btn-lg py-3">
                                    <i class="fas fa-times me-2"></i>Cancel
                                </a>
                            </div>
                        </form>
                        @if (showSuccessOnPage)
                        {
                            <script>
                                // Disable form submit buttons when success is shown
                                document.addEventListener('DOMContentLoaded', function() {
                                    const submitButtons = document.querySelectorAll('button[type="submit"]');
                                    submitButtons.forEach(button => {
                                        button.disabled = true;
                                    });
                                });
                            </script>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Resend Code Function with timer
        function resendCode(email) {
            if (!email) {
                showToast('Email is required', 'error');
                return false;
            }

            const link = document.getElementById('resendLink');
            const text = document.getElementById('resendText');
            const timer = document.getElementById('timer');
            const icon = link.querySelector('i');

            // Disable link
            link.style.pointerEvents = 'none';
            link.classList.add('text-muted');

            // Show loading state
            icon.classList.remove('fa-redo');
            icon.classList.add('fa-spinner', 'fa-spin');
            text.textContent = ' Sending...';

            // Submit the form
            document.getElementById('resendEmail').value = email;
            document.getElementById('hiddenResendForm').submit();

            return false;
        }

        // Toggle password visibility
        document.getElementById('toggleNewPassword')?.addEventListener('click', function () {
            const passwordInput = document.getElementById('newPassword');
            const icon = this.querySelector('i');

            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                passwordInput.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        });

        document.getElementById('toggleConfirmPassword')?.addEventListener('click', function () {
            const passwordInput = document.getElementById('confirmPassword');
            const icon = this.querySelector('i');

            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                passwordInput.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        });

        // Auto-focus and auto-select
        document.addEventListener('DOMContentLoaded', function() {
            @if (!codeVerified)
            {
                    <text>
                    // Focus on code input
                    const codeInput = document.getElementById('resetCodeInput');
                    if (codeInput) {
                        codeInput.focus();
                        codeInput.select();
                    }
                    </text>
            }
            else
            {
                    <text>
                    // Focus on password input
                    const passwordInput = document.getElementById('newPassword');
                    if (passwordInput) {
                        passwordInput.focus();
                    }
                    </text>
            }

            // Auto-dismiss alerts after 8 seconds
            setTimeout(function() {
                const alerts = document.querySelectorAll('.alert:not(.alert-warning)');
                alerts.forEach(alert => {
                    try {
                        const bsAlert = new bootstrap.Alert(alert);
                        bsAlert.close();
                    } catch (e) {
                        // If Bootstrap not available, hide manually
                        alert.style.display = 'none';
                    }
                });
            }, 8000);

            // Scroll to form
            const resetForm = document.getElementById('resetForm');
            if (resetForm) {
                resetForm.scrollIntoView({ behavior: 'smooth' });
            }

            // Form validation feedback
            const forms = document.querySelectorAll('.needs-validation');
            forms.forEach(form => {
                form.addEventListener('submit', function(event) {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        });

        // Helper function to show toast messages
        function showToast(message, type = 'info') {
            const toastContainer = document.createElement('div');
            toastContainer.className = `toast align-items-center text-bg-${type} border-0`;
            toastContainer.setAttribute('role', 'alert');
            toastContainer.setAttribute('aria-live', 'assertive');
            toastContainer.setAttribute('aria-atomic', 'true');

            toastContainer.innerHTML = `
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-circle'} me-2"></i>
                        ${message}
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            `;

            document.body.appendChild(toastContainer);
            const toast = new bootstrap.Toast(toastContainer);
            toast.show();

            // Remove after hide
            toastContainer.addEventListener('hidden.bs.toast', function () {
                document.body.removeChild(toastContainer);
            });
        }

        // Validate code input format
        document.getElementById('resetCodeInput')?.addEventListener('input', function(e) {
            this.value = this.value.replace(/[^0-9]/g, '');
            if (this.value.length > 6) {
                this.value = this.value.slice(0, 6);
            }
        });

                // ✅ Countdown for redirection
        function startCountdown(seconds, email) {
            let remaining = seconds;
            const countdownElement = document.getElementById('countdown');

            const interval = setInterval(function() {
                remaining--;
                if (countdownElement) {
                    countdownElement.textContent = remaining;
                }

                if (remaining <= 0) {
                    clearInterval(interval);
                    window.location.href = '/Account/Login';
                }
            }, 1000);
        }

        // Auto-dismiss alerts after 8 seconds (existing code)
        setTimeout(function() {
            const alerts = document.querySelectorAll('.alert:not(.alert-warning)');
            alerts.forEach(alert => {
                try {
                    const bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                } catch (e) {
                    alert.style.display = 'none';
                }
            });
        }, 8000);
    </script>
}