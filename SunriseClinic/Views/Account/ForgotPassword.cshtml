@model SunriseClinic.Models.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";

    // Get messages from TempData
    var successMessage = TempData["SuccessMessage"] as string;
}

<div id="forgotForm" class="container py-3">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-light py-4">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-key fa-2x me-3"></i>
                        <div>
                            <h2 class="h4 mb-0">Forgot Password</h2>
                            <p class="mb-0 opacity-75">Reset your account password</p>
                        </div>
                    </div>
                </div>
                <div class="card-body p-5">
                    <!-- শুধু SUCCESS message দেখাবে -->
                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show mb-4">
                            <i class="fas fa-check-circle me-2"></i>
                            @successMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <!-- ModelState GENERAL errors -->
                    @if (ViewData.ModelState[""]?.Errors?.Count > 0)
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-4">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            @foreach (var error in ViewData.ModelState[""].Errors)
                            {
                                <div>@error.ErrorMessage</div>
                            }
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="ForgotPassword" method="post" class="needs-validation" novalidate>
                        @Html.AntiForgeryToken()

                        <div class="alert alert-info border-0 mb-4">
                            <div class="d-flex">
                                <i class="fas fa-info-circle fa-lg me-3 mt-1"></i>
                                <div>
                                    <h6 class="alert-heading mb-2">How it works</h6>
                                    <p class="mb-0">
                                        Enter your email address and we'll send you a verification code to reset your password.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Email" class="form-label fw-semibold">
                                <i class="fas fa-envelope me-2"></i>Email Address *
                            </label>
                            <input asp-for="Email" type="email"
                                   class="form-control form-control-lg @(ViewData.ModelState["Email"]?.Errors?.Count > 0 ? "is-invalid" : "")"
                                   placeholder="Enter your registered email"
                                   required>
                            <!-- Field-specific error -->
                            @if (ViewData.ModelState["Email"]?.Errors?.Count > 0)
                            {
                                <div class="invalid-feedback d-block mt-1">
                                    @foreach (var error in ViewData.ModelState["Email"].Errors)
                                    {
                                        <div class="small">
                                            <i class="fas fa-exclamation-triangle me-1"></i>
                                            @error.ErrorMessage
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <div class="d-grid gap-2 mb-4">
                            <button type="submit" class="btn btn-primary btn-lg py-3">
                                <i class="fas fa-paper-plane me-2"></i>Send Reset Code
                            </button>
                            <a asp-action="Login" asp-controller="Account"
                               class="btn btn-outline-primary btn-lg py-3">
                                <i class="fas fa-sign-in-alt me-2"></i>Back to Login
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Form validation
        (function () {
            'use strict'
            var forms = document.querySelectorAll('.needs-validation')
            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }
                        form.classList.add('was-validated')
                    }, false)
                })
        })()

        // Scroll to form on page load
        document.addEventListener('DOMContentLoaded', function() {
            const loginForm = document.getElementById('forgotForm');
            if (loginForm) {
                loginForm.classList.add('scroll-target');
                loginForm.scrollIntoView({ behavior: 'smooth' });
            }
        });

        // Clear validation styling on input
        document.querySelectorAll('input').forEach(input => {
            input.addEventListener('input', function() {
                if (this.classList.contains('is-invalid')) {
                    this.classList.remove('is-invalid');
                }
            });
        });
    </script>
}