@{
    var userName = Context.Session.GetString("UserName") ?? "Admin";
    var userEmail = Context.Session.GetString("UserEmail") ?? "";
}

<div class="mobile-profile-section" style="background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);">
    <div class="position-relative d-inline-block">
        <img src="~/images/admin-avatar.png"
             class="mobile-profile-img"
             alt="Admin Avatar">
    </div>
    <h5 class="mobile-profile-name">@userName</h5>
    <p class="mobile-profile-role">
        <i class="fas fa-user-shield me-1"></i>Administrator
    </p>
    <div class="mobile-profile-id">
        <i class="fas fa-envelope me-1"></i>@userEmail
    </div>
</div>

<!-- Admin Menu -->
<ul class="sidebar-menu-mobile">
    <li class="sidebar-item-mobile @(Context.Request.Path.Value.Contains("Dashboard") ? "active" : "")">
        <a href="/Admin/Dashboard" class="sidebar-link-mobile">
            <i class="fas fa-tachometer-alt"></i>
            <span>Dashboard</span>
        </a>
    </li>

    <li class="sidebar-item-mobile has-submenu-mobile @(Context.Request.Path.Value.Contains("Patients") || Context.Request.Path.Value.Contains("Doctors") || Context.Request.Path.Value.Contains("Staff") ? "open" : "")">
        <a href="#" class="sidebar-link-mobile">
            <i class="fas fa-users"></i>
            <span>User Management</span>
            <i class="fas fa-chevron-down submenu-arrow-mobile"></i>
        </a>
        <ul class="sidebar-submenu-mobile" style="@(Context.Request.Path.Value.Contains("Patients") || Context.Request.Path.Value.Contains("Doctors") || Context.Request.Path.Value.Contains("Staff") ? "display: block;" : "")">
            <li class="@(Context.Request.Path.Value.Contains("/Admin/Patients") ? "active" : "")">
                <a href="/Admin/Patients">
                    <i class="fas fa-user-injured me-2"></i>
                    Patients
                </a>
            </li>
            <li class="@(Context.Request.Path.Value.Contains("/Admin/Doctors") ? "active" : "")">
                <a href="/Admin/Doctors">
                    <i class="fas fa-user-md me-2"></i>
                    Doctors
                </a>
            </li>
            <li class="@(Context.Request.Path.Value.Contains("/Admin/Staff") ? "active" : "")">
                <a href="/Admin/Staff">
                    <i class="fas fa-user-nurse me-2"></i>
                    Staff
                </a>
            </li>
        </ul>
    </li>

    <li class="sidebar-item-mobile @(Context.Request.Path.Value.Contains("Appointments") ? "active" : "")">
        <a href="/Admin/Appointments" class="sidebar-link-mobile">
            <i class="fas fa-calendar-check"></i>
            <span>Appointments</span>
        </a>
    </li>

    <li class="sidebar-item-mobile @(Context.Request.Path.Value.Contains("Reports") ? "active" : "")">
        <a href="/Admin/Reports" class="sidebar-link-mobile">
            <i class="fas fa-chart-bar"></i>
            <span>Reports</span>
        </a>
    </li>

    <li class="sidebar-item-mobile @(Context.Request.Path.Value.Contains("Settings") ? "active" : "")">
        <a href="/Admin/Settings" class="sidebar-link-mobile">
            <i class="fas fa-cog"></i>
            <span>Settings</span>
        </a>
    </li>

    <li class="sidebar-item-mobile mt-4 pt-3 border-top">
        <a href="/Account/Logout" class="sidebar-link-mobile text-danger">
            <i class="fas fa-sign-out-alt"></i>
            <span>Logout</span>
        </a>
    </li>
</ul>

<style>
    .sidebar-item-mobile.active .sidebar-link-mobile {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        color: white;
    }

    .sidebar-submenu-mobile li.active a {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        color: white;
    }
</style>