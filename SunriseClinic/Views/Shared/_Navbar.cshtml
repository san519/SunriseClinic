<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Function to handle dropdown hover
        function initHoverDropdowns() {
            const dropdownContainers = document.querySelectorAll('.dropdown');

            dropdownContainers.forEach(container => {
                const toggle = container.querySelector('.dropdown-toggle');
                const menu = container.querySelector('.dropdown-menu');

                if (toggle && menu) {
                    // PC/mouse hover events
                    container.addEventListener('mouseenter', function() {
                        if (window.innerWidth >= 992) { // Only for desktop
                            const bsDropdown = bootstrap.Dropdown.getInstance(toggle);
                            if (!bsDropdown) {
                                new bootstrap.Dropdown(toggle).show();
                            } else {
                                bsDropdown.show();
                            }
                        }
                    });

                    container.addEventListener('mouseleave', function() {
                        if (window.innerWidth >= 992) { // Only for desktop
                            const bsDropdown = bootstrap.Dropdown.getInstance(toggle);
                            if (bsDropdown) {
                                bsDropdown.hide();
                            }
                        }
                    });

                    // Keep menu open when hovering over it
                    menu.addEventListener('mouseenter', function() {
                        if (window.innerWidth >= 992) {
                            const bsDropdown = bootstrap.Dropdown.getInstance(toggle);
                            if (bsDropdown) {
                                bsDropdown.show();
                            }
                        }
                    });
                }
            });
        }

        // Initialize dropdowns
        initHoverDropdowns();

        // Re-initialize on window resize
        window.addEventListener('resize', function() {
            initHoverDropdowns();
        });

        // Bootstrap dropdown initialization
        var dropdownElementList = [].slice.call(document.querySelectorAll('.dropdown-toggle'));
        dropdownElementList.map(function (dropdownToggleEl) {
            return new bootstrap.Dropdown(dropdownToggleEl);
        });

        // SEO: Track navigation clicks
        const navLinks = document.querySelectorAll('a.nav-link, a.dropdown-item');
        navLinks.forEach(link => {
            link.addEventListener('click', function() {
                // For SEO analytics
                const linkText = this.textContent.trim();
                const linkHref = this.href;
                console.log('SEO Navigation: User clicked', linkText, '->', linkHref);

                // You can add Google Analytics event here
                if (typeof gtag !== 'undefined') {
                    gtag('event', 'nav_click', {
                        'event_category': 'Navigation',
                        'event_label': linkText,
                        'link_url': linkHref
                    });
                }
            });
        });

        // SEO: Add structured data for current page
        function updateBreadcrumbSchema() {
            const currentPath = window.location.pathname;
            let breadcrumbItems = [
                {
                    "@@type": "ListItem",
                    "position": 1,
                    "name": "Home",
                    "item": "https://www.sunriseclinicbd.com/"
                }
            ];

            if (currentPath.includes('/Home/About')) {
                breadcrumbItems.push({
                    "@@type": "ListItem",
                    "position": 2,
                    "name": "About Us",
                    "item": "https://www.sunriseclinicbd.com/Home/About"
                });
            } else if (currentPath.includes('/Home/Contact')) {
                breadcrumbItems.push({
                    "@@type": "ListItem",
                    "position": 2,
                    "name": "Contact",
                    "item": "https://www.sunriseclinicbd.com/Home/Contact"
                });
            } else if (currentPath.includes('/Home/Diagnostic')) {
                breadcrumbItems.push({
                    "@@type": "ListItem",
                    "position": 2,
                    "name": "Diagnostic Services",
                    "item": "https://www.sunriseclinicbd.com/Home/Diagnostic"
                });
            } else if (currentPath.includes('/Home/Emergency')) {
                breadcrumbItems.push({
                    "@@type": "ListItem",
                    "position": 2,
                    "name": "Emergency Care",
                    "item": "https://www.sunriseclinicbd.com/Home/Emergency"
                });
            }

            const breadcrumbSchema = {
                "@@context": "https://schema.org",
                "@@type": "BreadcrumbList",
                "itemListElement": breadcrumbItems
            };

            // Remove existing breadcrumb script if any
            const existingScript = document.querySelector('script[data-breadcrumb-schema]');
            if (existingScript) {
                existingScript.remove();
            }

            // Add new breadcrumb script
            const script = document.createElement('script');
            script.type = 'application/ld+json';
            script.setAttribute('data-breadcrumb-schema', 'true');
            script.textContent = JSON.stringify(breadcrumbSchema);
            document.head.appendChild(script);
        }

        // Initialize breadcrumb schema
        updateBreadcrumbSchema();

        // SEO: Update aria-current attribute for active links
        function updateAriaCurrent() {
            const currentPath = window.location.pathname;
            const navLinks = document.querySelectorAll('.nav-link');

            navLinks.forEach(link => {
                const linkPath = link.getAttribute('href');
                if (linkPath === currentPath ||
                   (currentPath === '/' && linkPath === '/') ||
                   (currentPath.includes('/Home/About') && linkPath === '/Home/About') ||
                   (currentPath.includes('/Home/Contact') && linkPath === '/Home/Contact')) {
                    link.setAttribute('aria-current', 'page');
                } else {
                    link.removeAttribute('aria-current');
                }
            });
        }

        updateAriaCurrent();
    });
</script>

<!-- End of Navigation -->