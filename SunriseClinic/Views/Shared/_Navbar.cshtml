<!-- Navigation -->
<nav class="navbar navbar-expand-lg navbar-light fixed-top" itemscope itemtype="https://schema.org/SiteNavigationElement">
    <div class="container">
        <a class="navbar-brand" href="/" itemprop="url" aria-label="Sunrise Clinic & Diagnostic Center Pabna">
            <i class="fas fa-sun me-2" aria-hidden="true"></i>Sunrise<span>Clinic</span>
            <meta itemprop="name" content="Sunrise Clinic & Diagnostic Center">
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item" itemprop="name">
                    <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")"
                       asp-controller="Home" asp-action="Index" itemprop="url"
                       aria-label="Sunrise Clinic Home Page - Medical Diagnostic Center Pabna">
                        Home
                    </a>
                </li>
                <li class="nav-item" itemprop="name">
                    <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "About" ? "active" : "")"
                       asp-controller="Home" asp-action="About" itemprop="url"
                       aria-label="About Sunrise Clinic Diagnostic Center Pabna">
                        About Us
                    </a>
                </li>
                <!-- Services Dropdown -->
                <li class="nav-item dropdown" id="servicesDropdownContainer" itemprop="name">
                    <a class="nav-link dropdown-toggle"
                       href="#"
                       id="servicesDropdown"
                       role="button"
                       data-bs-toggle="dropdown"
                       data-bs-auto-close="outside"
                       aria-expanded="false"
                       aria-label="Medical Services Menu - Diagnostic Tests & Healthcare">
                        Services
                    </a>
                    <ul class="dropdown-menu" aria-labelledby="servicesDropdown">
                        <li><a class="dropdown-item" href="/Home/Gallery" aria-label="Sunrise Clinic Gallery - Medical Facility Photos"><i class="fas fa-images me-2"></i>Gallery</a></li>
                        <li><a class="dropdown-item" href="/Departments" aria-label="Medical Departments at Sunrise Clinic"><i class="fas fa-building me-2"></i>Departments</a></li>
                        <li><a class="dropdown-item" href="/Doctors" aria-label="Our Medical Doctors at Sunrise Clinic"><i class="fas fa-user-md me-2"></i>Our Doctors</a></li>
                        <li><a class="dropdown-item" asp-controller="Home" asp-action="Emergency" aria-label="24/7 Emergency Care Services"><i class="fas fa-ambulance me-2"></i>Emergency Care</a></li>
                        <li><a class="dropdown-item" asp-controller="Home" asp-action="Diagnostic" aria-label="Diagnostic Services & Medical Tests"><i class="fas fa-vial me-2"></i>Diagnostic Services</a></li>
                    </ul>
                </li>
                <li class="nav-item" itemprop="name">
                    <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Contact" ? "active" : "")"
                       asp-controller="Home" asp-action="Contact" itemprop="url"
                       aria-label="Contact Sunrise Clinic Pabna for Medical Appointments">
                        Contact
                    </a>
                </li>
                <!-- User Dropdown (if authenticated) -->
                @using System.Security.Claims
                @inject IHttpContextAccessor HttpContextAccessor

                @{
                    // শুধু Claims থেকে user type নিন
                    var userType = User.FindFirst(ClaimTypes.Role)?.Value;
                    var userName = User.Identity?.Name;
                    var profilePicture = User.FindFirst("ProfilePicture")?.Value ?? "default.webp";
                }

                @if (User.Identity?.IsAuthenticated == true && !string.IsNullOrEmpty(userType))
                {
                    <li class="nav-item dropdown" id="userDropdownContainer">
                        <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="/uploads/profile-pictures/@profilePicture"
                                 alt="@userName"
                                 class="rounded-circle me-2"
                                 style="width: 30px; height: 30px; object-fit: cover;">
                            @userName
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                            @switch (userType)
                            {
                                case "Admin":
                                    <li>
                                        <a class="dropdown-item" href="/Admin/Dashboard">
                                            <i class="fas fa-tachometer-alt me-2"></i>Dashboard
                                        </a>
                                    </li>
                                    break;

                                case "Doctor":
                                    <li>
                                        <a class="dropdown-item" href="/Doctor/Dashboard">
                                            <i class="fas fa-stethoscope me-2"></i>Dashboard
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="/Doctor/Profile">
                                            <i class="fas fa-user-md me-2"></i>My Profile
                                        </a>
                                    </li>
                                    break;

                                case "Patient":
                                    <li>
                                        <a class="dropdown-item" href="/Patient/Dashboard">
                                            <i class="fas fa-user-injured me-2"></i>Dashboard
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="/Patient/Profile">
                                            <i class="fas fa-user me-2"></i>My Profile
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="/Appointment/MyAppointments">
                                            <i class="fas fa-list me-2"></i>Book Appointment
                                        </a>
                                    </li>
                                    break;

                                case "Nurse":
                                    <li>
                                        <a class="dropdown-item" href="/Nurse/Dashboard">
                                            <i class="fas fa-user-nurse me-2"></i>Dashboard
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="/Nurse/Profile">
                                            <i class="fas fa-user me-2"></i>My Profile
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="/Nurse/Patients">
                                            <i class="fas fa-users me-2"></i>Manage Patients
                                        </a>
                                    </li>
                                    break;
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" href="/Account/Logout">
                                    <i class="fas fa-sign-out-alt me-2"></i>Logout
                                </a>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="btn btn-outline-primary me-2" href="/Account/Login">
                            <i class="fas fa-sign-in-alt me-2"></i>Login
                        </a>
                    </li>
                    <li class="nav-item p-1">
                        <a class="btn btn-accent" href="/Appointment/Create">
                            <i class="fas fa-calendar-check me-2"></i>Book Appointment
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

