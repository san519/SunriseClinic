<ul class="list-unstyled mb-0">
    <li class="mb-2">
        <a href="/Patient/Dashboard" class="d-flex align-items-center p-3 rounded text-decoration-none mobile-sidebar-link @(Context.Request.Path.Value.Contains("/Patient/Dashboard") ? "active" : "")">
            <i class="fas fa-tachometer-alt me-3"></i>Dashboard
        </a>
    </li>
    <li class="mb-2">
        <a href="/Patient/Profile" class="d-flex align-items-center p-3 rounded text-decoration-none mobile-sidebar-link @(Context.Request.Path.Value.Contains("/Patient/Profile") && !Context.Request.Path.Value.Contains("MedicalHistory") ? "active" : "")">
            <i class="fas fa-user-edit me-3"></i>My Profile
        </a>
    </li>
    <li class="mb-2">
        <a href="/Appointment/Create" class="d-flex align-items-center p-3 rounded text-decoration-none mobile-sidebar-link @(Context.Request.Path.Value.Contains("/Appointment/Create") ? "active" : "")">
            <i class="fas fa-calendar-plus me-3"></i>Book Appointment
        </a>
    </li>
    <li class="mb-2">
        <a href="/Appointment/MyAppointments" class="d-flex align-items-center p-3 rounded text-decoration-none mobile-sidebar-link @(Context.Request.Path.Value.Contains("/Appointment/MyAppointments") ? "active" : "")">
            <i class="fas fa-list me-3"></i>My Appointments
        </a>
    </li>

    <li class="mb-2">
        <a href="/Patient/MedicalHistory" class="d-flex align-items-center p-3 rounded text-decoration-none mobile-sidebar-link @(Context.Request.Path.Value.Contains("/Patient/MedicalHistory") ? "active" : "")">
            <i class="fas fa-file-medical me-3"></i>Medical History
        </a>
    </li>
    <li class="mb-2">
        <a href="/Patient/Prescriptions" class="d-flex align-items-center p-3 rounded text-decoration-none mobile-sidebar-link @(Context.Request.Path.Value.Contains("/Patient/Prescriptions") ? "active" : "")">
            <i class="fas fa-prescription me-3"></i>Prescriptions
        </a>
    </li>
    <li class="mb-2">
        <a href="/Patient/TestReports" class="d-flex align-items-center p-3 rounded text-decoration-none mobile-sidebar-link @(Context.Request.Path.Value.Contains("/Patient/TestReports") ? "active" : "")">
            <i class="fas fa-file-pdf me-3"></i>Test Reports
        </a>
    </li>
    <li>
        <a href="/Account/Logout" class="d-flex align-items-center p-3 rounded text-decoration-none mobile-sidebar-link">
            <i class="fas fa-sign-out-alt me-3"></i>Logout
        </a>
    </li>
</ul>