    <!-- Floating Buttons -->
    <div class="vertical-floating-buttons" aria-label="Quick Actions">
        <button class="complaint-float" id="complaintBtn" onclick="openComplaintModal()" title="Submit Feedback" aria-label="Submit Feedback or Complaint">
            <i class="fas fa-comment-medical" aria-hidden="true"></i>
            Feedback
        </button>

        <a href="https://wa.me/+8801738513042" target="_blank" class="whatsapp-float text-light" title="Chat on WhatsApp" aria-label="Chat with us on WhatsApp">
            <i class="fab fa-whatsapp" aria-hidden="true"></i>
        </a>
    </div>

    <!-- Complaint Modal -->
    <div class="complaint-modal" id="complaintModal" role="dialog" aria-labelledby="complaintModalLabel" aria-hidden="true">
        <div class="complaint-content" role="document">
            <div class="complaint-header">
                <h5 id="complaintModalLabel"><i class="fas fa-headset me-2" aria-hidden="true"></i>Submit Your Feedback</h5>
                <button class="close-complaint" onclick="closeComplaintModal()" aria-label="Close">&times;</button>
            </div>
            <div class="p-4">
                <form id="complaintForm" onsubmit="submitComplaint(event)" role="form" aria-labelledby="complaintModalLabel">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="name" class="form-label small text-muted mb-1">Full Name *</label>
                        <input type="text" class="form-control form-control-lg"
                               placeholder="Your full name" required
                               name="name" id="name" aria-required="true">
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label small text-muted mb-1">Email Address *</label>
                        <input type="email" class="form-control form-control-lg"
                               placeholder="example@email.com" required
                               name="email" id="email" aria-required="true">
                    </div>

                    <div class="mb-3">
                        <label for="phone" class="form-label small text-muted mb-1">Phone Number *</label>
                        <input type="tel" class="form-control form-control-lg"
                               placeholder="+8801712345678"
                               pattern="^(\+8801|01)[3-9]\d{8}$"
                               maxlength="14" required
                               name="phone" id="phone" aria-required="true">
                        <small class="text-muted">Example: +8801712345678</small>
                    </div>

                    <div class="mb-3">
                        <label for="feedbackType" class="form-label small text-muted mb-1">Feedback Type *</label>
                        <select class="form-select form-control-lg"
                                name="feedbackType" id="feedbackType" required aria-required="true">
                            <option value="" selected disabled>Select type...</option>
                            <option value="Complaint">Complaint</option>
                            <option value="Suggestion">Suggestion</option>
                            <option value="Appreciation">Appreciation</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="feedback" class="form-label small text-muted mb-1">Your Feedback *</label>
                        <textarea class="form-control form-control-lg" rows="4"
                                  placeholder="Please describe your feedback in detail..." required
                                  name="feedback" id="feedback" aria-required="true"></textarea>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger btn-lg py-3" aria-label="Submit feedback form">
                            <i class="fas fa-paper-plane me-2" aria-hidden="true"></i>Submit Feedback
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-lg"
                                onclick="closeComplaintModal()" aria-label="Cancel feedback">
                            Cancel
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

