<!DOCTYPE html>
<html lang="en" itemscope itemtype="https://schema.org/MedicalClinic">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary SEO Meta Tags -->
    <title>@ViewData["Title"] - Sunrise Clinic & Diagnostic Center | Best Medical Lab in Pabna, Bangladesh</title>
    <meta name="description" content="@ViewData["Description"]" />
    <meta name="keywords" content="@ViewData["Keywords"]" />

    <!-- Search Engine Verification -->
    <meta name="google-site-verification" content="your-verification-code">
    <meta name="bing-verification" content="your-bing-verification">

    <!-- Robots and Crawling -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
    <meta name="googlebot" content="index, follow">
    <meta name="bingbot" content="index, follow">

    <!-- Author and Copyright -->
    <meta name="author" content="Sunrise Clinic & Diagnostic Center">
    <meta name="copyright" content="Sunrise Clinic BD">
    <meta name="publisher" content="Sunrise Clinic Pabna">

    <!-- Geo Location -->
    <meta name="geo.region" content="BD-RS">
    <meta name="geo.placename" content="Pabna">
    <meta name="geo.position" content="24.0064;89.2372">
    <meta name="ICBM" content="24.0064, 89.2372">

    <!-- Sitemap Reference -->
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <!-- Canonical URL -->
    <link rel="canonical" href="https://www.sunriseclinicbd.com@(Context.Request.Path)" />

    <!-- Alternate Languages -->
    <link rel="alternate" hreflang="en" href="https://www.sunriseclinicbd.com/" />
    <link rel="alternate" hreflang="bn" href="https://www.sunriseclinicbd.com/bn/" />
    <link rel="alternate" hreflang="x-default" href="https://www.sunriseclinicbd.com/" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sunrise Clinic & Diagnostic Center" />
    <meta property="og:url" content="https://www.sunriseclinicbd.com/" />
    <meta property="og:title" content="@ViewData["Title"] - Sunrise Clinic & Diagnostic Center" />
    <meta property="og:description" content="@ViewData["Description"]" />
    <meta property="og:image" content="https://www.sunriseclinicbd.com/img/sunrise-clinic.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sunrise Clinic & Diagnostic Center Pabna - Medical Facility" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="bn_BD" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@@sunriseclinicbd" />
    <meta name="twitter:creator" content="@@sunriseclinicbd" />
    <meta name="twitter:url" content="https://www.sunriseclinicbd.com/" />
    <meta name="twitter:title" content="@ViewData["Title"] - Sunrise Clinic & Diagnostic Center" />
    <meta name="twitter:description" content="@ViewData["Description"]" />
    <meta name="twitter:image" content="https://www.sunriseclinicbd.com/img/sunrise-clinic.png" />
    <meta name="twitter:image:alt" content="Sunrise Clinic Medical Center Pabna" />

    <!-- WhatsApp specific -->
    <meta property="og:site_name" content="Sunrise Clinic & Diagnostic Center" />
    <meta property="og:updated_time" content="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm:sszzz")" />

    <!-- Schema.org Structured Data -->
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "MedicalClinic",
          "@@id": "https://www.sunriseclinicbd.com/#organization",
          "name": "Sunrise Clinic & Diagnostic Center",
          "alternateName": "Sunrise Clinic Pabna",
