        }
    </script>

    <!-- Breadcrumb Schema (Dynamic) -->
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@@type": "ListItem",
              "position": 1,
              "name": "Home",
              "item": "https://www.sunriseclinicbd.com/"
