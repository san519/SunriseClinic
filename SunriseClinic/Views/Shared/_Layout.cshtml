    <!-- SEO Analytics Script -->
    <script>
        // SEO Event Tracking
        document.addEventListener('DOMContentLoaded', function() {
            // Track emergency calls
            document.querySelectorAll('a[href^="tel:"]').forEach(link => {
                link.addEventListener('click', function() {
                    console.log('SEO: Emergency call clicked:', this.href);
                    // Add analytics tracking here
                });
            });

            // Track appointment bookings
            const bookButtons = document.querySelectorAll('[href*="Appointment"]');
            bookButtons.forEach(button => {
                button.addEventListener('click', function() {
                    console.log('SEO: Appointment booking initiated');
                });
            });

            // Track social media clicks
            document.querySelectorAll('a[title*="Follow"]').forEach(socialLink => {
                socialLink.addEventListener('click', function() {
                    console.log('SEO: Social media click:', this.title);
                });
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>