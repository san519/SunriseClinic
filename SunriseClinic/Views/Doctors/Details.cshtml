@model SunriseClinic.Models.Doctor

@{
    ViewData["Title"] = $"Dr. {Model?.FullName} - Sunrise Clinic";

    // Fallback values if null
    var doctorName = Model?.FullName ?? "Doctor";
    var specialization = Model?.Specialization ?? "General Physician";
    var qualification = Model?.Qualification ?? "MBBS";
    var experience = Model?.ExperienceYears ?? 5;
    var department = Model?.Department ?? "General Medicine";
    var availableDays = Model?.AvailableDays ?? "Monday to Friday";
    var availableTime = Model?.AvailableTime ?? "9:00 AM - 5:00 PM";
    var fee = Model?.ConsultationFee ?? 500.00m;
    var license = Model?.LicenseNumber ?? "BMDC-XXXXX";
    var displayId = Model?.DisplayId ?? "D10001";
    var profilePic = Model?.ProfilePicture ?? "doctor-default.jpg";
    var email = Model?.Email ?? "doctor@sunriseclinic.com";
    var phone = Model?.PhoneNumber ?? "+880 XXXX XXXXXX";
}

<!-- Hero Banner -->
<div class="doctor-hero-banner" id="doctorsDetails" style="background: linear-gradient(135deg, #1a73e8 0%, #00bfae 100%);">
    <div class="container py-5">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/" class="text-white-50">Home</a></li>
                <li class="breadcrumb-item"><a href="/Doctors" class="text-white-50">Our Doctors</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">Dr. @doctorName</li>
            </ol>
        </nav>

        <div class="row align-items-center">
            <div class="col-lg-8 text-white">
                <h1 class="display-5 fw-bold mb-3">Dr. @doctorName</h1>
                <h4 class="mb-4">@specialization</h4>
                <div class="d-flex flex-wrap gap-3 mb-4">
                    <span class="badge bg-white text-primary px-3 py-2">
                        <i class="fas fa-graduation-cap me-1"></i> @qualification
                    </span>
                    <span class="badge bg-white text-primary px-3 py-2">
                        <i class="fas fa-briefcase me-1"></i> @experience+ Years Experience
                    </span>
                    <span class="badge bg-white text-primary px-3 py-2">
                        <i class="fas fa-id-card me-1"></i> ID: @displayId
                    </span>
                </div>
            </div>
            <div class="col-lg-4 text-center">
                <div class="profile-image-container">
                    <img src="~/uploads/profile-pictures/@profilePic"
                         class="profile-img rounded-circle border-4 border-white shadow-lg"
                         alt="Dr. @doctorName"
                         onerror="this.src='https://via.placeholder.com/300/1a73e8/ffffff?text=Dr.+@Uri.EscapeDataString(doctorName)'">
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Doctor Details -->
<div class="m-0">
<div class="container py-3">
    <div class="row">
        <!-- Left Column: Doctor Info -->
        <div class="col-lg-8">
            <!-- About Doctor -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h4 class="text-primary mb-4">
                        <i class="fas fa-user-md me-2"></i>About Dr. @doctorName
                    </h4>
                    <p class="text-muted">
                        Dr. @doctorName is a highly experienced @specialization with over @experience years of clinical practice.
                        Specializing in @department, Dr. @doctorName provides compassionate and expert care to all patients.
                    </p>

                    <div class="row mt-4">
                        <div class="col-md-6 mb-3">
                            <div class="d-flex align-items-start">
                                <div class="bg-primary bg-opacity-10 p-3 rounded me-3">
                                    <i class="fas fa-graduation-cap text-primary fa-lg"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-1">Qualification</h6>
                                    <p class="mb-0 text-muted">@qualification</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="d-flex align-items-start">
                                <div class="bg-success bg-opacity-10 p-3 rounded me-3">
                                    <i class="fas fa-building text-success fa-lg"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-1">Department</h6>
                                    <p class="mb-0 text-muted">@department</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="d-flex align-items-start">
                                <div class="bg-info bg-opacity-10 p-3 rounded me-3">
                                    <i class="fas fa-clock text-info fa-lg"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-1">Available Days</h6>
                                    <p class="mb-0 text-muted">@availableDays</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="d-flex align-items-start">
                                <div class="bg-warning bg-opacity-10 p-3 rounded me-3">
                                    <i class="fas fa-money-bill-alt text-warning fa-lg"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-1">Consultation Fee</h6>
                                    <p class="mb-0 text-muted">৳@fee</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contact Card -->
            <div class="card border-0 shadow-sm mt-4">
                <div class="card-header bg-white border-0 py-4">
                    <h5 class="mb-0 text-center">
                        <i class="fas fa-address-card text-primary me-2"></i>
                        Contact Details
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary bg-opacity-10 p-2 rounded me-3">
                            <i class="fas fa-clock text-primary"></i>
                        </div>
                        <div>
                            <small class="text-muted">Availability</small>
                            <p class="mb-0 fw-semibold">@availableDays</p>
                            <p class="mb-0 text-muted">@availableTime</p>
                        </div>
                    </div>

                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-success bg-opacity-10 p-2 rounded me-3">
                            <i class="fas fa-phone text-success"></i>
                        </div>
                        <div>
                            <small class="text-muted">Phone</small>
                            <p class="mb-0 fw-semibold">@phone</p>
                        </div>
                    </div>

                    <div class="d-flex align-items-center">
                        <div class="bg-info bg-opacity-10 p-2 rounded me-3">
                            <i class="fas fa-envelope text-info"></i>
                        </div>
                        <div>
                            <small class="text-muted">Email</small>
                            <p class="mb-0 fw-semibold">@email</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Quick Info & Book Appointment -->
        <div class="col-lg-4">
            <div class="sticky-top" style="top: 20px;">
                <!-- Quick Info Card -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-0 py-4">
                        <h5 class="mb-0 text-center">
                            <i class="fas fa-info-circle text-primary me-2"></i>
                            Quick Information
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span><i class="fas fa-user-md me-2 text-primary"></i>Specialization</span>
                                <span class="fw-semibold">@specialization</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span><i class="fas fa-briefcase me-2 text-primary"></i>Experience</span>
                                <span class="fw-semibold">@experience+ Years</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span><i class="fas fa-building me-2 text-primary"></i>Department</span>
                                <span class="fw-semibold">@department</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span><i class="fas fa-id-card me-2 text-primary"></i>License No.</span>
                                <span class="fw-semibold">@license</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span><i class="fas fa-money-bill-alt me-2 text-primary"></i>Consultation Fee</span>
                                <span class="fw-semibold text-success">৳@fee</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Book Appointment Card - Added to Right Column -->
                <div class="card border-0 shadow-sm bg-gradient-primary text-white">
                    <div class="card-body p-4 text-center">
                        <h5 class="mb-3">Book Appointment</h5>
                        <p class="mb-4 opacity-90 small">Schedule a consultation with Dr. @doctorName</p>

                        @if (User.Identity?.IsAuthenticated == true && Context.Session.GetString("UserType") == "Patient")
                        {
                            <a href="/Appointment/Create?doctorId=@Model?.DoctorId"
                               class="btn btn-light btn-lg w-100 mb-2">
                                <i class="fas fa-calendar-plus me-2"></i> Book Now
                            </a>
                        }
                        else if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="alert alert-warning text-dark mb-0">
                                <i class="fas fa-info-circle me-2"></i>
                                Only patients can book appointments.
                            </div>
                        }
                        else
                        {
                            <div class="d-grid gap-2">
                                <a href="/Account/Login?returnUrl=/Doctors/Details/@Model?.DoctorId"
                                   class="btn btn-light btn-lg">
                                    <i class="fas fa-sign-in-alt me-2"></i> Login to Book
                                </a>
                                <a href="/Account/Register"
                                   class="btn btn-outline-light btn-lg">
                                    <i class="fas fa-user-plus me-2"></i> Register
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

<!-- Other Doctors Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row mb-4">
            <div class="col">
                <h3 class="text-center mb-3">Meet Other Expert Doctors</h3>
                <p class="text-center text-muted mb-0">Explore our team of specialized medical professionals</p>
            </div>
        </div>

        <div class="text-center">
            <a href="/Doctors" class="btn btn-primary btn-lg px-5">
                <i class="fas fa-user-md me-2"></i> View All Doctors
            </a>
        </div>
    </div>
    </div>
</section>

@section Styles {
<style>
    /* Premium Styling */
    .doctor-hero-banner {
        position: relative;
        overflow: hidden;
    }

        .doctor-hero-banner::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 300px;
            height: 300px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            transform: translate(100px, -100px);
        }

        .doctor-hero-banner::after {
            content: '';
            position: absolute;
            bottom: -50px;
            left: -50px;
            width: 200px;
            height: 200px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
        }

    .profile-image-container {
        position: relative;
        display: inline-block;
    }

    .profile-img {
        width: 200px;
        height: 200px;
        object-fit: cover;
        border: 5px solid white;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        transition: transform 0.3s ease;
    }

        .profile-img:hover {
            transform: scale(1.05);
        }

    .bg-gradient-primary {
        background: linear-gradient(135deg, #1a73e8 0%, #00bfae 100%);
        border: none;
    }

    .sticky-top {
        position: sticky;
        z-index: 10;
    }

    .list-group-item {
        border-color: rgba(0,0,0,0.05);
        padding: 1rem 1.25rem;
        transition: background-color 0.2s ease;
    }

        .list-group-item:hover {
            background-color: rgba(26, 115, 232, 0.05);
        }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .doctor-hero-banner h1 {
            font-size: 2rem;
        }

        .profile-img {
            width: 150px;
            height: 150px;
        }

        .btn-lg {
            padding: 0.75rem 1.5rem;
            font-size: 1rem;
        }
    }

    @@media (max-width: 576px) {
        .doctor-hero-banner h1 {
            font-size: 1.75rem;
        }

        .profile-img {
            width: 120px;
            height: 120px;
        }
    }
</style>
}
@section Scripts {
    <script>
        // Smooth scroll for page load
        document.addEventListener('DOMContentLoaded', function() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        // Add animation to cards on scroll
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, observerOptions);

        // Observe all cards
        document.querySelectorAll('.card').forEach(card => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';
            card.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
            observer.observe(card);
        });

        // Scroll to main on page load
        document.addEventListener('DOMContentLoaded', function() {
            const scrolltomain = document.getElementById('doctorsDetails');
            if (scrolltomain) {
                scrolltomain.classList.add('scroll-target');
                scrolltomain.scrollIntoView({ behavior: 'smooth' });
            }
        });

    </script>
}