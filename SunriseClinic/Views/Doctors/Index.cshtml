@model List<SunriseClinic.Models.Doctor>
@{
    ViewData["Title"] = "Our Expert Doctors - Sunrise Clinic & Diagnostic Center Pabna";
    ViewData["Description"] = "Meet our board-certified doctors at Sunrise Clinic Pabna: Specialist physicians, consultants, surgeons with 10+ years experience. Book appointment online for ₹500+ consultation.";
    ViewData["Keywords"] = "doctors in pabna, medical specialists pabna, best doctors pabna, sunrise clinic doctors, physician consultation pabna, book doctor appointment";
    ViewData["Canonical"] = "https://www.sunriseclinicbd.com/Doctors";
    ViewData["Image"] = "https://www.sunriseclinicbd.com/uploads/doctors-banner.jpg";

    // Schema.org data
    string domain = "https://www.sunriseclinicbd.com";
    var totalDoctors = Model?.Count ?? 0;
    var specializations = Model?.Select(d => d.Specialization).Distinct().ToList() ?? new List<string>();
}

<!-- Schema.org Structured Data for Medical Professionals -->
<script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "MedicalClinic",
      "name": "Sunrise Clinic & Diagnostic Center",
      "medicalSpecialty": ["GeneralMedicine", "Cardiology", "Gynecology", "Pediatrics", "Orthopedics", "Dermatology"],
      "department": [
        @foreach (var doc in Model.Take(5))
        {
                <text>{
                  "@@type": "MedicalClinic",
                  "name": "@doc.Department Department",
                  "medicalSpecialty": "@doc.Specialization"
                },</text>
        }
        {
          "@@type": "MedicalClinic",
          "name": "Emergency Department",
          "medicalSpecialty": "EmergencyMedicine"
        }
      ],
      "hasOfferCatalog": {
        "@@type": "OfferCatalog",
        "name": "Doctor Consultation Fees",
        "itemListElement": [
          @foreach (var doc in Model.Take(3))
          {
                <text>{
                  "@@type": "Offer",
                  "itemOffered": {
                    "@@type": "Service",
                    "name": "Consultation with Dr. @doc.FullName",
                    "description": "@doc.Specialization consultation at Sunrise Clinic Pabna",
                    "provider": {
                      "@@type": "Physician",
                      "name": "Dr. @doc.FullName",
                      "medicalSpecialty": "@doc.Specialization"
                    }
                  },
                  "price": "@doc.ConsultationFee",
                  "priceCurrency": "BDT",
                  "availability": "https://schema.org/InStock"
                },</text>
          }
          {
            "@@type": "Offer",
            "itemOffered": {
              "@@type": "Service",
              "name": "Emergency Consultation",
              "description": "24/7 Emergency doctor consultation at Sunrise Clinic"
            },
            "price": "1000",
            "priceCurrency": "BDT",
            "availability": "https://schema.org/InStock"
          }
        ]
      }
    }
</script>

<script type="application/ld+json">
    [
        @foreach (var doctor in Model)
        {
                <text>{
                  "@@context": "https://schema.org",
                  "@@type": "Physician",
                  "@@id": "@domain/Doctors/Details/@doctor.DoctorId",
                  "name": "Dr. @doctor.FullName",
                  "description": "Dr. @doctor.FullName - @doctor.Specialization specialist at Sunrise Clinic Pabna with @doctor.ExperienceYears+ years experience. @doctor.Qualification",
                  "url": "@domain/Doctors/Details/@doctor.DoctorId",
                  "image": "@domain/uploads/profile-pictures/@doctor.ProfilePicture",
                  "medicalSpecialty": "@doctor.Specialization",
                  "qualifications": "@doctor.Qualification",
                  "affiliation": {
                    "@@type": "MedicalClinic",
                    "name": "Sunrise Clinic & Diagnostic Center Pabna"
                  },
                  "memberOf": {
                    "@@type": "MedicalOrganization",
                    "name": "@doctor.Department Department"
                  },
                  "availableService": {
                    "@@type": "MedicalProcedure",
                    "name": "Medical Consultation",
                    "code": {
                      "@@type": "MedicalCode",
                      "codeValue": "CONSULT-@doctor.DoctorId",
                      "codingSystem": "Sunrise Clinic"
                    }
                  },
                  "priceRange": "৳@doctor.ConsultationFee",
                  "openingHours": "@doctor.AvailableDays"
                },</text>
        }
        {
          "@@context": "https://schema.org",
          "@@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@@type": "ListItem",
              "position": 1,
              "name": "Home",
              "item": "@domain/"
            },
            {
              "@@type": "ListItem",
              "position": 2,
              "name": "Doctors",
              "item": "@domain/Doctors"
            }
          ]
        }
    ]
</script>

<!-- SEO Meta Tags -->
<meta name="robots" content="index, follow">
<meta name="author" content="Sunrise Clinic Medical Team">
<meta name="geo.region" content="BD-RS">
<meta name="geo.placename" content="Pabna">
<meta property="og:type" content="website">
<meta property="og:url" content="@domain/Doctors">
<meta property="og:title" content="Expert Medical Doctors at Sunrise Clinic Pabna">
<meta property="og:description" content="Consult with specialist doctors at Sunrise Clinic Pabna. Cardiology, Gynecology, Pediatrics, Orthopedics, Dermatology specialists available.">
<meta property="og:image" content="@ViewData["Image"]">
<meta property="og:image:alt" content="Sunrise Clinic Doctors Team Pabna">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Best Doctors in Pabna - Sunrise Clinic">
<meta name="twitter:description" content="Medical specialists at Sunrise Clinic Pabna with 10+ years experience.">

<!-- Hero -->
<section class="hero-section-do" id="ourDoctors" itemscope itemtype="https://schema.org/MedicalClinic">
    <div class="container">
        <div class="hero-content">
            <h1 class="hero-title-do" itemprop="name">Best Medical Doctors in Pabna - Sunrise Clinic Specialist Team</h1>
            <p class="hero-subtitle-do" itemprop="description">Board-certified physicians and specialist doctors with 10+ years experience. Consultation starting from ₹500 at Sunrise Clinic diagnostic center.</p>
            <div class="hero-stats">
                <span class="stat-badge">
                    <i class="fas fa-user-md"></i> @totalDoctors Expert Doctors Available
                </span>
                <span class="stat-badge">
                    <i class="fas fa-stethoscope"></i> @specializations.Count Specializations
                </span>
                <span class="stat-badge">
                    <i class="fas fa-clock"></i> 24/7 Emergency Doctors
                </span>
            </div>

            <!-- SEO Enhanced Micro-content -->
            <div class="seo-micro-content mt-4" style="background: rgba(255,255,255,0.1); padding: 15px; border-radius: 10px; font-size: 0.9rem;">
                <div class="row">
                    <div class="col-md-4 text-center">
                        <i class="fas fa-rupee-sign me-1"></i>
                        <strong>Consultation Fee: ₹500+</strong>
                    </div>
                    <div class="col-md-4 text-center">
                        <i class="fas fa-graduation-cap me-1"></i>
                        <strong>MBBS, MD, FCPS Doctors</strong>
                    </div>
                    <div class="col-md-4 text-center">
                        <i class="fas fa-map-marker-alt me-1"></i>
                        <strong>Pabna Diagnostic Center</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Doctors Grid -->
<section class="doctors-section">
    <div class="container">
        <!-- SEO Header for Doctors List -->
        <div class="seo-header mb-5 text-center">
            <h2 class="h3" style="color: #1a73e8;">Specialist Doctors at Sunrise Clinic Pabna</h2>
            <p class="text-muted">Find the right medical specialist for your health needs. All our doctors are verified and experienced in their fields.</p>

            <!-- Department Filter for SEO -->
            <div class="department-tags mt-3">
                @foreach (var dept in Model.Select(d => d.Department).Distinct().Take(6))
                {
                    <span class="badge bg-light text-dark me-2 mb-2 p-2">
                        <i class="fas fa-hospital me-1"></i> @dept Department
                    </span>
                }
            </div>
        </div>

        @if (Model.Any())
        {
            <div class="doctors-grid" itemscope itemtype="https://schema.org/ItemList">
                @{
                    int position = 1;
                }
                @foreach (var doctor in Model)
                {
                    <div class="doctor-card" itemprop="itemListElement" itemscope itemtype="https://schema.org/Physician">
                        <meta itemprop="position" content="@position" />
                        <meta itemprop="url" content="@domain/Doctors/Details/@doctor.DoctorId" />

                        <!-- Profile Image -->
                        <div class="doctor-image">
                            <img src="~/uploads/profile-pictures/@doctor.ProfilePicture"
                                 alt="Dr. @doctor.FullName - @doctor.Specialization Specialist at Sunrise Clinic Pabna"
                                 title="Dr. @doctor.FullName - @doctor.Specialization Doctor"
                                 itemprop="image"
                                 onerror="this.src='https://via.placeholder.com/400x300/1a73e8/ffffff?text=Dr.@Uri.EscapeDataString(doctor.FullName)'">
                            <div class="experience-badge" itemprop="experienceYears">@doctor.ExperienceYears+ Years Experience</div>
                        </div>

                        <!-- Info -->
                        <div class="doctor-info">
                            <h3 class="doctor-name" itemprop="name">
                                <span itemprop="honorificPrefix">Dr.</span>
                                <span itemprop="givenName">@doctor.FullName</span>
                            </h3>
                            <p class="doctor-specialization" itemprop="medicalSpecialty">@doctor.Specialization Specialist</p>

                            <div class="doctor-details">
                                <div class="detail-item" itemprop="qualifications">
                                    <i class="fas fa-graduation-cap"></i>
                                    <span>@doctor.Qualification</span>
                                </div>
                                <div class="detail-item" itemprop="memberOf">
                                    <i class="fas fa-building"></i>
                                    <span>@doctor.Department Department</span>
                                </div>
                                <div class="detail-item" itemprop="openingHours">
                                    <i class="fas fa-clock"></i>
                                    <span>Available: @doctor.AvailableDays</span>
                                </div>
                            </div>

                            <!-- Fee & Actions -->
                            <div class="doctor-footer text-center">
                                <div class="fee px-2" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                                    <span class="fee-amount" itemprop="price">৳@doctor.ConsultationFee.ToString("0")</span>
                                    <span class="fee-label" itemprop="priceCurrency">Consultation Fee</span>
                                    <meta itemprop="availability" content="https://schema.org/InStock" />
                                </div>
                                <div class="actions">
                                    <!-- Details Link Fixed Here -->
                                    <a href="@Url.Action("Details", "Doctors", new { id = doctor.DoctorId })"
                                       class="btn-view"
                                       aria-label="View profile of Dr. @doctor.FullName"
                                       title="View Dr. @doctor.FullName's complete profile">
                                        <i class="fas fa-eye"></i> View Profile
                                    </a>
                                    @if (User.Identity?.IsAuthenticated == true && Context.Session.GetString("UserType") == "Patient")
                                    {
                                        <a href="/Appointment/Create?doctorId=@doctor.DoctorId"
                                           class="btn-book"
                                           aria-label="Book appointment with Dr. @doctor.FullName"
                                           title="Book appointment with Dr. @doctor.FullName">
                                            <i class="fas fa-calendar-plus"> </i> Book Now
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="/Account/Login?returnUrl=/Doctors"
                                           class="btn-book"
                                           aria-label="Login to book appointment with Dr. @doctor.FullName">
                                            <i class="fas fa-calendar-plus"> </i> Book Now
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    position++;
                }
            </div>

            <!-- SEO Rich Snippet Content -->
            <div class="seo-content-section mt-5 p-4 bg-light rounded">
                <h3 class="h4 mb-3">Why Choose Sunrise Clinic Doctors in Pabna?</h3>
                <div class="row">
                    <div class="col-md-6">
                        <ul class="seo-list">
                            <li><i class="fas fa-check-circle text-success me-2"></i> All doctors are MBBS, MD, FCPS certified</li>
                            <li><i class="fas fa-check-circle text-success me-2"></i> 10+ years average experience</li>
                            <li><i class="fas fa-check-circle text-success me-2"></i> Available for in-person and telemedicine</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <ul class="seo-list">
                            <li><i class="fas fa-check-circle text-success me-2"></i> Same-day appointment available</li>
                            <li><i class="fas fa-check-circle text-success me-2"></i> Transparent consultation fees</li>
                            <li><i class="fas fa-check-circle text-success me-2"></i> Digital prescription and reports</li>
                        </ul>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="no-doctors">
                <i class="fas fa-user-md"></i>
                <h3>No Doctors Available at the Moment</h3>
                <p>Our doctors list is currently being updated. Please check back soon or contact our reception.</p>
                <a href="/" class="btn-home">
                    <i class="fas fa-home"></i> Back to Homepage
                </a>
            </div>
        }
    </div>
</section>

<!-- Stats -->
<section class="stats-section" itemscope itemtype="https://schema.org/MedicalClinic">
    <div class="container">
        <div class="stats-grid">
            <div class="stat-item" itemprop="employee" itemscope itemtype="https://schema.org/Physician">
                <h2 itemprop="numberOfEmployees">@totalDoctors</h2>
                <p>Expert Medical Doctors</p>
                <meta itemprop="description" content="Specialist doctors at Sunrise Clinic Pabna" />
            </div>
            <div class="stat-item">
                <h2>24/7</h2>
                <p>Emergency Doctors Available</p>
            </div>
            <div class="stat-item">
                <h2>5000+</h2>
                <p>Patients Successfully Treated</p>
            </div>
            <div class="stat-item">
                <h2 itemprop="numberOfSpecialties">@specializations.Count</h2>
                <p>Medical Specializations</p>
            </div>
        </div>
    </div>
</section>

<!-- FAQ Section for SEO -->
<div class="container mt-5 mb-5">
    <div class="seo-faq p-4 bg-white rounded shadow-sm">
        <h3 class="h4 mb-4 text-center">Frequently Asked Questions - Sunrise Clinic Doctors</h3>
        <div class="accordion" id="doctorsFAQ">
            <div class="accordion-item">
                <h4 class="accordion-header">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                        How to book appointment with doctors at Sunrise Clinic Pabna?
                    </button>
                </h4>
                <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#doctorsFAQ">
                    <div class="accordion-body">
                        You can book appointment online through our website or call +8801703452323. Walk-in appointments also available at our Pabna diagnostic center.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h4 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                        What is the consultation fee for doctors at Sunrise Clinic?
                    </button>
                </h4>
                <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#doctorsFAQ">
                    <div class="accordion-body">
                        Consultation fees start from ₹500 for general physicians and go up to ₹1500 for specialist doctors at our Pabna clinic.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h4 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                        Are telemedicine consultations available?
                    </button>
                </h4>
                <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#doctorsFAQ">
                    <div class="accordion-body">
                        Yes, many of our doctors offer telemedicine consultations. You can book online video consultation through our website.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "FAQPage",
          "mainEntity": [
            {
              "@@type": "Question",
              "name": "How to book appointment with doctors at Sunrise Clinic Pabna?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "You can book appointment online through our website or call +8801703452323. Walk-in appointments also available at our Pabna diagnostic center."
              }
            },
            {
              "@@type": "Question",
              "name": "What is the consultation fee for doctors at Sunrise Clinic?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Consultation fees start from ₹500 for general physicians and go up to ₹1500 for specialist doctors at our Pabna clinic."
              }
            },
            {
              "@@type": "Question",
              "name": "Are telemedicine consultations available?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Yes, many of our doctors offer telemedicine consultations. You can book online video consultation through our website."
              }
            }
          ]
        }
    </script>

    <script>
        // Simple hover effect enhancement
        document.querySelectorAll('.doctor-card').forEach(card => {
            card.addEventListener('mouseenter', () => {
                card.style.zIndex = '10';
            });
            card.addEventListener('mouseleave', () => {
                card.style.zIndex = '1';
            });
        });

        // Scroll to main on page load
        document.addEventListener('DOMContentLoaded', function() {
            const scrolltomain = document.getElementById('ourDoctors');
            if (scrolltomain) {
                scrolltomain.classList.add('scroll-target');
                scrolltomain.scrollIntoView({ behavior: 'smooth' });
            }

            // Track doctor profile views for SEO
            document.querySelectorAll('.btn-view').forEach(link => {
                link.addEventListener('click', function() {
                    const doctorName = this.closest('.doctor-card').querySelector('.doctor-name').textContent;
                    console.log('SEO: Doctor profile viewed:', doctorName);
                    // You can add Google Analytics event tracking here
                });
            });

            // Track appointment bookings
            document.querySelectorAll('.btn-book').forEach(link => {
                link.addEventListener('click', function() {
                    const doctorName = this.closest('.doctor-card').querySelector('.doctor-name').textContent;
                    console.log('SEO: Appointment booking for doctor:', doctorName);
                    // You can add Google Analytics event tracking here
                });
            });
        });

    </script>
}