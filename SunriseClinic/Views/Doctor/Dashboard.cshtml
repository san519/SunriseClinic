@{
    ViewData["Title"] = "Doctor Dashboard";
    var doctor = ViewBag.Doctor as dynamic;
    var todaysAppointments = ViewBag.TodaysAppointments as List<dynamic>;
    var upcomingAppointments = ViewBag.UpcomingAppointments as List<dynamic>;
    var stats = ViewBag.Stats as dynamic;
    var recentPatients = ViewBag.RecentPatients as List<dynamic>;

    var userId = Context.Session.GetString("UserId");
    var displayId = Context.Session.GetString("DisplayId");
}

<div id="doctorDashboard">

    <div class="container-fluid py-3">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-lg-3">
                @await Html.PartialAsync("_DoctorSidebar")
            </div>

            <!-- Main Content -->
            <div class="col-lg-9">
                <!-- Welcome Card -->
                <div class="card border-0 shadow-sm mb-4 bg-primary text-white">
                    <div class="card-body p-4">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <h3 class="mb-2">Welcome, Dr. @doctor?.FullName!</h3>
                                <p class="mb-0 opacity-90">
                                    <i class="fas fa-stethoscope me-2"></i>
                                    @doctor?.Specialization
                                </p>
                                <p class="mb-0 opacity-75">
                                    <i class="fas fa-id-card me-2"></i>
                                    Doctor ID: @displayId
                                </p>
                            </div>
                            <div class="col-md-4 text-end">
                                <i class="fas fa-user-md fa-4x opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Stats Cards -->
                <div class="row mb-4">
                    <div class="col-md-3 col-6 mb-3">
                        <div class="card border-0 shadow-sm h-100 bg-info text-white">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h5 class="mb-1">@stats?.TotalPatients</h5>
                                        <p class="mb-0 small">Total Patients</p>
                                    </div>
                                    <i class="fas fa-users fa-2x opacity-50"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6 mb-3">
                        <div class="card border-0 shadow-sm h-100 bg-warning text-white">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h5 class="mb-1">@stats?.PendingAppointments</h5>
                                        <p class="mb-0 small">Pending</p>
                                    </div>
                                    <i class="fas fa-clock fa-2x opacity-50"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6 mb-3">
                        <div class="card border-0 shadow-sm h-100 bg-success text-white">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h5 class="mb-1">@stats?.ApprovedAppointments</h5>
                                        <p class="mb-0 small">Approved</p>
                                    </div>
                                    <i class="fas fa-check-circle fa-2x opacity-50"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6 mb-3">
                        <div class="card border-0 shadow-sm h-100 bg-secondary text-white">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h5 class="mb-1">@stats?.CompletedAppointments</h5>
                                        <p class="mb-0 small">Completed</p>
                                    </div>
                                    <i class="fas fa-calendar-check fa-2x opacity-50"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <!-- Today's Appointments -->
                    <div class="col-lg-6 mb-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-white border-0 py-3">
                                <h5 class="mb-0">
                                    <i class="fas fa-calendar-day me-2 text-primary"></i>Today's Appointments
                                </h5>
                            </div>
                            <div class="card-body p-0">
                                <!-- Today's Appointments section (ড্যাশবোর্ডে) -->
                                @if (todaysAppointments != null && todaysAppointments.Any())
                                {
                                    <div class="table-responsive">
                                        <table class="table table-hover mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Time</th>
                                                    <th>Patient</th>
                                                    <th>Blood Group</th>
                                                    <th>Status</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var appointment in todaysAppointments)
                                                {
                                                    <!-- ✅ Appointment Details page-এ redirect করার জন্য -->
                                                    <tr style="cursor: pointer;"
                                                        onclick="location.href='@Url.Action("Details", "Appointment", new { id = appointment.AppointmentId })'">
                                                        <td>
                                                            <div class="fw-semibold">@appointment.AppointmentTime</div>
                                                        </td>
                                                        <td>
                                                            <div class="fw-semibold">@appointment.PatientName</div>
                                                            <small class="text-muted">@appointment.Reason</small>
                                                        </td>
                                                        <td>@appointment.BloodGroup</td>
                                                        <td>
                                                            <span class="badge @(appointment.Status == "Approved" ? "bg-success" : "bg-warning")">
                                                                @appointment.Status
                                                            </span>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-5">
                                        <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
                                        <h6 class="text-muted">No appointments today</h6>
                                    </div>
                                }
                            </div>
                            <div class="card-footer bg-white border-0 py-3">
                                <a href="/Doctor/MyAppointments" class="text-decoration-none float-end">
                                    View All <i class="fas fa-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Recent Patients -->
                    <div class="col-lg-6 mb-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-white border-0 py-3">
                                <h5 class="mb-0">
                                    <i class="fas fa-user-injured me-2 text-success"></i>Recent Patients
                                </h5>
                            </div>
                            <div class="card-body p-0">
                                @if (recentPatients != null && recentPatients.Any())
                                {
                                    <div class="table-responsive">
                                        <table class="table table-hover mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Patient</th>
                                                    <th>Blood Group</th>
                                                    <th>Last Visit</th>
                                                    <th>Visits</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var patient in recentPatients)
                                                {
                                                    <tr style="cursor: pointer;"
                                                        onclick="location.href='/Doctor/PatientDetails/@patient.UserId'">
                                                        <td>
                                                            <div class="fw-semibold">@patient.FullName</div>
                                                        </td>
                                                        <td>@patient.BloodGroup</td>
                                                        <td>@patient.LastVisit</td>
                                                        <td>
                                                            <span class="badge bg-info">@patient.TotalVisits</span>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-5">
                                        <i class="fas fa-user-injured fa-3x text-muted mb-3"></i>
                                        <h6 class="text-muted">No patients yet</h6>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Upcoming Appointments -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-0 py-3">
                        <h5 class="mb-0">
                            <i class="fas fa-calendar-alt me-2 text-info"></i>Upcoming Appointments
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <!-- Upcoming Appointments section (ড্যাশবোর্ডে) -->
                        @if (upcomingAppointments != null && upcomingAppointments.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Date</th>
                                            <th>Time</th>
                                            <th>Patient</th>
                                            <th>Reason</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var appointment in upcomingAppointments)
                                        {
                                            <!-- ✅ Appointment Details page-এ redirect করার জন্য -->
                                            <tr style="cursor: pointer;"
                                                onclick="location.href='@Url.Action("Details", "Appointment", new { id = appointment.AppointmentId })'">
                                                <td>@appointment.AppointmentDate</td>
                                                <td>@appointment.AppointmentTime</td>
                                                <td>
                                                    <div class="fw-semibold">@appointment.PatientName</div>
                                                </td>
                                                <td>
                                                    <span class="d-inline-block text-truncate" style="max-width: 200px;">
                                                        @appointment.Reason
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="badge @(appointment.Status == "Approved" ? "bg-success" : "bg-warning")">
                                                        @appointment.Status
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
                                <h6 class="text-muted">No upcoming appointments</h6>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Scroll to main on page load
        document.addEventListener('DOMContentLoaded', function() {
            const scrolltomain = document.getElementById('doctorDashboard');
            if (scrolltomain) {
                scrolltomain.classList.add('scroll-target');
                scrolltomain.scrollIntoView({ behavior: 'smooth' });
            }
        });
    </script>
}