@model SunriseClinic.Models.DoctorProfileViewModel

@{
    ViewData["Title"] = "Doctor Profile";
}

<div id="doctorProfile">
    @await Html.PartialAsync("_MobileDashboardMenu")

    <div class="container-fluid py-3">
        <div class="row">
            <div class="col-lg-3">
                @await Html.PartialAsync("_DoctorSidebar")
            </div>

            <div class="col-lg-9">
                <!-- Page Header -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="mb-1">
                            <i class="fas fa-user-md me-2 text-primary"></i>Doctor Profile
                        </h3>
                        <p class="text-muted mb-0">Manage your professional information</p>
                    </div>
                </div>

                <!-- Success/Error Messages -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show mb-4">
                        <i class="fas fa-check-circle me-2"></i>
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show mb-4">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <!-- Profile Form -->
                <form asp-action="UpdateProfile" method="post" id="profileForm" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <!-- Profile Picture Section -->
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body p-4">
                            <div class="row align-items-center">
                                <div class="col-auto">
                                    <div class="position-relative d-inline-block">
                                        <!-- Profile Picture -->
                                        <img src="@Url.Content($"~/uploads/profile-pictures/{Model.ProfilePicture}")"
                                             class="rounded-circle profile-pic"
                                             width="150" height="150"
                                             alt="Profile Picture"
                                             id="profileImage"
                                             style="cursor: pointer; border: 3px solid #e9ecef; object-fit: cover;">

                                        <!-- Hidden File Input -->
                                        <input type="file" id="profilePictureInput" style="display:none;"
                                               accept="image/*" onchange="uploadProfilePicture(this)">
                                    </div>

                                    <!-- Popup Modal -->
                                    <div class="modal fade" id="picOptionsModal" tabindex="-1">
                                        <div class="modal-dialog modal-dialog-centered modal-sm">
                                            <div class="modal-content">
                                                <div class="modal-header py-2">
                                                    <h6 class="modal-title mb-0">Profile Picture</h6>
                                                    <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body p-0">
                                                    <div class="list-group list-group-flush">
                                                        <button type="button" class="list-group-item list-group-item-action border-0 py-3"
                                                                onclick="viewPicture()" data-bs-dismiss="modal">
                                                            <i class="fas fa-eye me-2 text-primary"></i>View Full Size
                                                        </button>
                                                        <button type="button" class="list-group-item list-group-item-action border-0 py-3"
                                                                onclick="changePicture()" data-bs-dismiss="modal">
                                                            <i class="fas fa-upload me-2 text-primary"></i>Change Picture
                                                        </button>
                                                        @if (Model.ProfilePicture != "default.jpg")
                                                        {
                                                            <button type="button" class="list-group-item list-group-item-action border-0 py-3 text-danger"
                                                                    onclick="removePicture()" data-bs-dismiss="modal">
                                                                <i class="fas fa-trash-alt me-2"></i>Remove Picture
                                                            </button>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col">
                                    <h4 class="mb-1">Dr. @Model.FullName</h4>
                                    <p class="text-muted mb-0">
                                        <i class="fas fa-envelope me-1"></i>
                                        @Model.Email
                                    </p>
                                    <p class="text-muted mb-0">
                                        <i class="fas fa-stethoscope me-1"></i>
                                        @Model.Specialization
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Personal Information -->
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="fas fa-user me-2 text-primary"></i>Personal Information
                            </h5>
                        </div>
                        <div class="card-body p-4">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="FullName" class="form-label fw-semibold">Full Name *</label>
                                    <input asp-for="FullName" class="form-control" required>
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="Email" class="form-label fw-semibold">Email Address *</label>
                                    <input asp-for="Email" type="email" class="form-control" required>
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="DateOfBirth" class="form-label fw-semibold">Date of Birth</label>
                                    <input asp-for="DateOfBirth" type="date" class="form-control">
                                    <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="Gender" class="form-label fw-semibold">Gender</label>
                                    <select asp-for="Gender" class="form-control">
                                        <option value="">Select Gender</option>
                                        <option value="M">Male</option>
                                        <option value="F">Female</option>
                                        <option value="O">Other</option>
                                    </select>
                                    <span asp-validation-for="Gender" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="PhoneNumber" class="form-label fw-semibold">Phone Number</label>
                                    <input asp-for="PhoneNumber" type="tel" class="form-control">
                                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="Address" class="form-label fw-semibold">Address</label>
                                    <input asp-for="Address" class="form-control">
                                    <span asp-validation-for="Address" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Professional Information -->
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="fas fa-briefcase-medical me-2 text-success"></i>Professional Information
                            </h5>
                        </div>
                        <div class="card-body p-4">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Specialization" class="form-label fw-semibold">Specialization *</label>
                                    <input asp-for="Specialization" class="form-control" required>
                                    <span asp-validation-for="Specialization" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="Qualification" class="form-label fw-semibold">Qualification *</label>
                                    <input asp-for="Qualification" class="form-control" required>
                                    <span asp-validation-for="Qualification" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="LicenseNumber" class="form-label fw-semibold">License Number *</label>
                                    <input asp-for="LicenseNumber" class="form-control" required>
                                    <span asp-validation-for="LicenseNumber" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="ConsultationFee" class="form-label fw-semibold">Consultation Fee *</label>
                                    <input asp-for="ConsultationFee" type="number" step="0.01" class="form-control" required>
                                    <span asp-validation-for="ConsultationFee" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="AvailableDays" class="form-label fw-semibold">Available Days *</label>
                                    <input asp-for="AvailableDays" class="form-control" placeholder="e.g., Mon-Fri, Sat-Sun" required>
                                    <span asp-validation-for="AvailableDays" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="AvailableTime" class="form-label fw-semibold">Available Time *</label>
                                    <input asp-for="AvailableTime" class="form-control" placeholder="e.g., 9:00 AM - 5:00 PM" required>
                                    <span asp-validation-for="AvailableTime" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="ExperienceYears" class="form-label fw-semibold">Experience (Years)</label>
                                    <input asp-for="ExperienceYears" type="number" class="form-control">
                                    <span asp-validation-for="ExperienceYears" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="Department" class="form-label fw-semibold">Department</label>
                                    <input asp-for="Department" class="form-control">
                                    <span asp-validation-for="Department" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-end gap-2">
                                <button type="reset" class="btn btn-secondary py-1 px-3 fs-6">
                                    <i class="fas fa-times me-2"></i>Reset
                                </button>
                                <button type="submit" class="btn btn-primary py-1 px-3 fs-6">
                                    <i class="fas fa-save me-2"></i>Save Changes
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Profile picture functionality
        document.getElementById('profileImage').addEventListener('click', function() {
            const modal = new bootstrap.Modal(document.getElementById('picOptionsModal'));
            modal.show();
        });

        function viewPicture() {
            const imgSrc = document.getElementById('profileImage').src;
            window.open(imgSrc, '_blank');
        }

        function changePicture() {
            document.getElementById('profilePictureInput').click();
        }

        function removePicture() {
            if (confirm('Are you sure you want to remove your profile picture?')) {
                fetch('/Doctor/RemoveProfilePicture', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const img = document.getElementById('profileImage');
                        img.src = '@Url.Content("~/uploads/profile-pictures/default.jpg")' + '?t=' + new Date().getTime();
                        showAlert('Profile picture removed', 'success');
                    }
                });
            }
        }

        function uploadProfilePicture(input) {
            if (input.files && input.files[0]) {
                const formData = new FormData();
                formData.append('profilePicture', input.files[0]);

                fetch('/Doctor/UpdateProfilePicture', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const img = document.getElementById('profileImage');
                        img.src = '@Url.Content("~/uploads/profile-pictures/")' + data.fileName + '?t=' + new Date().getTime();
                        showAlert('Profile picture updated', 'success');
                    }
                });
            }
        }

        function showAlert(message, type) {
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed top-0 end-0 m-3`;
            alertDiv.style.zIndex = '1060';
            alertDiv.innerHTML = `
                <i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'} me-2"></i>
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            document.body.appendChild(alertDiv);
            setTimeout(() => {
                if (alertDiv.parentNode) {
                    alertDiv.remove();
                }
            }, 3000);
        }

        // Scroll to main on page load
        document.addEventListener('DOMContentLoaded', function() {
            const scrolltomain = document.getElementById('doctorProfile');
            if (scrolltomain) {
                scrolltomain.classList.add('scroll-target');
                scrolltomain.scrollIntoView({ behavior: 'smooth' });
            }
        });
    </script>
}