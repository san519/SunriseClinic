@{
    ViewData["Title"] = "View Prescription";
    var prescription = Model as dynamic;
}

<div id="viewPrescription">
    @await Html.PartialAsync("_MobileDashboardMenu")

    <div class="container-fluid py-3">
        <div class="row">
            <div class="col-lg-3">
                @await Html.PartialAsync("_DoctorSidebar")
            </div>

            <div class="col-lg-9">
                <!-- Page Header -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="mb-1">
                            <i class="fas fa-prescription me-2 text-warning"></i>Prescription
                        </h3>
                        <p class="text-muted mb-0">View prescription details</p>
                    </div>
                    <a href="/Doctor/PatientDetails/@prescription.PatientId" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back to Patient
                    </a>
                </div>

                <!-- Prescription Details -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-4">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Prescription Date</label>
                                <p class="form-control-plaintext">@prescription.PrescriptionDate.ToString("dd-MMM-yyyy")</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Prescribed By</label>
                                <p class="form-control-plaintext">@prescription.PrescribedByName</p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Patient Name</label>
                                <p class="form-control-plaintext">@prescription.PatientName</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">File Type</label>
                                <p class="form-control-plaintext">
                                    @{
                                        var fileExtension = System.IO.Path.GetExtension(prescription.PrescriptionFile)?.ToLower();
                                        if (fileExtension == ".pdf")
                                        {
                                            <span class="badge bg-danger">PDF</span>
                                        }
                                        else if (fileExtension == ".jpg" || fileExtension == ".jpeg" || fileExtension == ".png")
                                        {
                                            <span class="badge bg-success">Image</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@fileExtension</span>
                                        }
                                    }
                                </p>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(prescription.Notes))
                        {
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Notes</label>
                                <div class="bg-light p-3 rounded">
                                    @prescription.Notes
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Prescription Preview -->
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-0 py-3">
                        <h5 class="mb-0">
                            <i class="fas fa-file-image me-2 text-info"></i>Prescription Preview
                        </h5>
                    </div>
                    <div class="card-body p-4 text-center">
                        @{
                            var fileExt = System.IO.Path.GetExtension(prescription.PrescriptionFile)?.ToLower();
                            if (fileExt == ".pdf")
                            {
                                <div class="mb-4">
                                    <i class="fas fa-file-pdf fa-5x text-danger mb-3"></i>
                                    <h5 class="text-muted mb-3">PDF Prescription</h5>
                                    <a href="/Prescription/Download/@prescription.PrescriptionId" class="btn btn-danger btn-lg">
                                        <i class="fas fa-download me-2"></i>Download PDF
                                    </a>
                                </div>
                            }
                            else if (fileExt == ".jpg" || fileExt == ".jpeg" || fileExt == ".png")
                            {
                                <img src="/uploads/prescriptions/@prescription.PrescriptionFile"
                                     alt="Prescription"
                                     class="img-fluid rounded shadow prescription-image"
                                     style="max-height: 600px; cursor: zoom-in;"
                                     onclick="zoomImage(this)">
                                <div class="mt-3">
                                    <small class="text-muted">Click on image to zoom in/out</small>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-5">
                                    <i class="fas fa-file-alt fa-5x text-muted mb-4"></i>
                                    <h5 class="text-muted mb-3">File Available</h5>
                                    <a href="/Prescription/Download/@prescription.PrescriptionId" class="btn btn-secondary">
                                        <i class="fas fa-download me-2"></i>Download File
                                    </a>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Zoom Modal -->
<div class="modal fade" id="zoomModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content border-0">
            <div class="modal-header border-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0 text-center">
                <img src="" alt="Zoomed Prescription" class="img-fluid" id="zoomedImage">
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Image zoom functionality
        function zoomImage(img) {
            const zoomModal = new bootstrap.Modal(document.getElementById('zoomModal'));
            const zoomedImage = document.getElementById('zoomedImage');

            zoomedImage.src = img.src;
            zoomModal.show();
        }

        // Scroll to main on page load
        document.addEventListener('DOMContentLoaded', function() {
            const scrolltomain = document.getElementById('viewPrescription');
            if (scrolltomain) {
                scrolltomain.classList.add('scroll-target');
                scrolltomain.scrollIntoView({ behavior: 'smooth' });
            }
        });
    </script>
}