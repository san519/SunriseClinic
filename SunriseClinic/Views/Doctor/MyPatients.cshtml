@{
    ViewData["Title"] = "My Patients";
    var patients = ViewBag.Patients as List<dynamic>;
    var patientStats = ViewBag.PatientStats as dynamic;
}

<div id="myPatients">

    <div class="container-fluid py-3">
        <div class="row">
            <div class="col-lg-3">
                @await Html.PartialAsync("_DoctorSidebar")
            </div>

            <div class="col-lg-9">
                <!-- Page Header -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="mb-1">
                            <i class="fas fa-user-injured me-2 text-primary"></i>My Patients
                        </h3>
                        <p class="text-muted mb-0">All patients who have appointments with you</p>
                    </div>
                </div>

                <!-- Statistics Cards -->
                @if (patientStats != null)
                {
                    <div class="row mb-4">
                        <div class="col-md-2 col-6 mb-3">
                            <div class="card border-0 shadow-sm h-100 bg-primary text-white">
                                <div class="card-body p-3">
                                    <div class="text-center">
                                        <h4 class="mb-1">@patientStats.TotalPatients</h4>
                                        <p class="mb-0 small">Total Patients</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2 col-6 mb-3">
                            <div class="card border-0 shadow-sm h-100 bg-info text-white">
                                <div class="card-body p-3">
                                    <div class="text-center">
                                        <h4 class="mb-1">@patientStats.CompletedAppointments</h4>
                                        <p class="mb-0 small">Completed</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2 col-6 mb-3">
                            <div class="card border-0 shadow-sm h-100 bg-warning text-white">
                                <div class="card-body p-3">
                                    <div class="text-center">
                                        <h4 class="mb-1">@patientStats.AvgAge</h4>
                                        <p class="mb-0 small">Avg.Age</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Patients Table -->
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-0 py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                <i class="fas fa-users me-2 text-success"></i>Patient List
                            </h5>
                            <span class="badge bg-primary">@patients.Count Patients</span>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        @if (patients != null && patients.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Patient</th>
                                            <th>Age/Gender</th>
                                            <th>Medical Info</th>
                                            <th>Appointments</th>
                                            <th>Last Visit</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var patient in patients)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="fw-semibold">@patient.FullName</div>
                                                    <small class="text-muted">@patient.PhoneNumber</small>
                                                </td>
                                                <td>
                                                    <div>@patient.Age years</div>
                                                    <small class="text-muted">@patient.Gender</small>
                                                </td>
                                                <td>
                                                    <div class="small">
                                                        <span class="text-muted">Blood:</span> @patient.BloodGroup<br>
                                                        <span class="text-muted">Ht/Wt:</span> @patient.Height / @patient.Weight<br>
                                                        <span class="text-muted">BMI:</span> @patient.BMI
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="d-flex flex-column">
                                                        <span class="badge bg-primary mb-1">@patient.TotalVisits Appointments</span>
                                                        <small class="text-muted">First: @patient.FirstVisit</small>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="fw-semibold">@patient.LastVisit</div>
                                                    <small class="text-muted">@patient.CompletedVisits completed</small>
                                                </td>
                                                <td>
                                                    <a href="/Doctor/PatientDetails/@patient.UserId"
                                                       class="btn btn-sm btn-outline-primary" title="View Details">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="fas fa-user-injured fa-3x text-muted mb-3"></i>
                                <h6 class="text-muted">No patients found</h6>
                                <p class="text-muted">You don't have any patients yet.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const scrolltomain = document.getElementById('myPatients');
            if (scrolltomain) {
                scrolltomain.classList.add('scroll-target');
                scrolltomain.scrollIntoView({ behavior: 'smooth' });
            }
        });
    </script>
}