@{
    ViewData["Title"] = "Patient Details";
    var patient = ViewBag.Patient as dynamic;
    var appointments = ViewBag.Appointments as List<dynamic>;
    var medicalHistory = ViewBag.MedicalHistory as List<dynamic>;
    var testReports = ViewBag.TestReports as List<dynamic>;
    var prescriptions = ViewBag.Prescriptions as List<dynamic>;
}

<div id="patientDetails">

    <div class="container-fluid py-3">
        <div class="row">
            <div class="col-lg-3">
                @await Html.PartialAsync("_DoctorSidebar")
            </div>

            <div class="col-lg-9">
                <!-- Page Header -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="mb-1">
                            <i class="fas fa-user-injured me-2 text-primary"></i>Patient Details
                        </h3>
                        <p class="text-muted mb-0">Medical information for @patient?.FullName</p>
                    </div>
                    <a href="/Doctor/MyAppointments" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back
                    </a>
                </div>

                <!-- Patient Information Card with Profile Picture -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-0 py-3">
                        <h5 class="mb-0">
                            <i class="fas fa-info-circle me-2 text-info"></i>Patient Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <!-- Patient Profile Picture -->
                            <div class="col-md-3 text-center mb-4 mb-md-0">
                                <div class="position-relative d-inline-block">
                                    <img src="@Url.Content($"~/uploads/profile-pictures/{patient?.ProfilePicture}")" 
                                         class="rounded-circle border border-3 border-primary" 
                                         width="180" height="180" 
                                         alt="Patient Profile Picture"
                                         style="object-fit: cover;"
                                         onerror="this.src='@Url.Content("~/uploads/profile-pictures/default.webp")'">
                                    
                                    <!-- Profile Picture Badge -->
                                    <div class="position-absolute bottom-0 end-0">
                                        <span class="badge bg-primary rounded-pill p-2">
                                            <i class="fas fa-user-md"></i>
                                        </span>
                                    </div>
                                </div>
                                
                                <!-- Patient Name -->
                                <h5 class="mt-3 mb-1">@patient?.FullName</h5>
                                <p class="text-muted mb-0">
                                    <i class="fas fa-id-card me-1"></i>
                                    Patient ID: P@((100000 + patient?.UserId - 1000).ToString("D6"))
                                    
                                </p>
                                <p class="text-muted small">
                                    <i class="fas fa-calendar-alt me-1"></i>
                                    @patient?.Age years old
                                </p>
                            </div>

                            <!-- Patient Information -->
                            <div class="col-md-9">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-semibold">
                                            <i class="fas fa-birthday-cake me-1 text-info"></i> Date of Birth
                                        </label>
                                        <p class="form-control-plaintext">@patient?.DateOfBirth</p>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-semibold">
                                            <i class="fas fa-venus-mars me-1 text-info"></i> Gender
                                        </label>
                                        <p class="form-control-plaintext">@patient?.Gender</p>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-semibold">
                                            <i class="fas fa-tint me-1 text-danger"></i> Blood Group
                                        </label>
                                        <p class="form-control-plaintext">
                                            @if (!string.IsNullOrEmpty(patient?.BloodGroup) && patient?.BloodGroup != "Not set")
                                            {
                                                <span class="badge bg-danger">@patient?.BloodGroup</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Not set</span>
                                            }
                                        </p>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-semibold">
                                            <i class="fas fa-heart me-1 text-danger"></i> Marital Status
                                        </label>
                                        <p class="form-control-plaintext">@patient?.MaritalStatus</p>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label fw-semibold">
                                            <i class="fas fa-ruler-vertical me-1 text-success"></i> Height
                                        </label>
                                        <p class="form-control-plaintext">@patient?.Height</p>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label fw-semibold">
                                            <i class="fas fa-weight me-1 text-success"></i> Weight
                                        </label>
                                        <p class="form-control-plaintext">@patient?.Weight</p>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label fw-semibold">
                                            <i class="fas fa-heartbeat me-1 text-success"></i> BMI
                                        </label>
                                        <p class="form-control-plaintext">
                                            @if (patient?.BMI != "N/A")
                                            {
                                                <span class="badge 
                                                    @(Convert.ToDouble(patient?.BMI) < 18.5 ? "bg-info" :
                                                      Convert.ToDouble(patient?.BMI) < 25 ? "bg-success" :
                                                      Convert.ToDouble(patient?.BMI) < 30 ? "bg-warning" : "bg-danger")">
                                                    @patient?.BMI
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">N/A</span>
                                            }
                                        </p>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-semibold">
                                            <i class="fas fa-phone me-1 text-primary"></i> Phone Number
                                        </label>
                                        <p class="form-control-plaintext">@patient?.PhoneNumber</p>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label fw-semibold">
                                            <i class="fas fa-phone-alt me-1 text-warning"></i> Emergency Contact
                                        </label>
                                        <p class="form-control-plaintext">@patient?.EmergencyContact</p>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-12 mb-3">
                                        <label class="form-label fw-semibold">
                                            <i class="fas fa-envelope me-1 text-primary"></i> Email
                                        </label>
                                        <p class="form-control-plaintext">@patient?.Email</p>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-12">
                                        <label class="form-label fw-semibold">
                                            <i class="fas fa-map-marker-alt me-1 text-primary"></i> Address
                                        </label>
                                        <p class="form-control-plaintext">@patient?.Address</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Medical History Section -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-0 py-3">
                        <h5 class="mb-0">
                            <i class="fas fa-file-medical me-2 text-success"></i>Medical History
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        @if (medicalHistory != null && medicalHistory.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Disease</th>
                                            <th>Diagnosed Date</th>
                                            <th>Status</th>
                                            <th>Notes</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var history in medicalHistory)
                                        {
                                            <tr>
                                                <td>@history.DiseaseName</td>
                                                <td>@history.DiagnosedDate</td>
                                                <td>
                                                    <span class="badge
                                                        @(history.Status == "Active" ? "bg-danger" :
                                                          history.Status == "Recovered" ? "bg-success" :
                                                          history.Status == "Chronic" ? "bg-warning" : "bg-info")">
                                                        @history.Status
                                                    </span>
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(history.Notes))
                                                    {
                                                        <span class="d-inline-block text-truncate" style="max-width: 200px;">
                                                            @history.Notes
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">No notes</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="fas fa-file-medical-alt fa-3x text-muted mb-3"></i>
                                <h6 class="text-muted">No medical history recorded</h6>
                            </div>
                        }
                    </div>
                </div>

                <!-- Rest of the code remains same -->
                <!-- Test Reports Section -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-0 py-3">
                        <h5 class="mb-0">
                            <i class="fas fa-file-pdf me-2 text-danger"></i>Test Reports
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        @if (testReports != null && testReports.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Report Name</th>
                                            <th>Date</th>
                                            <th>Notes</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var report in testReports)
                                        {
                                            <tr>
                                                <td>@report.ReportName</td>
                                                <td>@report.ReportDate</td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(report.Notes))
                                                    {
                                                        <span class="d-inline-block text-truncate" style="max-width: 200px;">
                                                            @report.Notes
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">No notes</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (report.FileExists)
                                                    {
                                                        <a href="/Doctor/ViewReport/@report.ReportId"
                                                           class="btn btn-sm btn-outline-danger" title="View Report">
                                                            <i class="fas fa-eye"></i>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">No File</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="fas fa-file-alt fa-3x text-muted mb-3"></i>
                                <h6 class="text-muted">No test reports available</h6>
                            </div>
                        }
                    </div>
                </div>

                <!-- Prescriptions Section -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-0 py-3">
                        <h5 class="mb-0">
                            <i class="fas fa-prescription-bottle-alt me-2 text-warning"></i>Prescriptions
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        @if (prescriptions != null && prescriptions.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Date</th>
                                            <th>Prescribed By</th>
                                            <th>Notes</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var prescription in prescriptions)
                                        {
                                            <tr>
                                                <td>@prescription.PrescriptionDate</td>
                                                <td>@prescription.PrescribedByName</td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(prescription.Notes))
                                                    {
                                                        <span class="d-inline-block text-truncate" style="max-width: 200px;">
                                                            @prescription.Notes
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">No notes</span>
                                                    }
                                                </td>
                                                <td>
                                                    <a href="/Doctor/ViewPrescription/@prescription.PrescriptionId"
                                                       class="btn btn-sm btn-outline-warning" title="View Prescription">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="fas fa-prescription-bottle fa-3x text-muted mb-3"></i>
                                <h6 class="text-muted">No prescriptions available</h6>
                            </div>
                        }
                    </div>
                </div>

                <!-- Appointments History Section -->
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-0 py-3">
                        <h5 class="mb-0">
                            <i class="fas fa-history me-2 text-info"></i>Appointments History with You
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        @if (appointments != null && appointments.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Date</th>
                                            <th>Time</th>
                                            <th>Reason</th>
                                            <th>Symptoms</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var appointment in appointments)
                                        {
                                            <tr>
                                                <td>@appointment.AppointmentDate</td>
                                                <td>@appointment.AppointmentTime</td>
                                                <td>
                                                    <span class="d-inline-block text-truncate" style="max-width: 150px;">
                                                        @appointment.Reason
                                                    </span>
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(appointment.Symptoms))
                                                    {
                                                        <span class="d-inline-block text-truncate" style="max-width: 150px;">
                                                            @appointment.Symptoms
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">None</span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="badge
                                                        @(appointment.Status == "Completed" ? "bg-success" :
                                                          appointment.Status == "Approved" ? "bg-info" :
                                                          appointment.Status == "Cancelled" ? "bg-danger" : "bg-warning")">
                                                        @appointment.Status
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
                                <h6 class="text-muted">No previous appointments</h6>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        /* Additional styling for better appearance */
        .profile-picture-container {
            position: relative;
            display: inline-block;
        }
        
        .profile-badge {
            position: absolute;
            bottom: 10px;
            right: 10px;
            background: rgba(13, 110, 253, 0.8);
            color: white;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 3px solid white;
        }
        
        .info-icon {
            width: 20px;
            text-align: center;
            margin-right: 8px;
        }
        
        .bmi-badge {
            font-size: 0.9rem;
            padding: 0.25rem 0.5rem;
        }
    </style>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const scrolltomain = document.getElementById('patientDetails');
            if (scrolltomain) {
                scrolltomain.classList.add('scroll-target');
                scrolltomain.scrollIntoView({ behavior: 'smooth' });
            }
            
            // Profile picture fallback
            document.querySelectorAll('img').forEach(img => {
                img.addEventListener('error', function() {
                    this.src = '@Url.Content("~/uploads/profile-pictures/default.webp")';
                });
            });
        });
    </script>
}