@{
    ViewData["Title"] = "Patient Details";
    var patient = ViewBag.Patient as dynamic;
    var appointments = ViewBag.Appointments as List<dynamic>;
    var medicalHistory = ViewBag.MedicalHistory as List<dynamic>;
    var testReports = ViewBag.TestReports as List<dynamic>;
    var prescriptions = ViewBag.Prescriptions as List<dynamic>;
}

<div id="patientDetails">
    @await Html.PartialAsync("_MobileDashboardMenu")

    <div class="container-fluid py-3">
        <div class="row">
            <div class="col-lg-3">
                @await Html.PartialAsync("_DoctorSidebar")
            </div>

            <div class="col-lg-9">
                <!-- Page Header -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="mb-1">
                            <i class="fas fa-user-injured me-2 text-primary"></i>Patient Details
                        </h3>
                        <p class="text-muted mb-0">Medical information for @patient?.FullName</p>
                    </div>
                    <a href="/Doctor/MyAppointments" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back
                    </a>
                </div>

                <!-- Patient Information Card -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-0 py-3">
                        <h5 class="mb-0">
                            <i class="fas fa-info-circle me-2 text-info"></i>Patient Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-semibold">Full Name</label>
                                <p class="form-control-plaintext">@patient?.FullName</p>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-semibold">Date of Birth</label>
                                <p class="form-control-plaintext">@patient?.DateOfBirth</p>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-semibold">Age</label>
                                <p class="form-control-plaintext">@patient?.Age years</p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-semibold">Gender</label>
                                <p class="form-control-plaintext">@patient?.Gender</p>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-semibold">Blood Group</label>
                                <p class="form-control-plaintext">@patient?.BloodGroup</p>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-semibold">Marital Status</label>
                                <p class="form-control-plaintext">@patient?.MaritalStatus</p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-semibold">Height</label>
                                <p class="form-control-plaintext">@patient?.Height</p>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-semibold">Weight</label>
                                <p class="form-control-plaintext">@patient?.Weight</p>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-semibold">BMI</label>
                                <p class="form-control-plaintext">@patient?.BMI</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Medical History -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-0 py-3">
                        <h5 class="mb-0">
                            <i class="fas fa-file-medical me-2 text-success"></i>Medical History
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        @if (medicalHistory != null && medicalHistory.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Disease</th>
                                            <th>Diagnosed Date</th>
                                            <th>Status</th>
                                            <th>Notes</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var history in medicalHistory)
                                        {
                                            <tr>
                                                <td>@history.DiseaseName</td>
                                                <td>@history.DiagnosedDate</td>
                                                <td>
                                                    <span class="badge
                                                                @(history.Status == "Active" ? "bg-danger" :
                                                                                                                    history.Status == "Recovered" ? "bg-success" :
                                                                                                                    history.Status == "Chronic" ? "bg-warning" : "bg-info")">
                                                @history.Status
                                            </span>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(history.Notes))
                                                    {
                                                        <span class="d-inline-block text-truncate" style="max-width: 200px;">
                                                            @history.Notes
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">No notes</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="fas fa-file-medical-alt fa-3x text-muted mb-3"></i>
                                <h6 class="text-muted">No medical history recorded</h6>
                            </div>
                        }
                    </div>
                </div>

                <!-- Test Reports -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-0 py-3">
                        <h5 class="mb-0">
                            <i class="fas fa-file-pdf me-2 text-danger"></i>Test Reports
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        @if (testReports != null && testReports.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Report Name</th>
                                            <th>Date</th>
                                            <th>Notes</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var report in testReports)
                                        {
                                            <tr>
                                                <td>@report.ReportName</td>
                                                <td>@report.ReportDate</td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(report.Notes))
                                                    {
                                                        <span class="d-inline-block text-truncate" style="max-width: 200px;">
                                                            @report.Notes
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">No notes</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (report.FileExists)
                                                    {
                                                        <a href="/Doctor/ViewReport/@report.ReportId"
                                                           class="btn btn-sm btn-outline-danger" title="View Report">
                                                            <i class="fas fa-eye"></i>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">No File</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="fas fa-file-alt fa-3x text-muted mb-3"></i>
                                <h6 class="text-muted">No test reports available</h6>
                            </div>
                        }
                    </div>
                </div>

                <!-- Prescriptions -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-0 py-3">
                        <h5 class="mb-0">
                            <i class="fas fa-prescription-bottle-alt me-2 text-warning"></i>Prescriptions
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        @if (prescriptions != null && prescriptions.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Date</th>
                                            <th>Prescribed By</th>
                                            <th>Notes</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var prescription in prescriptions)
                                        {
                                            <tr>
                                                <td>@prescription.PrescriptionDate</td>
                                                <td>@prescription.PrescribedByName</td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(prescription.Notes))
                                                    {
                                                        <span class="d-inline-block text-truncate" style="max-width: 200px;">
                                                            @prescription.Notes
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">No notes</span>
                                                    }
                                                </td>
                                                <td>
                                                    <a href="/Doctor/ViewPrescription/@prescription.PrescriptionId"
                                                       class="btn btn-sm btn-outline-warning" title="View Prescription">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="fas fa-prescription-bottle fa-3x text-muted mb-3"></i>
                                <h6 class="text-muted">No prescriptions available</h6>
                            </div>
                        }
                    </div>
                </div>

                <!-- Appointments History -->
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-0 py-3">
                        <h5 class="mb-0">
                            <i class="fas fa-history me-2 text-info"></i>Appointments History with You
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        @if (appointments != null && appointments.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Date</th>
                                            <th>Time</th>
                                            <th>Reason</th>
                                            <th>Symptoms</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var appointment in appointments)
                                        {
                                            <tr>
                                                <td>@appointment.AppointmentDate</td>
                                                <td>@appointment.AppointmentTime</td>
                                                <td>
                                                    <span class="d-inline-block text-truncate" style="max-width: 150px;">
                                                        @appointment.Reason
                                                    </span>
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(appointment.Symptoms))
                                                    {
                                                        <span class="d-inline-block text-truncate" style="max-width: 150px;">
                                                            @appointment.Symptoms
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">None</span>
                                                    }
                                            </td>
                                            <td>
                                                <span class="badge
                                                            @(appointment.Status == "Completed" ? "bg-success" :
                                                                                                                appointment.Status == "Approved" ? "bg-info" :
                                                                                                                appointment.Status == "Cancelled" ? "bg-danger" : "bg-warning")">
                                                @appointment.Status
                                            </span>
                                        </td>
                                    </tr>
                                                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
                                <h6 class="text-muted">No previous appointments</h6>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const scrolltomain = document.getElementById('patientDetails');
            if (scrolltomain) {
                scrolltomain.classList.add('scroll-target');
                scrolltomain.scrollIntoView({ behavior: 'smooth' });
            }
        });
    </script>
}