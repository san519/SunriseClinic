@model SunriseClinic.Models.Appointment
@{
    ViewData["Title"] = "Appointment Details";
    var userId = Context.Session.GetString("UserId");
    var userType = Context.Session.GetString("UserType");
    var displayId = Context.Session.GetString("DisplayId");
    // **Profile picture variables**
    var patientProfilePicture = ViewBag.PatientProfilePicture as string ?? "default.jpg";
    var doctorProfilePicture = ViewBag.DoctorProfilePicture as string ?? "default.jpg";
    var currentProfilePicture = userType == "Patient" ? patientProfilePicture : doctorProfilePicture;
}

<div id="appointmentDetails">
    @await Html.PartialAsync("_MobileDashboardMenu")

    <div class="container-fluid py-3">
        <div class="row">
            <div class="col-lg-3">
                @if (userType == "Patient")
                {
                    @await Html.PartialAsync("_PatientSidebar", new { ProfilePicture = currentProfilePicture })
                }
                else if (userType == "Doctor")
                {
                    @await Html.PartialAsync("_DoctorSidebar", new { ProfilePicture = currentProfilePicture })
                }
            </div>

            <div class="col-lg-9">
                <div class="card shadow-lg border-0">
                    <div class="card-header bg-primary text-light py-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h2 class="h4 mb-0">Appointment Details</h2>
                                <p class="mb-0 opacity-75">ID: AP@(Model.AppointmentId.ToString("D6"))</p>
                            </div>
                            <div>
                                @if (userType == "Patient" && Model.Status != "Cancelled" && Model.Status != "Completed")
                                {
                                    <button type="button" class="btn btn-outline-light" data-bs-toggle="modal" data-bs-target="#cancelModal">
                                        <i class="fas fa-times me-1"></i>Cancel Appointment
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="card-body p-5">
                        <!-- Display messages -->
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show mb-4">
                                <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }

                        @if (TempData["ErrorMessage"] != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show mb-4">
                                <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }

                        <div class="row">
                            <!-- Appointment Info -->
                            <div class="col-md-6 mb-4">
                                <h5 class="text-primary mb-3 border-bottom pb-2">
                                    <i class="fas fa-info-circle me-2"></i>Appointment Information
                                </h5>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Appointment ID</label>
                                    <div class="form-control bg-light">AP@(Model.AppointmentId.ToString("D6"))</div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Date & Time</label>
                                    <div class="form-control bg-light">
                                        @Model.AppointmentDate.ToString("dddd, dd MMMM yyyy") at @Model.AppointmentTime.ToString(@"hh\:mm") @(Model.AppointmentTime.Hours < 12 ? "AM" : "PM")
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Status</label>
                                    <div>
                                        <span class="badge @Model.StatusBadgeClass fs-6 px-3 py-2">
                                            @Model.Status
                                        </span>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Reason</label>
                                    <div class="form-control bg-light min-height-100">@Model.Reason</div>
                                </div>

                                @if (!string.IsNullOrEmpty(Model.Symptoms))
                                {
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Symptoms</label>
                                        <div class="form-control bg-light min-height-80">@Model.Symptoms</div>
                                    </div>
                                }

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Type</label>
                                    <div class="form-control bg-light">
                                        @if (Model.IsEmergency)
                                        {
                                            <span class="text-danger fw-bold">
                                                <i class="fas fa-exclamation-triangle me-1"></i>EMERGENCY
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-success">Regular</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Doctor & Patient Info -->
                            <div class="col-md-6 mb-4">
                                <h5 class="text-primary mb-3 border-bottom pb-2">
                                    <i class="fas fa-user-md me-2"></i>Doctor Information
                                </h5>

                                <div class="card border-0 shadow-sm mb-4">
                                    <div class="card-body">
                                        <h6 class="card-title">Dr. @Model.DoctorName</h6>
                                        <p class="card-text text-muted">
                                            <i class="fas fa-stethoscope me-1"></i>@Model.DoctorSpecialization
                                        </p>
                                    </div>
                                </div>

                                <h5 class="text-primary mb-3 border-bottom pb-2 mt-4">
                                    <i class="fas fa-user-injured me-2"></i>Patient Information
                                </h5>

                                <div class="card border-0 shadow-sm">
                                    <div class="card-body">
                                        <h6 class="card-title">@Model.PatientName</h6>
                                        <p class="card-text text-muted">
                                            <i class="fas fa-id-card me-1"></i>Patient ID: @displayId
                                        </p>
                                    </div>
                                </div>

                                <!-- Appointment Timeline -->
                                <div class="mt-4">
                                    <h5 class="text-primary mb-3 border-bottom pb-2">
                                        <i class="fas fa-history me-2"></i>Appointment Timeline
                                    </h5>
                                    <ul class="list-group list-group-flush">
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span>Created</span>
                                            <span class="text-muted">@Model.CreatedAt.ToString("dd MMM yyyy hh:mm tt")</span>
                                        </li>
                                        @if (Model.UpdatedAt.HasValue)
                                        {
                                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                                <span>Last Updated</span>
                                                <span class="text-muted">@Model.UpdatedAt.Value.ToString("dd MMM yyyy hh:mm tt")</span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <!-- All Buttons Same Style -->
                        <div class="mt-4 pt-4 border-top">
                            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                                <!-- Left: Back -->
                                <div>
                                    <a href="/Appointment/MyAppointments" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                        <i class="fas fa-arrow-left me-1"></i>
                                        <span>Back</span>
                                    </a>
                                </div>

                                <!-- Right: Actions (if applicable) -->
                                @if (userType == "Patient" && Model.Status == "Pending")
                                {
                                    <div class="d-flex gap-2">
                                        <a href="/Appointment/Create" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                            <i class="fas fa-plus me-1"></i>
                                            <span>New</span>
                                        </a>

                                        <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3"
                                                data-bs-toggle="modal" data-bs-target="#cancelModal">
                                            <i class="fas fa-times me-1"></i>
                                            <span>Cancel</span>
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Cancel Appointment Modal -->
@if (userType == "Patient")
{
    <div class="modal fade" id="cancelModal" tabindex="-1" aria-labelledby="cancelModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-light">
                    <h5 class="modal-title" id="cancelModalLabel">
                        <i class="fas fa-exclamation-triangle me-2"></i>Cancel Appointment
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to cancel this appointment?</p>
                    <div class="alert alert-warning">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Note:</strong> Appointments can only be cancelled at least 2 hours before the scheduled time.
                    </div>
                    <p>Appointment Date: <strong>@Model.AppointmentDate.ToString("dd MMM yyyy")</strong></p>
                    <p>Time: <strong>@Model.AppointmentTime.ToString(@"hh\:mm") @(Model.AppointmentTime.Hours < 12 ? "AM" : "PM")</strong></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No, Keep It</button>
                    <form asp-action="Cancel" asp-route-id="@Model.AppointmentId" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">Yes, Cancel Appointment</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Styles {
    <style>
        .min-height-100 {
            min-height: 100px;
        }

        .min-height-80 {
            min-height: 80px;
        }

        .scroll-target {
            scroll-margin-top: 20px;
        }
    </style>
}

@section Scripts {
    <script>
        // Scroll to Main on page load
        document.addEventListener('DOMContentLoaded', function() {
            const scrolltomain = document.getElementById('appointmentDetails');
            if (scrolltomain) {
                scrolltomain.classList.add('scroll-target');
                scrolltomain.scrollIntoView({ behavior: 'smooth' });
            }

            // Cancel appointment validation
            const cancelForm = document.querySelector('form[asp-action="Cancel"]');
            if (cancelForm) {
                cancelForm.addEventListener('submit', function(e) {
                    e.preventDefault();

                    const appointmentDateTime = new Date('@Model.AppointmentDate.ToString("yyyy-MM-dd")T@(Model.AppointmentTime)');
                    const now = new Date();
                    const twoHoursBefore = new Date(appointmentDateTime.getTime() - (2 * 60 * 60 * 1000));

                    if (now > twoHoursBefore) {
                        alert('Appointment can only be cancelled at least 2 hours before the scheduled time.');
                        return;
                    }

                    if (confirm('Are you sure you want to cancel this appointment? This action cannot be undone.')) {
                        this.submit();
                    }
                });
            }
        });
    </script>
}